        <Item class="ModuleScript" referent="3">
          <Properties>
            <string name="Name">AbilityConfig</string>
            <string name="Source"><![CDATA[--[[
	AbilityConfig
	Companion spirits: pick ONE spirit to follow you. Its biome decides your active ability (key Q).
	Rarer companions recharge faster (-6% cooldown per rarity tier above Common; mutated -10% more).
	This is the core difference from other steal games: your spirits help you pull off the heist.
]]

export type Ability = {
	Id: string,
	Name: string,
	Desc: string,
	Cooldown: number,
	Power: number?,
	Radius: number?,
	Duration: number?,
	SpeedMult: number?,
}

local AbilityConfig = {}

AbilityConfig.ByBiome = {
	Meadow = { Id = "WispRush", Name = "Wisp Rush", Desc = "+35% speed for 3s", Cooldown = 18, SpeedMult = 1.35, Duration = 3 },
	Ember = { Id = "FlameDash", Name = "Flame Dash", Desc = "Burst forward", Cooldown = 14, Power = 110 },
	Frost = { Id = "FrostNova", Name = "Frost Nova", Desc = "Freeze guardians within 30 studs for 3s", Cooldown = 25, Radius = 30, Duration = 3 },
	Crypt = { Id = "GraveVeil", Name = "Grave Veil", Desc = "Guardians can't see you for 4s", Cooldown = 28, Duration = 4 },
	Storm = { Id = "LightningStep", Name = "Lightning Step", Desc = "Huge dash + 20% speed for 2s", Cooldown = 16, Power = 160, SpeedMult = 1.2, Duration = 2 },
	Void = { Id = "ShadowCloak", Name = "Shadow Cloak", Desc = "Invisible to guardians AND players for 5s", Cooldown = 32, Duration = 5 },
	Celestial = { Id = "HaloWard", Name = "Halo Ward", Desc = "Blocks the next catch or bonk (8s)", Cooldown = 30, Duration = 8 },
	Abyssal = { Id = "ReapersRend", Name = "Reaper's Rend", Desc = "Freeze nearby guardians + 40% speed for 4s", Cooldown = 35, Radius = 35, Duration = 4, SpeedMult = 1.4 },
} :: { [string]: Ability }

AbilityConfig.CooldownReductionPerRarity = 0.06
AbilityConfig.MutatedCooldownReduction = 0.10

-- Stealth tuning used by GuardianService
AbilityConfig.Stealth = {
	ViewDot = 0.25, -- guardians see in a ~150° cone in front of them
	HearingRadius = 10, -- noticed from any direction this close
	SneakHearingRadius = 4,
	SneakSightMult = 0.55, -- sneaking shrinks how far guardians can see you
	SneakSpeedMult = 0.6, -- ...but you move slower
	NightSightMult = 0.85, -- darker nights = harder to spot (but guardians are faster)
	GlowPerRarity = 0.06, -- rarer souls glow brighter = spotted from further away
	LoseTrackSeconds = 2.5, -- break line of sight this long and the guardian gives up
	ChaseRangeMult = 1.6, -- keeps chasing up to AggroRadius x this
	BackupRadius = 45, -- spotting guardian alerts others this close
}

-- Haunt: after being robbed, the owner can curse the thief once (slow) within this window.
AbilityConfig.Haunt = { WindowSeconds = 20, SlowFactor = 0.55, Duration = 5 }

function AbilityConfig.GetCooldown(biomeId: string, rarityOrder: number, mutated: boolean): number
	local ability = AbilityConfig.ByBiome[biomeId] or AbilityConfig.ByBiome.Meadow
	local reduction = (rarityOrder - 1) * AbilityConfig.CooldownReductionPerRarity + (mutated and AbilityConfig.MutatedCooldownReduction or 0)
	return math.max(4, ability.Cooldown * (1 - reduction))
end

return AbilityConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4">
          <Properties>
            <string name="Name">BiomeConfig</string>
            <string name="Source"><![CDATA[--[[
	BiomeConfig
	Each biome = a guarded zone that spawns Soul Orbs. Deeper biomes are further from the bases,
	need more Speed to enter, spawn more valuable souls and are guarded by faster guardians.

	Workspace.Biomes.<Id> must contain (WorldBuilder generates a greybox if missing):
		Zone            Part   - invisible box covering the biome (its -Z / Front face points to the bases)
		SoulSpawns      Folder - Parts where orbs appear
		GuardianSpawns  Folder - Parts where guardians start (optional, falls back to Zone centre)
		GateReturn      Part   - (optional) where under-speed players get pushed back to
]]

export type GuardianAbility = {
	Type: "SlowPulse" | "Blink",
	Cooldown: number,
	Radius: number?,
	SlowFactor: number?,
	Duration: number?,
	MinDistance: number?,
	BehindDistance: number?,
}

export type Guardian = {
	Name: string,
	Speed: number,
	Count: number,
	AggroRadius: number,
	CatchRadius: number,
	Scale: number,
	Color: Color3,
	Ability: GuardianAbility?,
}

export type Biome = {
	Id: string,
	Name: string,
	Order: number,
	SpeedRequired: number,
	IncomeMult: number,
	HatchMult: number,
	MaxOrbs: number,
	RespawnSeconds: number,
	Color: Color3,
	Guardian: Guardian,
	Species: { [string]: string },
}

local BiomeConfig = {}

BiomeConfig.Order = { "Meadow", "Ember", "Frost", "Crypt", "Storm", "Void", "Celestial", "Abyssal" }

BiomeConfig.Biomes = {
	Meadow = {
		Id = "Meadow", Name = "Whispering Meadow", Order = 1,
		SpeedRequired = 16, IncomeMult = 1, HatchMult = 1.0,
		MaxOrbs = 10, RespawnSeconds = 3, Color = Color3.fromRGB(110, 190, 90),
		Guardian = {
			Name = "Wisp Sentry", Speed = 12, Count = 2, AggroRadius = 35, CatchRadius = 4.5,
			Scale = 1, Color = Color3.fromRGB(200, 255, 200),
		},
		Species = {
			Common = "Wisplet", Uncommon = "Glowmoth", Rare = "Fernling", Epic = "Dewdrop Sprite",
			Legendary = "Meadow Monarch", Mythic = "Elder Willowshade", Secret = "The First Whisper",
		},
	},
	Ember = {
		Id = "Ember", Name = "Ember Hollow", Order = 2,
		SpeedRequired = 22, IncomeMult = 3, HatchMult = 1.15,
		MaxOrbs = 10, RespawnSeconds = 4, Color = Color3.fromRGB(200, 80, 40),
		Guardian = {
			Name = "Cinder Hound", Speed = 16, Count = 3, AggroRadius = 40, CatchRadius = 4.5,
			Scale = 1, Color = Color3.fromRGB(255, 110, 40),
		},
		Species = {
			Common = "Cinderpup", Uncommon = "Ashling", Rare = "Flickerfox", Epic = "Magma Imp",
			Legendary = "Phoenix Wraith", Mythic = "Inferno Djinn", Secret = "Heart of the Hollow",
		},
	},
	Frost = {
		Id = "Frost", Name = "Frostveil Peaks", Order = 3,
		SpeedRequired = 30, IncomeMult = 9, HatchMult = 1.3,
		MaxOrbs = 9, RespawnSeconds = 5, Color = Color3.fromRGB(170, 220, 255),
		Guardian = {
			Name = "Glacial Warden", Speed = 20, Count = 3, AggroRadius = 45, CatchRadius = 5,
			Scale = 1.2, Color = Color3.fromRGB(150, 220, 255),
			Ability = { Type = "SlowPulse", Cooldown = 8, Radius = 18, SlowFactor = 0.6, Duration = 2 },
		},
		Species = {
			Common = "Snowsoul", Uncommon = "Frostkit", Rare = "Icicle Owl", Epic = "Glacier Golem",
			Legendary = "Aurora Stag", Mythic = "Rimefang Wyrm", Secret = "Winter's Last Breath",
		},
	},
	Crypt = {
		Id = "Crypt", Name = "Sunken Crypt", Order = 4,
		SpeedRequired = 40, IncomeMult = 25, HatchMult = 1.45,
		MaxOrbs = 9, RespawnSeconds = 6, Color = Color3.fromRGB(90, 90, 110),
		Guardian = {
			Name = "Bone Knight", Speed = 26, Count = 3, AggroRadius = 45, CatchRadius = 5,
			Scale = 1.3, Color = Color3.fromRGB(230, 225, 200),
			Ability = { Type = "SlowPulse", Cooldown = 7, Radius = 16, SlowFactor = 0.55, Duration = 1.5 },
		},
		Species = {
			Common = "Bonewisp", Uncommon = "Ghoulet", Rare = "Lantern Lich", Epic = "Grave Knight",
			Legendary = "Banshee Queen", Mythic = "Crypt Colossus", Secret = "The Nameless King",
		},
	},
	Storm = {
		Id = "Storm", Name = "Storm Spire", Order = 5,
		SpeedRequired = 52, IncomeMult = 70, HatchMult = 1.6,
		MaxOrbs = 8, RespawnSeconds = 7, Color = Color3.fromRGB(80, 110, 170),
		Guardian = {
			Name = "Thunder Djinn", Speed = 32, Count = 3, AggroRadius = 50, CatchRadius = 5,
			Scale = 1.3, Color = Color3.fromRGB(120, 200, 255),
			Ability = { Type = "Blink", Cooldown = 9, MinDistance = 22, BehindDistance = 9 },
		},
		Species = {
			Common = "Sparkling", Uncommon = "Zephyr Kit", Rare = "Thunder Ram", Epic = "Storm Roc",
			Legendary = "Tempest Titan", Mythic = "Skyfather Shade", Secret = "Eye of the Storm",
		},
	},
	Void = {
		Id = "Void", Name = "Void Rift", Order = 6,
		SpeedRequired = 66, IncomeMult = 200, HatchMult = 1.8,
		MaxOrbs = 8, RespawnSeconds = 8, Color = Color3.fromRGB(40, 10, 60),
		Guardian = {
			Name = "Void Stalker", Speed = 40, Count = 4, AggroRadius = 55, CatchRadius = 5.5,
			Scale = 1.4, Color = Color3.fromRGB(120, 40, 200),
			Ability = { Type = "Blink", Cooldown = 7, MinDistance = 20, BehindDistance = 8 },
		},
		Species = {
			Common = "Voidmite", Uncommon = "Shadowlurker", Rare = "Riftwalker", Epic = "Null Serpent",
			Legendary = "Abyss Watcher", Mythic = "Event Horizon", Secret = "The Hollow Star",
		},
	},
	Celestial = {
		Id = "Celestial", Name = "Celestial Garden", Order = 7,
		SpeedRequired = 82, IncomeMult = 600, HatchMult = 2.0,
		MaxOrbs = 7, RespawnSeconds = 9, Color = Color3.fromRGB(255, 240, 180),
		Guardian = {
			Name = "Seraph Sentinel", Speed = 50, Count = 4, AggroRadius = 60, CatchRadius = 6,
			Scale = 1.5, Color = Color3.fromRGB(255, 255, 220),
			Ability = { Type = "SlowPulse", Cooldown = 6, Radius = 22, SlowFactor = 0.6, Duration = 1.5 },
		},
		Species = {
			Common = "Starlet", Uncommon = "Moonhare", Rare = "Comet Koi", Epic = "Seraphling",
			Legendary = "Solar Archon", Mythic = "Galaxy Leviathan", Secret = "Origin Soul",
		},
	},
	Abyssal = {
		Id = "Abyssal", Name = "Abyssal Throne", Order = 8,
		SpeedRequired = 100, IncomeMult = 2000, HatchMult = 2.3,
		MaxOrbs = 6, RespawnSeconds = 10, Color = Color3.fromRGB(110, 0, 20),
		Guardian = {
			Name = "The Soul Reaper", Speed = 62, Count = 2, AggroRadius = 70, CatchRadius = 7,
			Scale = 2.2, Color = Color3.fromRGB(20, 20, 20),
			Ability = { Type = "Blink", Cooldown = 6, MinDistance = 18, BehindDistance = 10 },
		},
		Species = {
			Common = "Soulshard", Uncommon = "Dread Wisp", Rare = "Chain Revenant", Epic = "Reaper's Hound",
			Legendary = "Throne Wraith", Mythic = "Soul Devourer", Secret = "The Reaper's Reflection",
		},
	},
} :: { [string]: Biome }

function BiomeConfig.Get(id: string): Biome
	return BiomeConfig.Biomes[id] or BiomeConfig.Biomes.Meadow
end

return BiomeConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">EconomyConfig</string>
            <string name="Source"><![CDATA[--[[
	EconomyConfig
	Every number the economy runs on. See docs/02-economy.md for the reasoning and pacing tables.
	All cost formulas live in Shared/Formulas so client UI and server agree exactly.
]]

local EconomyConfig = {
	StartingEssence = 50,
	StartingSpeed = 16,
	StartingPedestals = 3,
	MaxPedestals = 20, -- purchasable with Essence (passes add on top)

	-- Speed: buying +1 Speed at current speed s costs floor(SpeedBaseCost * SpeedGrowth^(s - 16))
	SpeedBaseCost = 25,
	SpeedGrowth = 1.18,

	-- Treadmill tiers cap how high Speed can be bought.
	Treadmill = {
		{ Cap = 30, Cost = 0 },
		{ Cap = 45, Cost = 1_500 },
		{ Cap = 60, Cost = 15_000 },
		{ Cap = 80, Cost = 250_000 },
		{ Cap = 100, Cost = 5_000_000 },
		{ Cap = 130, Cost = 100_000_000, RequiresRebirths = 1 },
		{ Cap = 160, Cost = 5_000_000_000, RequiresRebirths = 5 },
	},

	-- Carry (Soul Harness): reduces the slowdown from carrying heavy souls.
	CarryMaxLevel = 15,
	CarryReductionPerLevel = 0.04, -- 15 levels = 60% less slowdown
	CarryBaseCost = 150,
	CarryGrowth = 2.0,

	-- Pedestals: the n-th pedestal (n > StartingPedestals) costs PedestalBaseCost * PedestalGrowth^(n - 4)
	PedestalBaseCost = 500,
	PedestalGrowth = 1.9,

	-- Rebirth
	RebirthBaseCost = 10_000_000,
	RebirthGrowth = 3.2,
	RebirthMultPerRebirth = 0.5, -- permanent income multiplier = 1 + 0.5 * rebirths
	RebirthTokensBase = 1, -- tokens per rebirth = 1 + floor(rebirthsAfter / 3)
	VaultBaseSize = 1, -- pets you can keep through a rebirth = 1 + floor(rebirths / 2) (+3 with pass)
	VaultPassBonus = 3,

	-- Rebirth perks bought with Rebirth Tokens (permanent, never reset)
	Perks = {
		SoulMagnet = { Name = "Soul Magnet", Desc = "+10% Luck per level", MaxLevel = 10, CostBase = 1, CostPerLevel = 1, PerLevel = 0.10 },
		Attunement = { Name = "Essence Attunement", Desc = "+10% Essence per level", MaxLevel = 20, CostBase = 1, CostPerLevel = 1, PerLevel = 0.10 },
		SwiftStart = { Name = "Swift Start", Desc = "+4 starting Speed per level", MaxLevel = 5, CostBase = 2, CostPerLevel = 2, PerLevel = 4 },
		QuickIncubation = { Name = "Quick Incubation", Desc = "-5% hatch time per level", MaxLevel = 8, CostBase = 1, CostPerLevel = 1, PerLevel = 0.05 },
		TreadmillMemory = { Name = "Treadmill Memory", Desc = "Keep your Treadmill tier on rebirth", MaxLevel = 1, CostBase = 5, CostPerLevel = 0, PerLevel = 1 },
	},
	PerkOrder = { "SoulMagnet", "Attunement", "SwiftStart", "QuickIncubation", "TreadmillMemory" },

	-- Offline earnings (fraction of last income/sec, capped duration)
	OfflineFreePercent = 0.10,
	OfflineFreeCapSeconds = 2 * 3600,
	OfflinePassPercent = 0.50,
	OfflinePassCapSeconds = 12 * 3600,

	-- Essence developer products: grants max(Floor, income/sec * Seconds)
	EssencePacks = {
		EssenceSmall = { Seconds = 15 * 60, Floor = 1_000 },
		EssenceMedium = { Seconds = 60 * 60, Floor = 5_000 },
		EssenceLarge = { Seconds = 4 * 3600, Floor = 25_000 },
		EssenceHuge = { Seconds = 12 * 3600, Floor = 100_000 },
	},
}

return EconomyConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">EventConfig</string>
            <string name="Source"><![CDATA[--[[
	EventConfig
	Limited-time seasonal events. Only one runs at a time.
	Hallow-Soul Festival (Halloween): spooky lighting + decorations, Candy pumpkins to collect,
	Candy from every delivered soul, the event-only "Haunted" mutation (x10), and a Candy Shop.

	To end the event early set Active = false. It also auto-ends at EndsAt (unix time, UTC).
]]

local EventConfig = {
	Active = true,
	Id = "Halloween2026",
	Name = "Hallow-Soul Festival",
	EndsAt = 1793577600, -- 2026-11-02 00:00 UTC
	Currency = "Candy",

	-- Candy pumpkins scattered around the hub and biomes
	MaxPumpkins = 30,
	PumpkinRespawnSeconds = 6,
	PumpkinCandy = { Min = 1, Max = 4 },
	GoldenPumpkinChance = 0.05, -- golden pumpkins give 15 candy
	GoldenPumpkinCandy = 15,

	-- Candy for delivering a soul home = DeliverCandyBase + rarity order (Common 1 ... Secret 7)
	DeliverCandyBase = 1,

	-- Haunted mutation chance during the event (x10 income). See PetConfig.Mutations.Haunted.

	-- Candy Shop. Orb entries come from the player's best unlocked biome with a guaranteed mutation.
	Shop = {
		{ Id = "HauntedRare", Name = "Haunted Rare Soul", Desc = "Guaranteed Haunted (x10)", Cost = 60, Orb = { Rarity = "Rare", Mutation = "Haunted" } },
		{ Id = "HauntedEpic", Name = "Haunted Epic Soul", Desc = "Guaranteed Haunted (x10)", Cost = 180, Orb = { Rarity = "Epic", Mutation = "Haunted" } },
		{ Id = "HauntedLegendary", Name = "Haunted Legendary Soul", Desc = "Guaranteed Haunted (x10)", Cost = 600, Orb = { Rarity = "Legendary", Mutation = "Haunted" } },
		{ Id = "HauntedMythic", Name = "Haunted Mythic Soul", Desc = "Guaranteed Haunted (x10)", Cost = 2000, Orb = { Rarity = "Mythic", Mutation = "Haunted" } },
		{ Id = "CandyLuck", Name = "Witch's Brew (15m)", Desc = "2x Luck for 15 minutes", Cost = 40, Boost = { Kind = "Luck2x", Seconds = 900 } },
		{ Id = "CandyEssence", Name = "Pumpkin Spice (15m)", Desc = "2x Essence for 15 minutes", Cost = 60, Boost = { Kind = "Essence2x", Seconds = 900 } },
	},

	-- Lighting while the event runs
	Lighting = {
		OutdoorAmbient = Color3.fromRGB(110, 70, 120),
		FogColor = Color3.fromRGB(60, 30, 70),
		AtmosphereDensity = 0.38,
		AtmosphereColor = Color3.fromRGB(200, 120, 60),
		Tint = Color3.fromRGB(255, 225, 200),
	},
}

function EventConfig.IsActive(): boolean
	return EventConfig.Active and os.time() < EventConfig.EndsAt
end

return EventConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">GameConfig</string>
            <string name="Source"><![CDATA[--[[
	GameConfig
	Global, non-economy tuning for Steal a Soul. Shared with the client (nothing secret here).
]]

local GameConfig = {
	-- Data ---------------------------------------------------------------
	DataStoreName = "SoulHeist_PlayerData_v1", -- bump the suffix ONLY for a full wipe
	DataVersion = 1,
	AutosaveInterval = 60, -- seconds between autosaves per player
	SessionLockStaleSeconds = 300, -- a lock older than this is considered abandoned (crashed server)
	LoadRetryAttempts = 5,
	LoadRetryDelay = 6,
	UseMockDataStoreInStudio = true, -- falls back to in-memory data if Studio has no API access

	-- Testing --------------------------------------------------------------
	StudioGrantAllPasses = false, -- set true to test every Game Pass in Studio

	-- Social bonuses ------------------------------------------------------
	GroupId = 0, -- your Roblox group id (0 = disabled)
	PremiumIncomeBonus = 0.10,
	GroupIncomeBonus = 0.10,
	FriendIncomeBonus = 0.10, -- per friend in server
	MaxFriendBonuses = 4,

	-- Base ---------------------------------------------------------------
	MaxBases = 8, -- players per server should equal this (set in Game Settings)
	PhysicalPedestalsPerBase = 25, -- 20 buyable + 5 from the Extra Pedestals pass
	BaseLockDuration = 45,
	BaseLockCooldown = 120,
	NewPlayerProtectionSeconds = 900, -- bases can't be robbed during a player's first 15 min of playtime
	BaseStealHoldBase = 2.0, -- seconds to hold "Steal" on someone else's pedestal (+ rarity bonus)
	BaseStealMaxDistance = 14,

	-- Orbs ---------------------------------------------------------------
	WorldOrbPickupMaxDistance = 14,
	DroppedOrbLifetime = 45,
	MaxCarried = 1,

	-- PvP tool ------------------------------------------------------------
	Lantern = { Range = 9, Cooldown = 1.2, StunSeconds = 0.8, Knockback = 45 },
	Scythe = { Range = 13, Cooldown = 0.8, StunSeconds = 1.4, Knockback = 70 },

	-- Day / Night ---------------------------------------------------------
	DayNight = {
		CycleSeconds = 600, -- full cycle
		NightStart = 360, -- seconds into the cycle when night begins (6 min day / 4 min night)
		EclipseEveryNthNight = 4,
		Night = { SpawnLuck = 2, MutationLuck = 2, GuardianSpeed = 1.20 },
		Eclipse = { SpawnLuck = 5, MutationLuck = 4, GuardianSpeed = 1.35 },
	},

	-- Inventory -----------------------------------------------------------
	InventoryCap = 60,
	MaxPendingOrbs = 10,

	-- Anti-exploit ----------------------------------------------------------
	AntiExploit = {
		CheckInterval = 0.5,
		SpeedTolerance = 1.35, -- allowed multiple of expected WalkSpeed
		FlatTolerance = 8, -- studs/sec of slack (latency, slopes)
		StrikesBeforeRubberband = 3,
	},
}

return GameConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">MonetizationConfig</string>
            <string name="Source"><![CDATA[--[[
	MonetizationConfig
	Paste your real Game Pass / Developer Product IDs into the Id fields (Creator Hub -> your experience
	-> Monetization). Prices here are DISPLAY ONLY - the real price is whatever you set on Roblox,
	so keep them in sync. Id = 0 means "not created yet" (the shop hides it).
]]

export type PassInfo = { Id: number, Price: number, Name: string, Desc: string, Order: number }
export type ProductInfo = { Id: number, Price: number, Name: string, Desc: string, Order: number, Hidden: boolean?, Event: boolean?, Upgrade: boolean? }

local MonetizationConfig = {}

MonetizationConfig.GamePasses = {
	VIP = { Id = 0, Price = 299, Order = 1, Name = "VIP Soul Thief", Desc = "+10% Essence, +1 Pedestal, gold VIP tag, VIP lounge" },
	DoubleEssence = { Id = 0, Price = 449, Order = 2, Name = "2x Essence", Desc = "Permanently doubles ALL Essence income" },
	SuperLuck = { Id = 0, Price = 399, Order = 3, Name = "Super Luck", Desc = "2x Luck: more mutations + rarity Ascensions" },
	ExtraPedestals = { Id = 0, Price = 349, Order = 4, Name = "+5 Pedestals", Desc = "5 extra pedestals in your base, forever" },
	FastHatch = { Id = 0, Price = 249, Order = 5, Name = "Fast Hatch", Desc = "All souls hatch 2x faster" },
	PhantomSteps = { Id = 0, Price = 199, Order = 6, Name = "Phantom Steps", Desc = "+4 Speed and carry souls 25% lighter" },
	ReaperScythe = { Id = 0, Price = 299, Order = 7, Name = "Reaper Scythe", Desc = "Longer-range, faster bonk weapon that stuns longer" },
	Fortress = { Id = 0, Price = 249, Order = 8, Name = "Fortress", Desc = "Base lock lasts 2x longer, cooldown halved" },
	SoulVault = { Id = 0, Price = 149, Order = 9, Name = "Soul Vault+", Desc = "Keep +3 extra spirits through every rebirth" },
	OfflineOvertime = { Id = 0, Price = 199, Order = 10, Name = "Spirit Overtime", Desc = "Earn 50% offline for up to 12h (free: 10% for 2h)" },
} :: { [string]: PassInfo }

MonetizationConfig.Products = {
	StarterPack = { Id = 0, Price = 99, Order = 1, Name = "Starter Pack (once)", Desc = "Epic orb + 5,000 Essence + 30 min 2x Essence" },
	InstantHatchOne = { Id = 0, Price = 25, Order = 2, Name = "Instant Hatch", Desc = "Hatch your slowest soul right now" },
	InstantHatchAll = { Id = 0, Price = 79, Order = 3, Name = "Hatch All", Desc = "Hatch every incubating soul right now" },
	StealBack = { Id = 0, Price = 39, Order = 4, Name = "Soul Echo", Desc = "Recover a copy of the last soul stolen from you", Hidden = true },
	EssenceSmall = { Id = 0, Price = 49, Order = 5, Name = "Essence Pouch", Desc = "15 min of income" },
	EssenceMedium = { Id = 0, Price = 149, Order = 6, Name = "Essence Jar", Desc = "1 hour of income" },
	EssenceLarge = { Id = 0, Price = 399, Order = 7, Name = "Essence Urn", Desc = "4 hours of income (BEST VALUE)" },
	EssenceHuge = { Id = 0, Price = 999, Order = 8, Name = "Essence Reliquary", Desc = "12 hours of income" },
	Essence2x30 = { Id = 0, Price = 79, Order = 9, Name = "2x Essence (30m)", Desc = "Stacks with the 2x pass for 4x" },
	Luck2x30 = { Id = 0, Price = 59, Order = 10, Name = "Lucky Potion (30m)", Desc = "2x Luck for 30 minutes" },
	Luck5x30 = { Id = 0, Price = 199, Order = 11, Name = "Mega Luck (30m)", Desc = "5x Luck for 30 minutes" },
	BaseShield10 = { Id = 0, Price = 49, Order = 12, Name = "Soul Shield (10m)", Desc = "Nobody can steal from your base for 10 minutes" },
	RebirthSkip = { Id = 0, Price = 199, Order = 13, Name = "Rebirth Skip", Desc = "Rebirth now without paying Essence" },
	LegendaryOrb = { Id = 0, Price = 399, Order = 14, Name = "Legendary Soul", Desc = "A Legendary orb from your best unlocked biome" },
	MythicOrb = { Id = 0, Price = 1299, Order = 15, Name = "Mythic Soul", Desc = "A Mythic orb from your best unlocked biome" },
	ServerEclipse = { Id = 0, Price = 499, Order = 16, Name = "Summon Soul Eclipse", Desc = "15 min server-wide Eclipse: 5x spawn luck for EVERYONE" },
	-- Seasonal (only shown while an event is active)
	CandySmall = { Id = 0, Price = 49, Order = 17, Name = "Candy Bag", Desc = "120 Candy for the event shop", Event = true },
	CandyLarge = { Id = 0, Price = 199, Order = 18, Name = "Candy Cauldron", Desc = "600 Candy for the event shop (BEST VALUE)", Event = true },
	-- Robux upgrades ("skip the grind"). Shown in the Upgrades panel. Reset on rebirth like normal upgrades.
	NextBiome = { Id = 0, Price = 99, Order = 19, Name = "Unlock Next Biome", Desc = "Instantly get the Speed for the next biome", Upgrade = true },
	SpeedPlus10 = { Id = 0, Price = 49, Order = 20, Name = "+10 Speed", Desc = "+10 Speed (Treadmill auto-upgrades)", Upgrade = true },
	SpeedPlus50 = { Id = 0, Price = 179, Order = 21, Name = "+50 Speed", Desc = "+50 Speed (Treadmill auto-upgrades)", Upgrade = true },
	TreadmillNext = { Id = 0, Price = 99, Order = 22, Name = "Treadmill Upgrade", Desc = "Next Treadmill tier (raises your Speed cap)", Upgrade = true },
	HarnessMax = { Id = 0, Price = 149, Order = 23, Name = "Max Soul Harness", Desc = "Soul Harness to level 15 (-60% carry slowdown)", Upgrade = true },
	PedestalPlus1 = { Id = 0, Price = 79, Order = 24, Name = "+1 Pedestal", Desc = "Unlock your next pedestal instantly", Upgrade = true },
} :: { [string]: ProductInfo }

-- Effect constants used by the server
MonetizationConfig.Effects = {
	BoostSeconds = 30 * 60,
	ShieldSeconds = 10 * 60,
	EclipseSeconds = 15 * 60,
	StealBackWindow = 10 * 60,
	StarterPackEssence = 5_000,
	VIPIncomeBonus = 0.10,
	VIPPedestals = 1,
	ExtraPedestals = 5,
	PhantomSpeed = 4,
	PhantomLighter = 0.25,
	CandySmall = 120,
	CandyLarge = 600,
}

function MonetizationConfig.FindProductKey(productId: number): string?
	for key, info in pairs(MonetizationConfig.Products) do
		if info.Id == productId and info.Id ~= 0 then
			return key
		end
	end
	return nil
end

function MonetizationConfig.FindPassKey(passId: number): string?
	for key, info in pairs(MonetizationConfig.GamePasses) do
		if info.Id == passId and info.Id ~= 0 then
			return key
		end
	end
	return nil
end

return MonetizationConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">PetConfig</string>
            <string name="Source"><![CDATA[--[[
	PetConfig
	Rarities (shared by Soul Orbs and the Spirit Pets they hatch into) and mutations.

	Income of a pet  = Rarity.BaseIncome * Biome.IncomeMult * Mutation.Mult   (Essence / second)
	Carry slowdown   = Rarity.Heaviness (fraction of WalkSpeed lost while carrying, before Carry upgrades)
]]

export type Rarity = {
	Id: string,
	Order: number,
	Color: Color3,
	SpawnWeight: number,
	BaseIncome: number,
	HatchSeconds: number,
	Heaviness: number,
	PickupHold: number,
	OrbSize: number,
	Announce: boolean,
}

export type Mutation = {
	Id: string,
	Mult: number,
	Chance: number,
	Color: Color3,
	NightOnly: boolean?,
	EclipseOnly: boolean?,
	EventOnly: boolean?,
}

local PetConfig = {}

PetConfig.RarityOrder = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Secret" }

PetConfig.Rarities = {
	Common = {
		Id = "Common", Order = 1, Color = Color3.fromRGB(200, 200, 210),
		SpawnWeight = 60, BaseIncome = 1, HatchSeconds = 10,
		Heaviness = 0.10, PickupHold = 0.5, OrbSize = 1.6, Announce = false,
	},
	Uncommon = {
		Id = "Uncommon", Order = 2, Color = Color3.fromRGB(90, 220, 120),
		SpawnWeight = 25, BaseIncome = 3, HatchSeconds = 20,
		Heaviness = 0.15, PickupHold = 0.7, OrbSize = 1.8, Announce = false,
	},
	Rare = {
		Id = "Rare", Order = 3, Color = Color3.fromRGB(70, 150, 255),
		SpawnWeight = 10, BaseIncome = 8, HatchSeconds = 40,
		Heaviness = 0.20, PickupHold = 1.0, OrbSize = 2.0, Announce = false,
	},
	Epic = {
		Id = "Epic", Order = 4, Color = Color3.fromRGB(180, 90, 255),
		SpawnWeight = 4, BaseIncome = 25, HatchSeconds = 75,
		Heaviness = 0.28, PickupHold = 1.3, OrbSize = 2.3, Announce = false,
	},
	Legendary = {
		Id = "Legendary", Order = 5, Color = Color3.fromRGB(255, 190, 40),
		SpawnWeight = 0.9, BaseIncome = 80, HatchSeconds = 150,
		Heaviness = 0.36, PickupHold = 1.7, OrbSize = 2.6, Announce = true,
	},
	Mythic = {
		Id = "Mythic", Order = 6, Color = Color3.fromRGB(255, 70, 110),
		SpawnWeight = 0.09, BaseIncome = 300, HatchSeconds = 300,
		Heaviness = 0.45, PickupHold = 2.2, OrbSize = 3.0, Announce = true,
	},
	Secret = {
		Id = "Secret", Order = 7, Color = Color3.fromRGB(20, 20, 25),
		SpawnWeight = 0.01, BaseIncome = 1500, HatchSeconds = 600,
		Heaviness = 0.55, PickupHold = 3.0, OrbSize = 3.4, Announce = true,
	},
} :: { [string]: Rarity }

-- Mutations are rolled at HATCH time with the hatcher's luck (rarest first, first success wins).
PetConfig.MutationOrder = { "Rainbow", "Eclipsed", "Voidtouched", "Haunted", "Celestial", "Moonlit", "Spectral", "Gilded" }

PetConfig.Mutations = {
	None = { Id = "None", Mult = 1, Chance = 0, Color = Color3.new(1, 1, 1) },
	Gilded = { Id = "Gilded", Mult = 2, Chance = 0.05, Color = Color3.fromRGB(255, 215, 0) },
	Spectral = { Id = "Spectral", Mult = 3, Chance = 0.02, Color = Color3.fromRGB(140, 255, 255) },
	Moonlit = { Id = "Moonlit", Mult = 5, Chance = 0.008, Color = Color3.fromRGB(150, 170, 255), NightOnly = true },
	Celestial = { Id = "Celestial", Mult = 8, Chance = 0.003, Color = Color3.fromRGB(255, 250, 200) },
	Voidtouched = { Id = "Voidtouched", Mult = 15, Chance = 0.0005, Color = Color3.fromRGB(90, 0, 140) },
	Eclipsed = { Id = "Eclipsed", Mult = 40, Chance = 0.003, Color = Color3.fromRGB(255, 60, 0), EclipseOnly = true },
	Rainbow = { Id = "Rainbow", Mult = 25, Chance = 0.0001, Color = Color3.fromRGB(255, 0, 255) },
	-- Seasonal: only rolls while a seasonal event is active (EventConfig), also sold in the Candy Shop.
	Haunted = { Id = "Haunted", Mult = 10, Chance = 0.01, Color = Color3.fromRGB(255, 130, 20), EventOnly = true },
} :: { [string]: Mutation }

-- "Ascension": on hatch, chance for the soul to jump one rarity tier. Scales with luck.
PetConfig.AscendBaseChance = 0.03
PetConfig.AscendMaxChance = 0.5

-- Max pets that can be stored off-pedestal is GameConfig.InventoryCap.
-- Sell value of a pet = its income/sec * SellSeconds
PetConfig.SellSeconds = 60

function PetConfig.GetRarity(id: string): Rarity
	return PetConfig.Rarities[id] or PetConfig.Rarities.Common
end

function PetConfig.GetMutation(id: string?): Mutation
	return PetConfig.Mutations[id or "None"] or PetConfig.Mutations.None
end

function PetConfig.NextRarity(id: string): string
	local r = PetConfig.GetRarity(id)
	return PetConfig.RarityOrder[math.min(r.Order + 1, #PetConfig.RarityOrder)]
end

return PetConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">RewardConfig</string>
            <string name="Source"><![CDATA[--[[
	RewardConfig
	Daily login streak, playtime gifts and daily quests.

	Reward table fields (all optional, combine freely) - same format as promo codes:
		Essence        flat Essence
		IncomeSeconds  Essence = max(Essence, income/sec * IncomeSeconds) -> scales with progress
		Boost          { Kind = "Essence2x" | "Luck2x" | "Luck5x", Seconds = n }
		Orb            { Rarity = "Epic", Biome = "Best", Mutation = "Haunted"? }
		Candy          event currency (only granted while an event is active)
]]

local RewardConfig = {}

-- 7-day login streak. Claim once per UTC day; miss a day and the streak restarts at day 1.
RewardConfig.Daily = {
	{ Label = "Essence", Rewards = { Essence = 500, IncomeSeconds = 10 * 60 } },
	{ Label = "2x Luck 15m", Rewards = { Boost = { Kind = "Luck2x", Seconds = 15 * 60 } } },
	{ Label = "Big Essence", Rewards = { Essence = 2_000, IncomeSeconds = 30 * 60 } },
	{ Label = "2x Essence 30m", Rewards = { Boost = { Kind = "Essence2x", Seconds = 30 * 60 } } },
	{ Label = "Epic Soul", Rewards = { Orb = { Rarity = "Epic", Biome = "Best" } } },
	{ Label = "Huge Essence", Rewards = { Essence = 10_000, IncomeSeconds = 60 * 60, Candy = 50 } },
	{ Label = "LEGENDARY Soul", Rewards = { Orb = { Rarity = "Legendary", Biome = "Best" }, Boost = { Kind = "Luck5x", Seconds = 15 * 60 } } },
}

-- Gifts unlocked by minutes played in THIS session (claim from the Gifts panel).
RewardConfig.Playtime = {
	{ Minutes = 3, Label = "Essence", Rewards = { Essence = 300, IncomeSeconds = 3 * 60 } },
	{ Minutes = 10, Label = "Rare Soul", Rewards = { Orb = { Rarity = "Rare", Biome = "Best" } } },
	{ Minutes = 20, Label = "2x Luck 10m", Rewards = { Boost = { Kind = "Luck2x", Seconds = 10 * 60 }, Candy = 20 } },
	{ Minutes = 35, Label = "Epic Soul", Rewards = { Orb = { Rarity = "Epic", Biome = "Best" } } },
	{ Minutes = 60, Label = "Essence Jackpot", Rewards = { IncomeSeconds = 45 * 60, Essence = 5_000, Candy = 50 } },
}

-- Daily quests: 3 picked per player per day from this pool.
-- Kind is the event counted by QuestService:Progress(player, kind, amount).
RewardConfig.QuestPool = {
	{ Id = "Steal8", Kind = "Deliver", Goal = 8, Text = "Bring 8 souls home", Rewards = { IncomeSeconds = 10 * 60, Essence = 500, Candy = 15 } },
	{ Id = "Steal20", Kind = "Deliver", Goal = 20, Text = "Bring 20 souls home", Rewards = { IncomeSeconds = 25 * 60, Essence = 1_500, Candy = 30 } },
	{ Id = "Hatch5", Kind = "Hatch", Goal = 5, Text = "Hatch 5 spirits", Rewards = { IncomeSeconds = 10 * 60, Essence = 500, Candy = 15 } },
	{ Id = "Hatch15", Kind = "Hatch", Goal = 15, Text = "Hatch 15 spirits", Rewards = { Boost = { Kind = "Luck2x", Seconds = 15 * 60 }, Candy = 30 } },
	{ Id = "Rob1", Kind = "BaseSteal", Goal = 1, Text = "Steal a soul from another player's base", Rewards = { IncomeSeconds = 15 * 60, Essence = 1_000, Candy = 25 } },
	{ Id = "Rare3", Kind = "DeliverRare", Goal = 3, Text = "Bring home 3 Rare or better souls", Rewards = { Orb = { Rarity = "Epic", Biome = "Best" } } },
	{ Id = "Speed10", Kind = "BuySpeed", Goal = 10, Text = "Buy 10 Speed", Rewards = { IncomeSeconds = 10 * 60, Essence = 750 } },
	{ Id = "Bonk3", Kind = "Bonk", Goal = 3, Text = "Knock a soul loose from 3 thieves", Rewards = { IncomeSeconds = 15 * 60, Candy = 25 } },
	{ Id = "Candy40", Kind = "Candy", Goal = 40, Text = "Collect 40 Candy from pumpkins", Rewards = { Boost = { Kind = "Essence2x", Seconds = 15 * 60 }, Candy = 20 }, EventOnly = true },
	{ Id = "Night5", Kind = "DeliverNight", Goal = 5, Text = "Bring home 5 souls at night", Rewards = { Boost = { Kind = "Luck2x", Seconds = 10 * 60 }, Candy = 20 } },
}
RewardConfig.QuestsPerDay = 3
RewardConfig.AllQuestsBonus = { Orb = { Rarity = "Legendary", Biome = "Best" } }

-- Spirit Index: +1% Essence per unique species discovered (56 at launch = +56%).
RewardConfig.IndexBonusPerSpecies = 0.01

function RewardConfig.Today(): number
	return os.time() // 86400
end

return RewardConfig
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Formulas</string>
          <string name="Source"><![CDATA[--[[
	Formulas
	Pure math shared by server (authoritative) and client (UI previews). No side effects.
]]

local Config = script.Parent:WaitForChild("Config")
local EconomyConfig = require(Config:WaitForChild("EconomyConfig"))
local PetConfig = require(Config:WaitForChild("PetConfig"))
local BiomeConfig = require(Config:WaitForChild("BiomeConfig"))

local Formulas = {}

-- Speed ------------------------------------------------------------------
function Formulas.SpeedCost(currentSpeed: number): number
	return math.floor(EconomyConfig.SpeedBaseCost * EconomyConfig.SpeedGrowth ^ (currentSpeed - 16))
end

-- Total cost to buy `count` speed points starting at currentSpeed (geometric series).
function Formulas.SpeedCostBulk(currentSpeed: number, count: number): number
	local total = 0
	for i = 0, count - 1 do
		total += Formulas.SpeedCost(currentSpeed + i)
	end
	return total
end

-- How many points can be afforded with `essence`, up to `maxPoints`.
function Formulas.SpeedAffordable(currentSpeed: number, essence: number, maxPoints: number): (number, number)
	local count, total = 0, 0
	while count < maxPoints do
		local nextCost = Formulas.SpeedCost(currentSpeed + count)
		if total + nextCost > essence then
			break
		end
		total += nextCost
		count += 1
	end
	return count, total
end

function Formulas.TreadmillCap(tier: number): number
	local t = EconomyConfig.Treadmill[math.clamp(tier, 1, #EconomyConfig.Treadmill)]
	return t.Cap
end

-- Carry --------------------------------------------------------------------
function Formulas.CarryCost(level: number): number
	return math.floor(EconomyConfig.CarryBaseCost * EconomyConfig.CarryGrowth ^ level)
end

function Formulas.CarryReduction(level: number): number
	return math.min(level, EconomyConfig.CarryMaxLevel) * EconomyConfig.CarryReductionPerLevel
end

-- WalkSpeed while carrying a soul of `rarityId`.
function Formulas.CarriedSpeed(speed: number, rarityId: string, carryLevel: number, phantom: boolean): number
	local heaviness = PetConfig.GetRarity(rarityId).Heaviness
	local reduction = Formulas.CarryReduction(carryLevel) + (phantom and 0.25 or 0)
	local slow = heaviness * math.max(0, 1 - reduction)
	return speed * (1 - slow)
end

-- Pedestals ----------------------------------------------------------------
function Formulas.PedestalCost(currentCount: number): number
	-- cost of buying pedestal number currentCount + 1
	local n = currentCount + 1
	return math.floor(EconomyConfig.PedestalBaseCost * EconomyConfig.PedestalGrowth ^ (n - 4))
end

-- Rebirth -------------------------------------------------------------------
function Formulas.RebirthCost(rebirths: number): number
	return math.floor(EconomyConfig.RebirthBaseCost * EconomyConfig.RebirthGrowth ^ rebirths)
end

function Formulas.RebirthMultiplier(rebirths: number): number
	return 1 + EconomyConfig.RebirthMultPerRebirth * rebirths
end

function Formulas.RebirthTokens(rebirthsAfter: number): number
	return EconomyConfig.RebirthTokensBase + math.floor(rebirthsAfter / 3)
end

function Formulas.VaultSize(rebirths: number, hasVaultPass: boolean): number
	return EconomyConfig.VaultBaseSize + math.floor(rebirths / 2) + (hasVaultPass and EconomyConfig.VaultPassBonus or 0)
end

function Formulas.PerkCost(perkId: string, currentLevel: number): number?
	local perk = EconomyConfig.Perks[perkId]
	if not perk or currentLevel >= perk.MaxLevel then
		return nil
	end
	return perk.CostBase + perk.CostPerLevel * currentLevel
end

-- Pets ------------------------------------------------------------------------
function Formulas.PetIncome(rarityId: string, biomeId: string, mutationId: string?): number
	local rarity = PetConfig.GetRarity(rarityId)
	local biome = BiomeConfig.Get(biomeId)
	local mutation = PetConfig.GetMutation(mutationId)
	return rarity.BaseIncome * biome.IncomeMult * mutation.Mult
end

function Formulas.HatchSeconds(rarityId: string, biomeId: string, fastHatch: boolean, quickIncubationLevel: number): number
	local base = PetConfig.GetRarity(rarityId).HatchSeconds * BiomeConfig.Get(biomeId).HatchMult
	local perkMult = 1 - math.min(quickIncubationLevel, 8) * EconomyConfig.Perks.QuickIncubation.PerLevel
	local passMult = fastHatch and 0.5 or 1
	return math.max(3, math.floor(base * perkMult * passMult))
end

return Formulas
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--[[
	Remotes
	Single source of truth for every RemoteEvent / RemoteFunction.
	Server: Remotes.Init() creates them under ReplicatedStorage.Remotes.
	Client: Remotes.Event(name) / Remotes.Function(name) waits for them.

	Server -> Client (RemoteEvent)
		Notify(message: string, kind: "info"|"success"|"error"|"warning")
		StateChanged(snapshot)               full UI snapshot (pets, slots, perks, passes...)
		HatchResult(result)                  pop-up when a soul hatches
		Announce(message, color)             server-wide banner (rare spawns, big steals, eclipse)
		Knockback(velocity: Vector3)         client applies it to its own character (it owns its physics)
	Client -> Server (RemoteEvent)
		DropOrb()                            voluntarily drop the carried soul
		SetSneak(on: boolean)                sneak mode (slower, much harder for guardians to spot)
	Client -> Server (RemoteFunction) - all return { ok: boolean, msg: string? }
		GetState()                           returns snapshot
		RequestUpgrade(kind, amount)         kind: "Speed"|"Carry"|"Treadmill"|"Pedestal"
		RequestRebirth()
		BuyPerk(perkId)
		RedeemCode(code)
		PetAction(action, arg1, arg2)        action: "Store"|"Place"|"Sell"|"Lock"
		RequestLock()                        lock your base
		ClaimDaily()                         claim today's login-streak reward
		ClaimPlaytime(index)                 claim a session playtime gift
		ClaimQuest(index | "Bonus")          claim a finished daily quest / the all-quests bonus
		BuyEventItem(itemId)                 buy from the seasonal event shop with Candy
		SetCompanion(petId | nil)            choose the spirit that follows you (gives your ability)
		UseAbility()                         use your companion's ability
		Haunt()                              curse the player who just robbed you
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Remotes = {}

Remotes.EventNames = { "Notify", "StateChanged", "HatchResult", "Announce", "Knockback", "DropOrb", "SetSneak" }
Remotes.FunctionNames = {
	"GetState", "RequestUpgrade", "RequestRebirth", "BuyPerk", "RedeemCode", "PetAction", "RequestLock",
	"ClaimDaily", "ClaimPlaytime", "ClaimQuest", "BuyEventItem",
	"SetCompanion", "UseAbility", "Haunt",
}

local FOLDER_NAME = "Remotes"

function Remotes.Init()
	assert(RunService:IsServer(), "Remotes.Init must run on the server")
	local folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = FOLDER_NAME
		folder.Parent = ReplicatedStorage
	end
	for _, name in ipairs(Remotes.EventNames) do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end
	for _, name in ipairs(Remotes.FunctionNames) do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteFunction")
			remote.Name = name
			remote.Parent = folder
		end
	end
end

local function getFolder(): Folder
	return ReplicatedStorage:WaitForChild(FOLDER_NAME) :: Folder
end

function Remotes.Event(name: string): RemoteEvent
	return getFolder():WaitForChild(name) :: RemoteEvent
end

function Remotes.Function(name: string): RemoteFunction
	return getFolder():WaitForChild(name) :: RemoteFunction
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--[[
	Types
	Shape of the saved player profile. Keep in sync with PlayerDataService.DEFAULT_DATA.
]]

export type OrbData = {
	Rarity: string,
	Biome: string,
}

-- Pedestal contents. Slots are stored as a dictionary keyed by tostring(index)
-- (DataStores cannot hold arrays with holes).
export type SlotData = {
	Type: "Orb" | "Pet",
	-- Orb
	Rarity: string?,
	Biome: string?,
	HatchEnd: number?, -- os.time() when it hatches
	HatchDuration: number?,
	-- Pet
	PetId: string?,
}

export type PetData = {
	Id: string,
	Species: string,
	Rarity: string,
	Biome: string,
	Mutation: string,
	Locked: boolean,
	HatchedAt: number,
}

export type PlayerData = {
	Version: number,
	Essence: number,
	Speed: number,
	CarryLevel: number,
	TreadmillTier: number,
	Pedestals: number,
	Rebirths: number,
	RebirthTokens: number,
	Perks: { [string]: number },
	Pets: { [string]: PetData },
	NextPetId: number,
	Slots: { [string]: SlotData },
	PendingOrbs: { OrbData },
	Boosts: { [string]: number }, -- seconds remaining (ticks only while online)
	RedeemedCodes: { [string]: boolean },
	ProcessedReceipts: { string },
	StarterPackBought: boolean,
	ShieldUntil: number,
	LastRobbed: { Rarity: string, Biome: string, Time: number }?,
	LastOnline: number,
	LastIncome: number,
	Stats: {
		TotalEssence: number,
		Steals: number,
		BaseSteals: number,
		TimesRobbed: number,
		Hatched: number,
		PlayTime: number,
		RobuxSpent: number,
	},
}

return {}
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="14">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Format</string>
            <string name="Source"><![CDATA[--[[
	Format
	Number and time formatting for UI and announcements.
]]

local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

function Format.Number(n: number): string
	if n ~= n or n == math.huge or n == -math.huge then
		return "∞"
	end
	local sign = n < 0 and "-" or ""
	n = math.abs(n)
	if n < 1000 then
		if n % 1 == 0 then
			return sign .. tostring(math.floor(n))
		end
		return sign .. string.format("%.1f", n)
	end
	local tier = math.min(math.floor(math.log10(n) / 3), #SUFFIXES - 1)
	local scaled = n / 10 ^ (tier * 3)
	local pattern = if scaled >= 100 then "%.0f" elseif scaled >= 10 then "%.1f" else "%.2f"
	return sign .. string.format(pattern, scaled) .. SUFFIXES[tier + 1]
end

function Format.Time(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local h = seconds // 3600
	local m = (seconds % 3600) // 60
	local s = seconds % 60
	if h > 0 then
		return string.format("%dh %02dm", h, m)
	elseif m > 0 then
		return string.format("%dm %02ds", m, s)
	end
	return string.format("%ds", s)
end

function Format.Percent(fraction: number): string
	return string.format("%d%%", math.floor(fraction * 100 + 0.5))
end

return Format
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">Signal</string>
            <string name="Source"><![CDATA[--[[
	Signal
	Minimal server/client signal for communication between modules (not across the network).
]]

export type Connection = { Disconnect: (self: Connection) -> () }

local Signal = {}
Signal.__index = Signal

function Signal.new()
	return setmetatable({ _handlers = {} }, Signal)
end

function Signal:Connect(fn: (...any) -> ()): Connection
	local handler = { Fn = fn, Connected = true }
	table.insert(self._handlers, handler)
	local handlers = self._handlers
	return {
		Disconnect = function()
			handler.Connected = false
			local index = table.find(handlers, handler)
			if index then
				table.remove(handlers, index)
			end
		end,
	} :: any
end

function Signal:Fire(...: any)
	for _, handler in ipairs(table.clone(self._handlers)) do
		if handler.Connected then
			task.spawn(handler.Fn, ...)
		end
	end
end

return Signal
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="17">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="18">
