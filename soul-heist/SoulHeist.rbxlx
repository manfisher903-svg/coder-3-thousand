          <string name="Name">Config</string>
        </Properties>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Codes</string>
            <string name="Source"><![CDATA[--[[
	Codes (SERVER ONLY - lives in ServerScriptService so exploiters can't read unreleased codes)

	Reward fields (all optional, combine freely):
		Essence        flat Essence
		IncomeSeconds  Essence = max(Essence, income/sec * IncomeSeconds) -> stays relevant late-game
		Boost          { Kind = "Essence2x" | "Luck2x" | "Luck5x", Seconds = n }
		Orb            { Rarity = "Epic", Biome = "Best" | biomeId }   ("Best" = player's best unlocked biome)
	Expires = os.time() style unix timestamp (nil = never). Use https://www.epochconverter.com
	MinRebirths = only usable after N rebirths.
	Codes are case-insensitive. Each player can redeem each code once.
]]

return {
	RELEASE = {
		Rewards = { Essence = 500, Boost = { Kind = "Luck2x", Seconds = 15 * 60 } },
	},
	SOULTHIEF = {
		Rewards = { Essence = 250, IncomeSeconds = 10 * 60 },
	},
	FREEEPIC = {
		Rewards = { Orb = { Rarity = "Epic", Biome = "Best" } },
	},
	LIKE10K = {
		Rewards = { IncomeSeconds = 30 * 60, Essence = 2_000, Boost = { Kind = "Essence2x", Seconds = 15 * 60 } },
	},
	ECLIPSE = {
		Rewards = { Boost = { Kind = "Luck5x", Seconds = 10 * 60 } },
		Expires = nil,
	},
	REBORN = {
		Rewards = { Orb = { Rarity = "Legendary", Biome = "Best" } },
		MinRebirths = 1,
	},
}
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Script" referent="21">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	Steal a Soul - server bootstrap
	1. Creates RemoteEvents/Functions
	2. Generates a greybox world if you haven't built one yet
	3. Requires every service, calls :Init(Services) on all, then :Start() on all

	Services talk to each other through the shared `Services` table passed into Init,
	so there are no circular require() problems.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local WorldBuilder = require(script.Parent.World.WorldBuilder)

Remotes.Init()
WorldBuilder.EnsureWorld()

local ServicesFolder = script.Parent.Services

-- Order matters only for :Start() (Init never yields and only wires signals).
local ORDER = {
	"PlayerDataService",
	"AntiExploitService",
	"DayNightService",
	"MonetizationService",
	"EconomyService",
	"BaseService",
	"PetService",
	"BiomeService",
	"StealService",
	"GuardianService",
	"UpgradeService",
	"RebirthService",
	"CodesService",
	"ToolService",
	"EventService",
	"RewardService",
	"LeaderboardService",
	"CompanionService",
}

local Services = {}
for _, name in ipairs(ORDER) do
	local module = ServicesFolder:FindFirstChild(name)
	assert(module, "Missing service module: " .. name)
	Services[name] = require(module)
end

for _, name in ipairs(ORDER) do
	local service = Services[name]
	if service.Init then
		service:Init(Services)
	end
end

-- PlayerDataService starts LAST so every other service has connected its PlayerAdded /
-- ProfileLoaded handlers before the first profile loads.
for _, name in ipairs(ORDER) do
	if name ~= "PlayerDataService" and Services[name].Start then
		Services[name]:Start()
	end
end
Services.PlayerDataService:Start()

print("[SoulHeist] Server ready -", #ORDER, "services running")
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="22">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">AntiExploitService</string>
            <string name="Source"><![CDATA[--[[
	AntiExploitService
	Server-side movement sanity checks + the ONLY approved way for server code to move characters.

	* Speed check: compares horizontal distance travelled per check against the server-set WalkSpeed
	  (× tolerance + flat slack). Repeated violations rubber-band the player to their last valid spot.
	* Teleport(player, cframe): moves a character and grants a short grace period so legit server
	  teleports (spawn, gate push-back, lock push-out) never trigger the check.
	* Grace(player, seconds): pause checks (knockback, etc.).

	Everything else is protected by design: the server owns WalkSpeed, currency, pickups (distance-checked),
	tool hits (server raycast/cone), and every RemoteFunction validates + rate-limits its arguments.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)

local AntiExploitService = {}

type Track = { LastPosition: Vector3?, LastValid: CFrame?, Strikes: number, GraceUntil: number, MaxSpeedSeen: number }

local tracks: { [Player]: Track } = {}
local cfg = GameConfig.AntiExploit

local function getTrack(player: Player): Track
	local track = tracks[player]
	if not track then
		track = { LastPosition = nil, LastValid = nil, Strikes = 0, GraceUntil = 0, MaxSpeedSeen = 16 }
		tracks[player] = track
	end
	return track
end

function AntiExploitService:Grace(player: Player, seconds: number)
	local track = getTrack(player)
	track.GraceUntil = math.max(track.GraceUntil, os.clock() + seconds)
	track.LastPosition = nil
end

function AntiExploitService:Teleport(player: Player, cframe: CFrame)
	local character = player.Character
	if not character then
		return
	end
	self:Grace(player, 2)
	character:PivotTo(cframe)
	getTrack(player).LastValid = cframe
end

function AntiExploitService:Init() end

function AntiExploitService:Start()
	Players.PlayerRemoving:Connect(function(player)
		tracks[player] = nil
	end)
	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function()
			AntiExploitService:Grace(player, 3)
		end)
	end)

	task.spawn(function()
		while true do
			task.wait(cfg.CheckInterval)
			local now = os.clock()
			for _, player in ipairs(Players:GetPlayers()) do
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				if root and humanoid and humanoid.Health > 0 then
					local track = getTrack(player)
					-- Remember the highest recent WalkSpeed so speed drops (dropping a soul) don't false-flag.
					track.MaxSpeedSeen = math.max(humanoid.WalkSpeed, track.MaxSpeedSeen * 0.9)
					if now < track.GraceUntil or not track.LastPosition then
						track.LastPosition = root.Position
						track.LastValid = root.CFrame
					else
						local delta = root.Position - track.LastPosition
						local horizontal = Vector3.new(delta.X, 0, delta.Z).Magnitude
						local allowed = (track.MaxSpeedSeen * cfg.SpeedTolerance + cfg.FlatTolerance) * cfg.CheckInterval
						if horizontal > allowed then
							track.Strikes += 1
							if track.Strikes >= cfg.StrikesBeforeRubberband and track.LastValid then
								warn(string.format("[AntiExploit] %s moved %.1f studs (allowed %.1f) - rubber-banding", player.Name, horizontal, allowed))
								character:PivotTo(track.LastValid)
								track.Strikes = 0
								track.LastPosition = track.LastValid.Position
								continue
							end
						else
							track.Strikes = math.max(0, track.Strikes - 1)
							track.LastValid = root.CFrame
						end
						track.LastPosition = root.Position
					end
				end
			end
		end
	end)
end

return AntiExploitService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">BaseService</string>
            <string name="Source"><![CDATA[--[[
	BaseService
	Assigns each player a base (plot), handles spawning at home, base lock + Soul Shield,
	new-player protection and intruder push-out.

	Workspace.Bases.BaseN (Model) must contain:
		Zone (Part)          invisible box = the base area (delivery + lock area)
		Pedestals (Folder)   Pedestal1..Pedestal25 (Parts)
		Spawn (Part)         where the owner spawns
		Barrier (Part)       visual force field shown while locked
		LockButton (Part)    owner presses to lock
		Sign (Part)          shows owner's name (BillboardGui with a TextLabel named "Text")
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Format = require(Shared.Util.Format)
local Remotes = require(Shared.Remotes)
local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)

export type BaseInfo = {
	Model: Model,
	Zone: BasePart,
	Pedestals: { BasePart },
	Spawn: BasePart,
	Barrier: BasePart?,
	LockButton: BasePart?,
	Sign: BasePart?,
	Owner: Player?,
	LockedUntil: number,
	LockCooldownUntil: number,
}

local BaseService = {}

local Services: any
local bases: { BaseInfo } = {}
local baseByPlayer: { [Player]: BaseInfo } = {}

local function numberSuffix(name: string): number
	return tonumber(string.match(name, "%d+$")) or 0
end

local function setSignText(base: BaseInfo, text: string)
	if not base.Sign then
		return
	end
	local label = base.Sign:FindFirstChild("Text", true)
	if label and label:IsA("TextLabel") then
		label.Text = text
	end
end

function BaseService:IsPointInBase(base: BaseInfo, position: Vector3): boolean
	local localPos = base.Zone.CFrame:PointToObjectSpace(position)
	local half = base.Zone.Size / 2
	return math.abs(localPos.X) <= half.X and math.abs(localPos.Y) <= half.Y and math.abs(localPos.Z) <= half.Z
end

function BaseService:GetBase(player: Player): BaseInfo?
	return baseByPlayer[player]
end

function BaseService:GetBaseOfUserId(userId: number): (BaseInfo?, Player?)
	for player, base in pairs(baseByPlayer) do
		if player.UserId == userId then
			return base, player
		end
	end
	return nil, nil
end

function BaseService:IsPlayerInOwnBase(player: Player): boolean
	local base = baseByPlayer[player]
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	return base ~= nil and root ~= nil and self:IsPointInBase(base, root.Position)
end

function BaseService:IsLocked(base: BaseInfo): boolean
	return os.clock() < base.LockedUntil
end

-- Returns true + reason if `owner`'s base can't be robbed right now.
function BaseService:IsProtected(owner: Player): (boolean, string?)
	local base = baseByPlayer[owner]
	local data = Services.PlayerDataService:GetData(owner)
	if not base or not data then
		return true, "That base is empty."
	end
	if self:IsLocked(base) then
		return true, "That base is locked!"
	end
	if os.time() < (data.ShieldUntil or 0) then
		return true, "That base has a Soul Shield!"
	end
	if data.Stats.PlayTime < GameConfig.NewPlayerProtectionSeconds and data.Rebirths == 0 then
		return true, "New players are protected for their first 15 minutes."
	end
	return false, nil
end

function BaseService:Lock(player: Player): (boolean, string?)
	local base = baseByPlayer[player]
	if not base then
		return false, "You don't have a base."
	end
	local now = os.clock()
	if now < base.LockedUntil then
		return false, "Already locked."
	end
	if now < base.LockCooldownUntil then
		return false, "Lock recharging: " .. Format.Time(base.LockCooldownUntil - now)
	end
	local fortress = Services.MonetizationService:HasPass(player, "Fortress")
	local duration = GameConfig.BaseLockDuration * (fortress and 2 or 1)
	local cooldown = GameConfig.BaseLockCooldown * (fortress and 0.5 or 1)
	base.LockedUntil = now + duration
	base.LockCooldownUntil = now + duration + cooldown
	player:SetAttribute("BaseLockedUntil", os.time() + duration)
	player:SetAttribute("BaseLockReadyAt", os.time() + duration + cooldown)
	if base.Barrier then
		base.Barrier.Transparency = 0.6
	end
	return true, string.format("Base locked for %ds!", duration)
end

function BaseService:TeleportHome(player: Player)
	local base = baseByPlayer[player]
	local character = player.Character
	if base and character then
		Services.AntiExploitService:Teleport(player, base.Spawn.CFrame + Vector3.new(0, 3, 0))
	end
end

local function assignBase(player: Player)
	if baseByPlayer[player] then
		return
	end
	for _, base in ipairs(bases) do
		if base.Owner == nil then
			base.Owner = player
			base.LockedUntil = 0
			base.LockCooldownUntil = 0
			baseByPlayer[player] = base
			player:SetAttribute("BaseName", base.Model.Name)
			setSignText(base, player.DisplayName .. "'s Soul Sanctum")
			Services.PetService:RenderBase(player)
			BaseService:TeleportHome(player)
			return
		end
	end
	player:Kick("This server is full of soul thieves - please join another server.")
end

local function releaseBase(player: Player)
	local base = baseByPlayer[player]
	if not base then
		return
	end
	baseByPlayer[player] = nil
	Services.PetService:ClearBase(base)
	base.Owner = nil
	base.LockedUntil = 0
	if base.Barrier then
		base.Barrier.Transparency = 1
	end
	setSignText(base, "Empty Base")
end

local function pushOut(base: BaseInfo, player: Player, root: BasePart)
	local center = base.Zone.Position
	local offset = Vector3.new(root.Position.X - center.X, 0, root.Position.Z - center.Z)
	if offset.Magnitude < 0.1 then
		offset = Vector3.new(0, 0, 1)
	end
	local radius = math.max(base.Zone.Size.X, base.Zone.Size.Z) / 2 + 8
	local target = center + offset.Unit * radius
	Services.AntiExploitService:Teleport(player, CFrame.new(target.X, root.Position.Y + 2, target.Z))
	Services.PlayerDataService:Notify(player, "That base is locked!", "error")
end

function BaseService:Init(services)
	Services = services
	local folder = Workspace:WaitForChild("Bases")
	local models = folder:GetChildren()
	table.sort(models, function(a, b)
		return numberSuffix(a.Name) < numberSuffix(b.Name)
	end)
	for _, model in ipairs(models) do
		if model:IsA("Model") then
			local pedestalsFolder = model:FindFirstChild("Pedestals")
			local pedestals = {}
			if pedestalsFolder then
				for _, p in ipairs(pedestalsFolder:GetChildren()) do
					if p:IsA("BasePart") then
						table.insert(pedestals, p)
					end
				end
				table.sort(pedestals, function(a, b)
					return numberSuffix(a.Name) < numberSuffix(b.Name)
				end)
			end
			local zone = model:FindFirstChild("Zone")
			local spawn = model:FindFirstChild("Spawn")
			if not (zone and zone:IsA("BasePart") and spawn and spawn:IsA("BasePart")) then
				warn("[BaseService] " .. model:GetFullName() .. " is missing Zone or Spawn - skipped")
				continue
			end
			local base: BaseInfo = {
				Model = model,
				Zone = zone,
				Pedestals = pedestals,
				Spawn = spawn,
				Barrier = model:FindFirstChild("Barrier") :: BasePart?,
				LockButton = model:FindFirstChild("LockButton") :: BasePart?,
				Sign = model:FindFirstChild("Sign") :: BasePart?,
				Owner = nil,
				LockedUntil = 0,
				LockCooldownUntil = 0,
			}
			if base.LockButton then
				local prompt = Instance.new("ProximityPrompt")
				prompt.ActionText = "Lock Base"
				prompt.ObjectText = "Soul Barrier"
				prompt.HoldDuration = 0.3
				prompt.MaxActivationDistance = 10
				prompt.RequiresLineOfSight = false
				prompt.Parent = base.LockButton
				prompt.Triggered:Connect(function(player)
					if base.Owner ~= player then
						Services.PlayerDataService:Notify(player, "This isn't your base!", "error")
						return
					end
					local ok, msg = BaseService:Lock(player)
					Services.PlayerDataService:Notify(player, msg or "", ok and "success" or "error")
				end)
			end
			table.insert(bases, base)
		end
	end

	Services.PlayerDataService.ProfileLoaded:Connect(function(player)
		assignBase(player)
	end)
end

function BaseService:Start()
	Players.PlayerRemoving:Connect(releaseBase)

	local function hookCharacter(player: Player)
		player.CharacterAdded:Connect(function(character)
			character:WaitForChild("HumanoidRootPart", 5)
			task.wait(0.2) -- let the default spawn finish before moving them home
			self:TeleportHome(player)
		end)
	end
	Players.PlayerAdded:Connect(hookCharacter)
	for _, player in ipairs(Players:GetPlayers()) do
		hookCharacter(player)
	end

	Remotes.Function("RequestLock").OnServerInvoke = function(player)
		if not RateLimiter.Check(player, "Lock", 0.5) then
			return { ok = false, msg = "Slow down!" }
		end
		local ok, msg = self:Lock(player)
		return { ok = ok, msg = msg }
	end

	-- Lock enforcement + barrier visuals
	task.spawn(function()
		while true do
			task.wait(0.2)
			for _, base in ipairs(bases) do
				local owner = base.Owner
				if owner then
					local locked = self:IsLocked(base)
					if not locked and base.Barrier and base.Barrier.Transparency < 1 then
						base.Barrier.Transparency = 1
					end
					if locked then
						for _, other in ipairs(Players:GetPlayers()) do
							if other ~= owner then
								local root = other.Character and other.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
								if root and self:IsPointInBase(base, root.Position) then
									pushOut(base, other, root)
								end
							end
						end
					end
				end
			end
		end
	end)
end

return BaseService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">BiomeService</string>
            <string name="Source"><![CDATA[--[[
	BiomeService
	Biome zones, Speed gates, Soul Orb spawning (rarity rolls) and dropped orbs.

	Spawn rarity weights come from PetConfig.SpawnWeight, modified by server luck (night/eclipse):
		Rare and above  : weight × spawnLuck
		Uncommon        : weight × sqrt(spawnLuck)
	Speed gates: a player inside a biome Zone with Speed below SpeedRequired is pushed back out.
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local PetConfig = require(Shared.Config.PetConfig)
local BiomeConfig = require(Shared.Config.BiomeConfig)
local Remotes = require(Shared.Remotes)
local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)
local ModelFactory = require(script.Parent.Parent.World.ModelFactory)

export type BiomeRuntime = {
	Id: string,
	Config: any,
	Model: Instance,
	Zone: BasePart,
	Spawns: { BasePart },
	GuardianSpawns: { BasePart },
	GateReturn: BasePart?,
	Occupied: { [BasePart]: Model },
	ActiveCount: number,
}

local BiomeService = {}

local Services: any
local runtimes: { BiomeRuntime } = {}
local byId: { [string]: BiomeRuntime } = {}
local rng = Random.new()
local droppedFolder: Folder
local WORLD_ORB_LIFETIME = 150

local function partsIn(folder: Instance?): { BasePart }
	local list = {}
	if folder then
		for _, child in ipairs(folder:GetChildren()) do
			if child:IsA("BasePart") then
				table.insert(list, child)
			end
		end
	end
	return list
end

-- Zones -----------------------------------------------------------------------------------------------
function BiomeService:IsInZone(runtime: BiomeRuntime, position: Vector3, padding: number?): boolean
	local localPos = runtime.Zone.CFrame:PointToObjectSpace(position)
	local half = runtime.Zone.Size / 2 + Vector3.one * (padding or 0)
	return math.abs(localPos.X) <= half.X and math.abs(localPos.Y) <= half.Y and math.abs(localPos.Z) <= half.Z
end

function BiomeService:GetBiomeAt(position: Vector3): BiomeRuntime?
	for _, runtime in ipairs(runtimes) do
		if self:IsInZone(runtime, position) then
			return runtime
		end
	end
	return nil
end

function BiomeService:GetRuntime(id: string): BiomeRuntime?
	return byId[id]
end

function BiomeService:GetRuntimes(): { BiomeRuntime }
	return runtimes
end

-- Rarity roll -----------------------------------------------------------------------------------------
function BiomeService:RollRarity(spawnLuck: number): string
	local weights = {}
	local total = 0
	for _, id in ipairs(PetConfig.RarityOrder) do
		local rarity = PetConfig.Rarities[id]
		local w = rarity.SpawnWeight
		if rarity.Order >= 3 then
			w *= spawnLuck
		elseif rarity.Order == 2 then
			w *= math.sqrt(spawnLuck)
		end
		weights[id] = w
		total += w
	end
	local roll = rng:NextNumber() * total
	for _, id in ipairs(PetConfig.RarityOrder) do
		roll -= weights[id]
		if roll <= 0 then
			return id
		end
	end
	return "Common"
end

-- Orb pickup --------------------------------------------------------------------------------------------
local function attachPickupPrompt(model: Model, orb: { Rarity: string, Biome: string, Mutation: string? }, onTaken: () -> (), requiredSpeed: number?)
	local primary = model.PrimaryPart
	if not primary then
		return
	end
	local rarity = PetConfig.GetRarity(orb.Rarity)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Steal Soul"
	prompt.ObjectText = orb.Rarity .. " Soul"
	prompt.HoldDuration = rarity.PickupHold
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = primary

	local taken = false
	prompt.Triggered:Connect(function(player)
		if taken or not RateLimiter.Check(player, "Pickup", 0.3) then
			return
		end
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not root or (root.Position - primary.Position).Magnitude > GameConfig.WorldOrbPickupMaxDistance then
			return
		end
		if Services.StealService:IsCarrying(player) then
			Services.PlayerDataService:Notify(player, "You can only carry one soul!", "error")
			return
		end
		if requiredSpeed then
			if Services.StealService:GetBaseSpeed(player) < requiredSpeed then
				return
			end
		end
		if Services.StealService:PickUp(player, orb, nil) then
			taken = true
			onTaken()
			model:Destroy()
		end
	end)
end

function BiomeService:SpawnWorldOrb(runtime: BiomeRuntime): boolean
	local free = {}
	for _, spawnPart in ipairs(runtime.Spawns) do
		if not runtime.Occupied[spawnPart] then
			table.insert(free, spawnPart)
		end
	end
	if #free == 0 then
		return false
	end
	local spawnPart = free[rng:NextInteger(1, #free)]
	local rarityId = self:RollRarity(Services.DayNightService:GetSpawnLuck())
	local orb = { Rarity = rarityId, Biome = runtime.Id }
	local model = ModelFactory.MakeOrb(rarityId, runtime.Id)
	model:PivotTo(spawnPart.CFrame + Vector3.new(0, 2, 0))
	model.Parent = runtime.Model

	runtime.Occupied[spawnPart] = model
	runtime.ActiveCount += 1
	local released = false
	local function release()
		if released then
			return
		end
		released = true
		runtime.Occupied[spawnPart] = nil
		runtime.ActiveCount -= 1
	end
	attachPickupPrompt(model, orb, release, runtime.Config.SpeedRequired)
	model.Destroying:Connect(release)

	-- Old uncollected souls fade so the field keeps rerolling.
	task.delay(WORLD_ORB_LIFETIME + rng:NextNumber(0, 30), function()
		if model.Parent then
			model:Destroy()
		end
	end)

	local rarity = PetConfig.GetRarity(rarityId)
	if rarity.Announce then
		Remotes.Event("Announce"):FireAllClients(
			string.format("A %s Soul appeared in %s!", rarityId, runtime.Config.Name),
			rarity.Color
		)
	end
	return true
end

function BiomeService:SpawnDroppedOrb(orb: { Rarity: string, Biome: string, Mutation: string? }, position: Vector3)
	local model = ModelFactory.MakeOrb(orb.Rarity, orb.Biome, orb.Mutation)
	model:PivotTo(CFrame.new(position + Vector3.new(0, 1, 0)))
	model.Name = "DroppedSoul"
	model.Parent = droppedFolder
	attachPickupPrompt(model, orb, function() end, nil)
	task.delay(GameConfig.DroppedOrbLifetime, function()
		if model.Parent then
			model:Destroy()
		end
	end)
end

-- Speed gates ----------------------------------------------------------------------------------------------
local function pushOutOfBiome(player: Player, runtime: BiomeRuntime, root: BasePart)
	local target: Vector3
	if runtime.GateReturn then
		target = runtime.GateReturn.Position
	else
		local zone = runtime.Zone
		local localPos = zone.CFrame:PointToObjectSpace(root.Position)
		local world = zone.CFrame:PointToWorldSpace(Vector3.new(localPos.X, 0, -zone.Size.Z / 2 - 8))
		target = Vector3.new(world.X, root.Position.Y, world.Z)
	end
	Services.AntiExploitService:Teleport(player, CFrame.new(target))
	if RateLimiter.Check(player, "GateNotify", 2) then
		Services.PlayerDataService:Notify(
			player,
			string.format("%s requires %d Speed! Upgrade at your Treadmill.", runtime.Config.Name, runtime.Config.SpeedRequired),
			"error"
		)
	end
end

-- Lifecycle -------------------------------------------------------------------------------------------------
function BiomeService:Init(services)
	Services = services
	droppedFolder = Instance.new("Folder")
	droppedFolder.Name = "DroppedSouls"
	droppedFolder.Parent = Workspace

	local biomesFolder = Workspace:WaitForChild("Biomes")
	for _, id in ipairs(BiomeConfig.Order) do
		local model = biomesFolder:FindFirstChild(id)
		local zone = model and model:FindFirstChild("Zone")
		if not (model and zone and zone:IsA("BasePart")) then
			warn("[BiomeService] Biome '" .. id .. "' missing in Workspace.Biomes (needs a Zone part) - skipped")
			continue
		end
		local runtime: BiomeRuntime = {
			Id = id,
			Config = BiomeConfig.Get(id),
			Model = model,
			Zone = zone,
			Spawns = partsIn(model:FindFirstChild("SoulSpawns")),
			GuardianSpawns = partsIn(model:FindFirstChild("GuardianSpawns")),
			GateReturn = model:FindFirstChild("GateReturn") :: BasePart?,
			Occupied = {},
			ActiveCount = 0,
		}
		if #runtime.Spawns == 0 then
			warn("[BiomeService] Biome '" .. id .. "' has no SoulSpawns")
		end
		table.insert(runtimes, runtime)
		byId[id] = runtime
	end
end

function BiomeService:Start()
	-- Orb spawners (one loop per biome)
	for _, runtime in ipairs(runtimes) do
		task.spawn(function()
			-- Pre-fill half the field so the server never starts empty
			for _ = 1, math.floor(runtime.Config.MaxOrbs / 2) do
				self:SpawnWorldOrb(runtime)
			end
			while true do
				task.wait(runtime.Config.RespawnSeconds)
				if runtime.ActiveCount < runtime.Config.MaxOrbs then
					self:SpawnWorldOrb(runtime)
				end
			end
		end)
	end

	-- Speed gate enforcement
	task.spawn(function()
		while true do
			task.wait(0.25)
			for _, player in ipairs(Players:GetPlayers()) do
				local data = Services.PlayerDataService:GetData(player)
				local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
				if data and root then
					local runtime = self:GetBiomeAt(root.Position)
					player:SetAttribute("Biome", runtime and runtime.Id or nil)
					if runtime and Services.StealService:GetBaseSpeed(player) < runtime.Config.SpeedRequired then
						pushOutOfBiome(player, runtime, root)
					end
				end
			end
		end
	end)
end

return BiomeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">CodesService</string>
            <string name="Source"><![CDATA[--[[
	CodesService
	Redeemable promo codes (definitions in ServerScriptService/Server/Config/Codes - never replicated).
	RedeemCode(code) -> { ok, msg }
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)
local Codes = require(script.Parent.Parent.Config.Codes)
local Rewards = require(script.Parent.Parent.Util.Rewards)

local CodesService = {}

local Services: any
local MAX_CODE_LENGTH = 32

local function normalize(code: any): string?
	if type(code) ~= "string" or #code == 0 or #code > MAX_CODE_LENGTH then
		return nil
	end
	local cleaned = string.upper((string.gsub(code, "%s+", "")))
	if not string.match(cleaned, "^[%w_]+$") then
		return nil
	end
	return cleaned
end

function CodesService:Redeem(player: Player, rawCode: any)
	if not RateLimiter.Check(player, "Code", 2) then
		return { ok = false, msg = "Wait a moment before trying another code." }
	end
	local data = Services.PlayerDataService:GetData(player)
	if not data then
		return { ok = false, msg = "Data not loaded yet." }
	end
	local code = normalize(rawCode)
	local entry = code and Codes[code]
	if not code or not entry then
		return { ok = false, msg = "Invalid code." }
	end
	if data.RedeemedCodes[code] then
		return { ok = false, msg = "You already redeemed this code." }
	end
	if entry.Expires and os.time() > entry.Expires then
		return { ok = false, msg = "This code has expired." }
	end
	if entry.MinRebirths and data.Rebirths < entry.MinRebirths then
		return { ok = false, msg = "Requires " .. entry.MinRebirths .. " rebirth(s)." }
	end
	data.RedeemedCodes[code] = true
	local granted = Rewards.Grant(Services, player, entry.Rewards)
	Services.PlayerDataService:MarkDirty(player)
	return { ok = true, msg = "Redeemed: " .. table.concat(granted, ", ") }
end

function CodesService:Init(services)
	Services = services
end

function CodesService:Start()
	Remotes.Function("RedeemCode").OnServerInvoke = function(player, code)
		return self:Redeem(player, code)
	end
end

return CodesService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">CompanionService</string>
            <string name="Source"><![CDATA[--[[
	CompanionService
	Pick one of your spirits as a Companion: it floats next to you (rendered by every client from
	player attributes) and gives you an active ability based on its biome (AbilityConfig.ByBiome).
	Rarer / mutated companions recharge faster. The companion keeps earning on its pedestal.

	Player attributes (for UI + client-side companion visuals):
		CompanionSpecies, CompanionRarity, CompanionMutation, AbilityId, AbilityName, AbilityCooldown,
		AbilityReadyAt (Workspace:GetServerTimeNow() timestamp)
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local PetConfig = require(Shared.Config.PetConfig)
local AbilityConfig = require(Shared.Config.AbilityConfig)
local Remotes = require(Shared.Remotes)
local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)

local CompanionService = {}

local Services: any
local readyAt: { [Player]: number } = {} -- os.clock() time the ability is ready
local ATTRIBUTES = { "CompanionSpecies", "CompanionRarity", "CompanionMutation", "AbilityId", "AbilityName", "AbilityCooldown", "AbilityReadyAt" }

local function getCompanion(player: Player): (any?, any?)
	local data = Services.PlayerDataService:GetData(player)
	if not data or data.CompanionId == "" then
		return nil, data
	end
	return data.Pets[data.CompanionId], data
end

-- Re-syncs attributes; clears the companion if the pet no longer exists (sold, fused, lost in rebirth).
function CompanionService:Refresh(player: Player)
	local pet, data = getCompanion(player)
	if data and data.CompanionId ~= "" and not pet then
		data.CompanionId = ""
	end
	if not pet then
		for _, name in ipairs(ATTRIBUTES) do
			player:SetAttribute(name, nil)
		end
		return
	end
	local ability = AbilityConfig.ByBiome[pet.Biome] or AbilityConfig.ByBiome.Meadow
	local cooldown = AbilityConfig.GetCooldown(pet.Biome, PetConfig.GetRarity(pet.Rarity).Order, pet.Mutation ~= "None")
	player:SetAttribute("CompanionSpecies", pet.Species)
	player:SetAttribute("CompanionRarity", pet.Rarity)
	player:SetAttribute("CompanionMutation", pet.Mutation)
	player:SetAttribute("AbilityId", ability.Id)
	player:SetAttribute("AbilityName", ability.Name)
	player:SetAttribute("AbilityCooldown", cooldown)
	local remaining = math.max(0, (readyAt[player] or 0) - os.clock())
	player:SetAttribute("AbilityReadyAt", Workspace:GetServerTimeNow() + remaining)
end

function CompanionService:SetCompanion(player: Player, petId: any)
	local data = Services.PlayerDataService:GetData(player)
	if not data then
		return { ok = false }
	end
	if petId == nil or petId == "" then
		data.CompanionId = ""
		self:Refresh(player)
		Services.PlayerDataService:MarkDirty(player)
		return { ok = true, msg = "Companion dismissed." }
	end
	petId = tostring(petId)
	local pet = data.Pets[petId]
	if not pet then
		return { ok = false, msg = "Spirit not found." }
	end
	data.CompanionId = petId
	self:Refresh(player)
	Services.PlayerDataService:MarkDirty(player)
	local ability = AbilityConfig.ByBiome[pet.Biome] or AbilityConfig.ByBiome.Meadow
	return { ok = true, msg = string.format("%s follows you! Ability: %s (Q)", pet.Species, ability.Name) }
end

local function freezeEffect(player: Player, ability: any)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return 0
	end
	return Services.GuardianService:FreezeNear(root.Position, ability.Radius or 30, ability.Duration or 3)
end

-- Temporarily fades a character (Shadow Cloak). Restores original transparency afterwards.
local function cloak(player: Player, seconds: number)
	local character = player.Character
	if not character then
		return
	end
	local original: { [BasePart]: number } = {}
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
			original[part] = part.Transparency
			part.Transparency = math.max(part.Transparency, 0.92)
		end
	end
	task.delay(seconds, function()
		for part, value in pairs(original) do
			if part.Parent then
				part.Transparency = value
			end
		end
	end)
end

function CompanionService:UseAbility(player: Player)
	local pet = getCompanion(player)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not pet then
		return { ok = false, msg = "Choose a Companion spirit in the Spirits menu first!" }
	end
	if not root then
		return { ok = false }
	end
	local now = os.clock()
	if now < (readyAt[player] or 0) then
		return { ok = false, msg = string.format("Recharging (%.0fs)", readyAt[player] - now) }
	end
	local ability = AbilityConfig.ByBiome[pet.Biome] or AbilityConfig.ByBiome.Meadow
	local steal = Services.StealService
	local id = ability.Id
	local msg = ability.Name .. "!"

	if id == "WispRush" then
		steal:ApplySlow(player, ability.SpeedMult or 1.35, ability.Duration or 3)
	elseif id == "FlameDash" or id == "LightningStep" then
		local look = root.CFrame.LookVector
		steal:Launch(player, Vector3.new(look.X, 0, look.Z).Unit * (ability.Power or 110) + Vector3.new(0, 18, 0))
		if ability.SpeedMult then
			steal:ApplySlow(player, ability.SpeedMult, ability.Duration or 2)
		end
	elseif id == "FrostNova" then
		local frozen = freezeEffect(player, ability)
		msg = string.format("Frost Nova froze %d guardian(s)!", frozen)
	elseif id == "GraveVeil" then
		steal:HideFromGuardians(player, ability.Duration or 4)
	elseif id == "ShadowCloak" then
		steal:HideFromGuardians(player, ability.Duration or 5)
		cloak(player, ability.Duration or 5)
	elseif id == "HaloWard" then
		steal:Ward(player, ability.Duration or 8)
	elseif id == "ReapersRend" then
		local frozen = freezeEffect(player, ability)
		steal:ApplySlow(player, ability.SpeedMult or 1.4, ability.Duration or 4)
		msg = string.format("Reaper's Rend! %d guardian(s) frozen!", frozen)
	end

	local cooldown = AbilityConfig.GetCooldown(pet.Biome, PetConfig.GetRarity(pet.Rarity).Order, pet.Mutation ~= "None")
	readyAt[player] = now + cooldown
	player:SetAttribute("AbilityReadyAt", Workspace:GetServerTimeNow() + cooldown)
	return { ok = true, msg = msg }
end

function CompanionService:Init(services)
	Services = services
	Services.PlayerDataService.ProfileLoaded:Connect(function(player)
		self:Refresh(player)
	end)
end

function CompanionService:Start()
	Players.PlayerRemoving:Connect(function(player)
		readyAt[player] = nil
	end)
	Remotes.Function("SetCompanion").OnServerInvoke = function(player, petId)
		if not RateLimiter.Check(player, "SetCompanion", 0.5) then
			return { ok = false, msg = "Slow down!" }
		end
		return self:SetCompanion(player, petId)
	end
	Remotes.Function("UseAbility").OnServerInvoke = function(player)
		if not RateLimiter.Check(player, "UseAbility", 0.25) then
			return { ok = false }
		end
		return self:UseAbility(player)
	end
end

return CompanionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">DayNightService</string>
            <string name="Source"><![CDATA[--[[
	DayNightService
	Drives the 10-minute day/night cycle and the Soul Eclipse event.

	Day      : normal spawns.
	Night    : 2x spawn luck, 2x mutation luck, Moonlit mutation unlocked, guardians +20% speed.
	Eclipse  : every 4th night (or bought via "Summon Soul Eclipse"): 5x spawn luck, Eclipsed mutation,
	           guardians +35% speed. Server-wide announcement.

	Replicated as Workspace attributes: IsNight, IsEclipse, EclipseEndsAt, CycleTime
]]

local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Signal = require(Shared.Util.Signal)
local Remotes = require(Shared.Remotes)

local DayNightService = {}
DayNightService.PhaseChanged = Signal.new() -- (isNight: boolean, isEclipse: boolean)

local cfg = GameConfig.DayNight
local isNight = false
local purchasedEclipseUntil = 0
local naturalEclipse = false
local nightCount = 0

function DayNightService:IsNight(): boolean
	return isNight
end

function DayNightService:IsEclipse(): boolean
	return naturalEclipse or os.time() < purchasedEclipseUntil
end

function DayNightService:GetSpawnLuck(): number
	if self:IsEclipse() then
		return cfg.Eclipse.SpawnLuck
	elseif isNight then
		return cfg.Night.SpawnLuck
	end
	return 1
end

function DayNightService:GetMutationLuck(): number
	if self:IsEclipse() then
		return cfg.Eclipse.MutationLuck
	elseif isNight then
		return cfg.Night.MutationLuck
	end
	return 1
end

function DayNightService:GetGuardianSpeedMult(): number
	if self:IsEclipse() then
		return cfg.Eclipse.GuardianSpeed
	elseif isNight then
		return cfg.Night.GuardianSpeed
	end
	return 1
end

-- Called by MonetizationService (product) or admins.
function DayNightService:StartEclipse(seconds: number, byName: string?)
	purchasedEclipseUntil = math.max(purchasedEclipseUntil, os.time()) + seconds
	Workspace:SetAttribute("IsEclipse", true)
	Workspace:SetAttribute("EclipseEndsAt", purchasedEclipseUntil)
	local who = byName and (byName .. " summoned a ") or "A "
	Remotes.Event("Announce"):FireAllClients(who .. "SOUL ECLIPSE! 5x soul luck for everyone!", Color3.fromRGB(255, 80, 30))
	self.PhaseChanged:Fire(isNight, true)
end

local function applyLighting(cycleTime: number)
	-- Map the cycle onto ClockTime: day phase 6:00 -> 18:00, night phase 18:00 -> 6:00
	local clock
	if cycleTime < cfg.NightStart then
		clock = 6 + (cycleTime / cfg.NightStart) * 12
	else
		clock = 18 + ((cycleTime - cfg.NightStart) / (cfg.CycleSeconds - cfg.NightStart)) * 12
	end
	Lighting.ClockTime = clock % 24
end

function DayNightService:Init() end

function DayNightService:Start()
	local startClock = os.clock()
	Workspace:SetAttribute("IsNight", false)
	Workspace:SetAttribute("IsEclipse", false)

	task.spawn(function()
		local lastEclipseState = false
		while true do
			local cycleTime = (os.clock() - startClock) % cfg.CycleSeconds
			local nowNight = cycleTime >= cfg.NightStart
			if nowNight ~= isNight then
				isNight = nowNight
				if isNight then
					nightCount += 1
					naturalEclipse = nightCount % cfg.EclipseEveryNthNight == 0
					if naturalEclipse then
						Remotes.Event("Announce"):FireAllClients("A SOUL ECLIPSE rises... rare souls everywhere!", Color3.fromRGB(255, 80, 30))
					else
						Remotes.Event("Announce"):FireAllClients("Night falls. Souls glow brighter... guardians hunt faster.", Color3.fromRGB(140, 150, 255))
					end
				else
					naturalEclipse = false
					Remotes.Event("Announce"):FireAllClients("Dawn breaks. The guardians calm down.", Color3.fromRGB(255, 220, 120))
				end
				Workspace:SetAttribute("IsNight", isNight)
				self.PhaseChanged:Fire(isNight, self:IsEclipse())
			end
			local eclipse = self:IsEclipse()
			if eclipse ~= lastEclipseState then
				lastEclipseState = eclipse
				Workspace:SetAttribute("IsEclipse", eclipse)
				Lighting.Ambient = eclipse and Color3.fromRGB(120, 30, 20) or Color3.fromRGB(70, 70, 90)
			end
			Workspace:SetAttribute("CycleTime", cycleTime)
			applyLighting(cycleTime)
			task.wait(1)
		end
	end)
end

return DayNightService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">EconomyService</string>
            <string name="Source"><![CDATA[--[[
	EconomyService
	Passive income, multipliers, luck, timed boosts, offline earnings.

	Income/sec = Σ(placed pet income) × RebirthMult × AttunementMult × SocialMult × PassMult × BoostMult × IndexMult
		RebirthMult    = 1 + 0.5 × rebirths
		AttunementMult = 1 + 0.10 × Attunement perk level
		SocialMult     = 1 + Premium(0.10) + Group(0.10) + VIP(0.10) + 0.10 × friends in server (max 4)
		PassMult       = 2 with the 2x Essence pass
		BoostMult      = 2 while a 2x Essence potion is active (stacks with the pass -> 4x)
		IndexMult      = 1 + 0.01 × unique spirits discovered (Spirit Index)

	Luck = SuperLuckPass(2) × Potion(2 or 5) × (1 + 0.10 × Soul Magnet level)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local EconomyConfig = require(Shared.Config.EconomyConfig)
local MonetizationConfig = require(Shared.Config.MonetizationConfig)
local Formulas = require(Shared.Formulas)
local RewardConfig = require(Shared.Config.RewardConfig)
local Format = require(Shared.Util.Format)

local EconomyService = {}

local Services: any
local incomeCache: { [Player]: number } = {}
local friendsWith: { [Player]: { [Player]: boolean } } = {}
local groupMember: { [Player]: boolean } = {}

local function countKeys(map: { [any]: any }?): number
	local count = 0
	for _ in pairs(map or {}) do
		count += 1
	end
	return count
end

-- Multipliers -----------------------------------------------------------------------------
local function countFriendsInServer(player: Player): number
	local count = 0
	local map = friendsWith[player]
	if map then
		for other, isFriend in pairs(map) do
			if isFriend and other.Parent then
				count += 1
			end
		end
	end
	return math.min(count, GameConfig.MaxFriendBonuses)
end

function EconomyService:GetMultiplierBreakdown(player: Player)
	local data = Services.PlayerDataService:GetData(player)
	if not data then
		return { Total = 1 }
	end
	local monetization = Services.MonetizationService
	local social = 1
	if player.MembershipType == Enum.MembershipType.Premium then
		social += GameConfig.PremiumIncomeBonus
	end
	if groupMember[player] then
		social += GameConfig.GroupIncomeBonus
	end
	if monetization:HasPass(player, "VIP") then
		social += MonetizationConfig.Effects.VIPIncomeBonus
	end
	social += countFriendsInServer(player) * GameConfig.FriendIncomeBonus

	local breakdown = {
		Rebirth = Formulas.RebirthMultiplier(data.Rebirths),
		Attunement = 1 + (data.Perks.Attunement or 0) * EconomyConfig.Perks.Attunement.PerLevel,
		Social = social,
		Pass = monetization:HasPass(player, "DoubleEssence") and 2 or 1,
		Boost = (data.Boosts.Essence2x or 0) > 0 and 2 or 1,
		Index = 1 + countKeys(data.Index) * RewardConfig.IndexBonusPerSpecies,
	}
	breakdown.Total = breakdown.Rebirth * breakdown.Attunement * breakdown.Social * breakdown.Pass * breakdown.Boost * breakdown.Index
	return breakdown
end

function EconomyService:GetLuck(player: Player): number
	local data = Services.PlayerDataService:GetData(player)
	if not data then
		return 1
	end
	local luck = 1
	if Services.MonetizationService:HasPass(player, "SuperLuck") then
		luck *= 2
	end
	if (data.Boosts.Luck5x or 0) > 0 then
		luck *= 5
	elseif (data.Boosts.Luck2x or 0) > 0 then
		luck *= 2
	end
	luck *= 1 + (data.Perks.SoulMagnet or 0) * EconomyConfig.Perks.SoulMagnet.PerLevel
	return luck
end

-- Income -------------------------------------------------------------------------------------
function EconomyService:GetBaseIncome(player: Player): number
	local data = Services.PlayerDataService:GetData(player)
	if not data then
		return 0
	end
	local total = 0
	local active = Services.PetService:GetActivePedestalCount(player)
	for i = 1, active do
		local slot = data.Slots[tostring(i)]
		if slot and slot.Type == "Pet" then
			local pet = data.Pets[slot.PetId]
			if pet then
				total += Formulas.PetIncome(pet.Rarity, pet.Biome, pet.Mutation)
			end
		end
	end
	return total
end

function EconomyService:Recalculate(player: Player)
	if not Services.PlayerDataService:IsLoaded(player) then
		return
	end
	local income = self:GetBaseIncome(player) * self:GetMultiplierBreakdown(player).Total
	incomeCache[player] = income
	player:SetAttribute("Income", income)
	player:SetAttribute("Luck", self:GetLuck(player))
	Services.PlayerDataService:MarkDirty(player)
end

function EconomyService:GetIncome(player: Player): number
	return incomeCache[player] or 0
end

-- Essence ---------------------------------------------------------------------------------------
function EconomyService:AddEssence(player: Player, amount: number)
	local data = Services.PlayerDataService:GetData(player)
	if not data or amount ~= amount or amount <= 0 or amount == math.huge then
		return
	end
	data.Essence += amount
	data.Stats.TotalEssence += amount
	Services.PlayerDataService:Replicate(player)
end

function EconomyService:CanAfford(player: Player, cost: number): boolean
	local data = Services.PlayerDataService:GetData(player)
	return data ~= nil and data.Essence >= cost
end

-- Atomically checks and spends. Returns true on success.
function EconomyService:TrySpend(player: Player, cost: number): boolean
	local data = Services.PlayerDataService:GetData(player)
	if not data or cost ~= cost or cost < 0 or data.Essence < cost then
		return false
	end
	data.Essence -= cost
	Services.PlayerDataService:Replicate(player)
	return true
end

-- Boosts ---------------------------------------------------------------------------------------------
function EconomyService:AddBoost(player: Player, kind: string, seconds: number)
	local data = Services.PlayerDataService:GetData(player)
	if not data or data.Boosts[kind] == nil then
		return
	end
	data.Boosts[kind] += seconds
	self:Recalculate(player)
end

-- Offline earnings ----------------------------------------------------------------------------------
local function grantOfflineEarnings(player: Player, data: any)
	Services.MonetizationService:WaitForPasses(player)
	if data.LastOnline <= 0 or data.LastIncome <= 0 then
		return
	end
	local elapsed = os.time() - data.LastOnline
	if elapsed < 60 then
		return
	end
	local hasPass = Services.MonetizationService:HasPass(player, "OfflineOvertime")
	local percent = hasPass and EconomyConfig.OfflinePassPercent or EconomyConfig.OfflineFreePercent
	local cap = hasPass and EconomyConfig.OfflinePassCapSeconds or EconomyConfig.OfflineFreeCapSeconds
	local amount = math.floor(data.LastIncome * math.min(elapsed, cap) * percent)
	if amount > 0 then
		EconomyService:AddEssence(player, amount)
		local tip = hasPass and "" or " (Spirit Overtime pass = 5x more!)"
		Services.PlayerDataService:Notify(player, string.format("Your spirits earned %s Essence while you were away!%s", Format.Number(amount), tip), "success")
	end
end

-- Social -------------------------------------------------------------------------------------------
local function refreshFriends(newPlayer: Player)
	friendsWith[newPlayer] = friendsWith[newPlayer] or {}
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= newPlayer then
			local ok, isFriend = pcall(newPlayer.IsFriendsWithAsync, newPlayer, other.UserId)
			if ok then
				friendsWith[newPlayer][other] = isFriend
				friendsWith[other] = friendsWith[other] or {}
				friendsWith[other][newPlayer] = isFriend
				if isFriend then
					EconomyService:Recalculate(other)
				end
			end
		end
	end
	EconomyService:Recalculate(newPlayer)
end

-- Lifecycle -----------------------------------------------------------------------------------------
function EconomyService:Init(services)
	Services = services
	Services.PlayerDataService.ProfileLoaded:Connect(function(player, data)
		if GameConfig.GroupId ~= 0 then
			local ok, inGroup = pcall(player.IsInGroup, player, GameConfig.GroupId)
			groupMember[player] = ok and inGroup or false
		end
		self:Recalculate(player)
		grantOfflineEarnings(player, data)
		refreshFriends(player)
	end)
end

function EconomyService:Start()
	Players.PlayerRemoving:Connect(function(player)
		incomeCache[player] = nil
		groupMember[player] = nil
		friendsWith[player] = nil
		for other, map in pairs(friendsWith) do
			if map[player] then
				map[player] = nil
				self:Recalculate(other)
			end
		end
	end)

	-- 1 Hz income tick
	task.spawn(function()
		while true do
			task.wait(1)
			for player, data in pairs(Services.PlayerDataService:GetAllLoaded()) do
				local income = incomeCache[player] or 0
				if income > 0 then
					data.Essence += income
					data.Stats.TotalEssence += income
				end
				data.LastIncome = income
				data.Stats.PlayTime += 1

				local boostExpired = false
				for kind, remaining in pairs(data.Boosts) do
					if remaining > 0 then
						data.Boosts[kind] = math.max(0, remaining - 1)
						if data.Boosts[kind] == 0 then
							boostExpired = true
						end
					end
				end
				if boostExpired then
					self:Recalculate(player)
					Services.PlayerDataService:Notify(player, "A boost has expired.", "warning")
				end
				Services.PlayerDataService:Replicate(player)
			end
		end
	end)
end

return EconomyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">EventService</string>
            <string name="Source"><![CDATA[--[[
	EventService
	Seasonal events. Currently: the Hallow-Soul Festival (Halloween).

	While active:
	  * Spooky lighting (purple ambient, orange haze) + jack-o'-lanterns, tombstones and lanterns everywhere
	  * Candy pumpkins spawn around the hub and inside biomes (deeper biome = more candy, 5% golden = 15 candy)
	  * Delivering a soul home gives Candy (1 + rarity tier)
	  * The "Haunted" mutation (x10) can roll on any hatch
	  * Candy Shop: guaranteed Haunted souls + boosts (EventConfig.Shop)
	Replicated: Workspace attributes EventActive, EventName, EventEndsAt; player attribute Candy.
]]

local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local EventConfig = require(Shared.Config.EventConfig)
local PetConfig = require(Shared.Config.PetConfig)
local Remotes = require(Shared.Remotes)
local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)
local Rewards = require(script.Parent.Parent.Util.Rewards)

local EventService = {}

local Services: any
local rng = Random.new()
local pumpkinFolder: Folder
local pumpkinCount = 0

function EventService:IsActive(): boolean
	return EventConfig.IsActive()
end

function EventService:AddCandy(player: Player, amount: number, countForQuests: boolean?)
	local data = Services.PlayerDataService:GetData(player)
	if not data or amount <= 0 then
		return
	end
	data.Candy += amount
	data.Stats.CandyEarned += amount
	player:SetAttribute("Candy", data.Candy)
	if countForQuests ~= false then
		Services.RewardService:Progress(player, "Candy", amount)
	end
	Services.PlayerDataService:MarkDirty(player)
end

-- Called by StealService when a soul is delivered home.
function EventService:OnDeliver(player: Player, rarityId: string)
	if self:IsActive() then
		self:AddCandy(player, EventConfig.DeliverCandyBase + PetConfig.GetRarity(rarityId).Order, false)
	end
end

function EventService:BuyItem(player: Player, itemId: any)
	if not self:IsActive() then
		return { ok = false, msg = "The event has ended." }
	end
	local data = Services.PlayerDataService:GetData(player)
	if not data then
		return { ok = false }
	end
	local item
	for _, entry in ipairs(EventConfig.Shop) do
		if entry.Id == itemId then
			item = entry
		end
	end
	if not item then
		return { ok = false, msg = "Unknown item." }
	end
	if data.Candy < item.Cost then
		return { ok = false, msg = "Need " .. item.Cost .. " Candy" }
	end
	data.Candy -= item.Cost
	player:SetAttribute("Candy", data.Candy)
	local rewards = {}
	if item.Orb then
		rewards.Orb = { Rarity = item.Orb.Rarity, Biome = "Best", Mutation = item.Orb.Mutation }
	end
	if item.Boost then
		rewards.Boost = item.Boost
	end
	local granted = Rewards.Grant(Services, player, rewards)
	return { ok = true, msg = "Bought: " .. table.concat(granted, ", ") }
end

-- Visual dressing ---------------------------------------------------------------------------------------
local function makePart(props: { [string]: any }): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in pairs(props) do
		if key ~= "Parent" then
			(part :: any)[key] = value
		end
	end
	part.Parent = props.Parent
	return part
end

-- A jack-o'-lantern model: orange ball, stem, glowing eyes + mouth, orange light.
local function makeJackOLantern(position: Vector3, size: number, golden: boolean?): Model
	local model = Instance.new("Model")
	model.Name = golden and "GoldenPumpkin" or "Pumpkin"
	local body = makePart({
		Name = "Body", Shape = Enum.PartType.Ball, Size = Vector3.one * size,
		Color = golden and Color3.fromRGB(255, 210, 60) or Color3.fromRGB(235, 110, 20),
		Material = golden and Enum.Material.Neon or Enum.Material.SmoothPlastic,
		CFrame = CFrame.new(position), Parent = model,
	})
	makePart({
		Name = "Stem", Size = Vector3.new(size * 0.15, size * 0.3, size * 0.15), Color = Color3.fromRGB(70, 120, 40),
		CFrame = CFrame.new(position + Vector3.new(0, size * 0.55, 0)), Parent = model,
	})
	local glow = Color3.fromRGB(255, 200, 60)
	for _, side in ipairs({ -1, 1 }) do
		makePart({
			Name = "Eye", Size = Vector3.new(size * 0.18, size * 0.18, size * 0.1), Color = glow, Material = Enum.Material.Neon,
			CFrame = CFrame.new(position + Vector3.new(side * size * 0.2, size * 0.12, -size * 0.47)) * CFrame.Angles(0, 0, math.rad(45)),
			Parent = model,
		})
	end
	makePart({
		Name = "Mouth", Size = Vector3.new(size * 0.5, size * 0.1, size * 0.1), Color = glow, Material = Enum.Material.Neon,
		CFrame = CFrame.new(position + Vector3.new(0, -size * 0.18, -size * 0.46)), Parent = model,
	})
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 140, 40)
	light.Range = size * 4
	light.Brightness = 1.5
	light.Parent = body
	model.PrimaryPart = body
	return model
end

local function makeTombstone(position: Vector3, parent: Instance)
	local height = rng:NextNumber(3, 5)
	makePart({
		Name = "Tombstone", Size = Vector3.new(2.6, height, 0.8), Color = Color3.fromRGB(110, 110, 120),
		Material = Enum.Material.Slate, CanCollide = true,
		CFrame = CFrame.new(position + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), math.rad(rng:NextNumber(-8, 8))),
		Parent = parent,
	})
end

local function groundAt(x: number, z: number, top: number, depth: number): Vector3?
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { pumpkinFolder }
	local result = Workspace:Raycast(Vector3.new(x, top, z), Vector3.new(0, -depth, 0), params)
	return result and result.Position or nil
end

-- Random point on the ground inside a box-shaped part (zone).
local function randomPointIn(zone: BasePart): Vector3?
	local half = zone.Size / 2
	local localPoint = Vector3.new(rng:NextNumber(-half.X * 0.9, half.X * 0.9), half.Y, rng:NextNumber(-half.Z * 0.9, half.Z * 0.9))
	local world = zone.CFrame:PointToWorldSpace(localPoint)
	return groundAt(world.X, world.Z, world.Y + 20, zone.Size.Y + 40)
end

local function spawnAreas(): { { Zone: BasePart, Bonus: number } }
	local areas = {}
	local hub = Workspace:FindFirstChild("Hub")
	local hubGround = hub and hub:FindFirstChild("HubGround")
	if hubGround and hubGround:IsA("BasePart") then
		table.insert(areas, { Zone = hubGround, Bonus = 0 })
	end
	for _, runtime in ipairs(Services.BiomeService:GetRuntimes()) do
		table.insert(areas, { Zone = runtime.Zone, Bonus = runtime.Config.Order - 1 })
	end
	return areas
end

local function decorate()
	if Workspace:FindFirstChild("HalloweenDecor") then
		return -- you built your own decorations
	end
	local decor = Instance.new("Folder")
	decor.Name = "HalloweenDecor"
	decor.Parent = Workspace

	-- Jack-o'-lanterns at every base corner
	local bases = Workspace:FindFirstChild("Bases")
	if bases then
		for _, base in ipairs(bases:GetChildren()) do
			local zone = base:FindFirstChild("Zone")
			if zone and zone:IsA("BasePart") then
				for _, corner in ipairs({ Vector3.new(1, 0, 1), Vector3.new(-1, 0, 1), Vector3.new(1, 0, -1), Vector3.new(-1, 0, -1) }) do
					local x = zone.Position.X + corner.X * (zone.Size.X / 2 - 2)
					local z = zone.Position.Z + corner.Z * (zone.Size.Z / 2 - 2)
					local ground = groundAt(x, z, zone.Position.Y + zone.Size.Y / 2 + 20, zone.Size.Y + 40)
					if ground then
						makeJackOLantern(ground + Vector3.new(0, 1.6, 0), 3.2).Parent = decor
					end
				end
			end
		end
	end

	-- Tombstones + lanterns scattered through every area
	for _, area in ipairs(spawnAreas()) do
		for _ = 1, 14 do
			local point = randomPointIn(area.Zone)
			if point then
				if rng:NextNumber() < 0.6 then
					makeTombstone(point, decor)
				else
					makeJackOLantern(point + Vector3.new(0, 1.3, 0), rng:NextNumber(2.2, 3.4)).Parent = decor
				end
			end
		end
	end
end

local function applyLighting()
	local cfg = EventConfig.Lighting
	Lighting.OutdoorAmbient = cfg.OutdoorAmbient
	Lighting.FogColor = cfg.FogColor
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmosphere.Density = cfg.AtmosphereDensity
	atmosphere.Color = cfg.AtmosphereColor
	atmosphere.Decay = Color3.fromRGB(70, 30, 90)
	atmosphere.Glare = 0.4
	atmosphere.Haze = 2
	atmosphere.Parent = Lighting
	local correction: ColorCorrectionEffect = (Lighting:FindFirstChild("EventTint") :: any) or Instance.new("ColorCorrectionEffect")
	correction.Name = "EventTint"
	correction.TintColor = cfg.Tint
	correction.Saturation = 0.15
	correction.Parent = Lighting
end

-- Candy pumpkins ----------------------------------------------------------------------------------------
local function spawnPumpkin(areas: { { Zone: BasePart, Bonus: number } })
	if #areas == 0 then
		return
	end
	local area = areas[rng:NextInteger(1, #areas)]
	local point = randomPointIn(area.Zone)
	if not point then
		return
	end
	local golden = rng:NextNumber() < EventConfig.GoldenPumpkinChance
	local model = makeJackOLantern(point + Vector3.new(0, 1.2, 0), golden and 2.6 or 2.2, golden)
	local candy = golden and EventConfig.GoldenPumpkinCandy
		or rng:NextInteger(EventConfig.PumpkinCandy.Min, EventConfig.PumpkinCandy.Max) + area.Bonus
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Collect Candy"
	prompt.ObjectText = golden and "Golden Pumpkin" or "Pumpkin"
	prompt.HoldDuration = 0.25
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = model.PrimaryPart
	local taken = false
	prompt.Triggered:Connect(function(player)
		if taken or not RateLimiter.Check(player, "Pumpkin", 0.25) then
			return
		end
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local body = model.PrimaryPart
		if not root or not body or (root.Position - body.Position).Magnitude > 14 then
			return
		end
		taken = true
		EventService:AddCandy(player, candy, true)
		Services.PlayerDataService:Notify(player, "+" .. candy .. " Candy!", golden and "warning" or "success")
		model:Destroy()
	end)
	model.Destroying:Connect(function()
		pumpkinCount -= 1
	end)
	pumpkinCount += 1
	model.Parent = pumpkinFolder
	-- Pumpkins rot after a while so they keep moving around
	task.delay(180, function()
		if model.Parent then
			model:Destroy()
		end
	end)
end

-- Lifecycle ------------------------------------------------------------------------------------------------
function EventService:Init(services)
	Services = services
end

function EventService:Start()
	Remotes.Function("BuyEventItem").OnServerInvoke = function(player, itemId)
		if not RateLimiter.Check(player, "EventShop", 0.3) then
			return { ok = false, msg = "Slow down!" }
		end
		local result = self:BuyItem(player, itemId)
		Services.PlayerDataService:MarkDirty(player)
		return result
	end

	Workspace:SetAttribute("EventActive", self:IsActive())
	Workspace:SetAttribute("EventName", EventConfig.Name)
	Workspace:SetAttribute("EventEndsAt", EventConfig.EndsAt)
	if not self:IsActive() then
		return
	end

	pumpkinFolder = Instance.new("Folder")
	pumpkinFolder.Name = "CandyPumpkins"
	pumpkinFolder.Parent = Workspace

	applyLighting()
	task.spawn(decorate)

	task.spawn(function()
		local areas = spawnAreas()
		while self:IsActive() do
			if pumpkinCount < EventConfig.MaxPumpkins then
				spawnPumpkin(areas)
			end
			task.wait(EventConfig.PumpkinRespawnSeconds)
		end
		Workspace:SetAttribute("EventActive", false)
		Remotes.Event("Announce"):FireAllClients("The " .. EventConfig.Name .. " has ended. See you next year!", Color3.fromRGB(255, 140, 40))
	end)
end

return EventService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">GuardianService</string>
            <string name="Source"><![CDATA[--[[
	GuardianService
	Stealth-heist guardian AI. One loop drives every guardian.

	Guardians don't just chase whoever is closest. They have to SEE you:
	  * Vision cone (~150° in front) + line of sight: rocks, ruins and walls hide you
	  * Hearing: anyone very close is noticed from any direction (smaller while sneaking)
	  * Sight range grows with the rarity of the soul you carry (rare souls glow brighter),
	    shrinks while you sneak, and is shorter at night (but guardians move faster)
	  * Break line of sight for 2.5s and they lose you ("?") and walk back
	  * A guardian that spots you ("!") alerts other guardians nearby (backup)
	States: Patrol -> Chase -> Search ("?") -> Return
	Catch: within CatchRadius -> soul knocked loose (unless protected by Halo Ward) + knockback.
	Abilities per biome: SlowPulse (Frost/Crypt/Celestial), Blink (Storm/Void/Abyssal).
	Companion abilities can freeze guardians (FreezeNear) or hide players from them.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local BiomeConfig = require(Shared.Config.BiomeConfig)
local PetConfig = require(Shared.Config.PetConfig)
local AbilityConfig = require(Shared.Config.AbilityConfig)
local ModelFactory = require(script.Parent.Parent.World.ModelFactory)

local GuardianService = {}

local TICK = 0.15
local LEASH_PADDING = 25
local CATCH_COOLDOWN = 1.5

type Guardian = {
	Model: Model,
	Humanoid: Humanoid,
	Root: BasePart,
	Biome: any, -- BiomeRuntime
	Config: any,
	Home: Vector3,
	State: "Patrol" | "Chase" | "Search" | "Return",
	Target: Player?,
	LastSeenAt: number,
	LastSeenPosition: Vector3?,
	FrozenUntil: number,
	Info: Instance?,
	NextPatrolAt: number,
	NextCatchAt: number,
	NextAbilityAt: number,
}

local Services: any
local guardians: { Guardian } = {}
local rng = Random.new()

local function getRoot(player: Player): BasePart?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function spawnGuardian(runtime: any, index: number): Guardian?
	local config = runtime.Config.Guardian
	local model = ModelFactory.MakeGuardian(runtime.Id)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not humanoid or not root then
		warn("[GuardianService] Guardian model for " .. runtime.Id .. " needs a Humanoid and HumanoidRootPart")
		return nil
	end
	local spawnPart = runtime.GuardianSpawns[((index - 1) % math.max(#runtime.GuardianSpawns, 1)) + 1]
	local home = spawnPart and spawnPart.Position or runtime.Zone.Position
	model:PivotTo(CFrame.new(home + Vector3.new(0, 4, 0)))
	model.Parent = runtime.Model
	root:SetNetworkOwner(nil) -- server-simulated: exploiters can't fling/freeze guardians

	return {
		Model = model,
		Humanoid = humanoid,
		Root = root,
		Biome = runtime,
		Config = config,
		Home = home,
		State = "Patrol",
		Target = nil,
		LastSeenAt = 0,
		LastSeenPosition = nil,
		FrozenUntil = 0,
		Info = model:FindFirstChild("Info", true),
		NextPatrolAt = 0,
		NextCatchAt = 0,
		NextAbilityAt = os.clock() + rng:NextNumber(2, 5),
	}
end

local Stealth = AbilityConfig.Stealth

-- Line of sight from the guardian's eyes to the player. Non-solid parts (orbs, zones, effects) don't block.
local function hasLineOfSight(g: Guardian, player: Player, root: BasePart): boolean
	local origin = g.Root.Position + Vector3.new(0, 2 * (g.Config.Scale or 1), 0)
	local exclude: { Instance } = { g.Model }
	if player.Character then
		table.insert(exclude, player.Character)
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	for _ = 1, 4 do
		params.FilterDescendantsInstances = exclude
		local result = Workspace:Raycast(origin, root.Position - origin, params)
		if not result then
			return true
		end
		if result.Instance.CanCollide and result.Instance.Transparency < 0.9 then
			return false -- blocked by something solid
		end
		table.insert(exclude, result.Instance)
	end
	return true
end

-- Can this guardian currently perceive this (soul-carrying) player?
local function canPerceive(g: Guardian, player: Player, root: BasePart): boolean
	if Services.StealService:IsHiddenFromGuardians(player) then
		return false
	end
	local offset = root.Position - g.Root.Position
	local distance = offset.Magnitude
	local sneaking = player:GetAttribute("Sneaking") == true
	local hearing = sneaking and Stealth.SneakHearingRadius or Stealth.HearingRadius
	if distance <= hearing then
		return true
	end
	local carried = Services.StealService:GetCarried(player)
	local glow = 1 + (carried and PetConfig.GetRarity(carried.Orb.Rarity).Order or 0) * Stealth.GlowPerRarity
	local sight = g.Config.AggroRadius * glow
	if sneaking then
		sight *= Stealth.SneakSightMult
	end
	if Services.DayNightService:IsNight() then
		sight *= Stealth.NightSightMult
	end
	if distance > sight then
		return false
	end
	local look = g.Root.CFrame.LookVector
	local flat = Vector3.new(offset.X, 0, offset.Z)
	if flat.Magnitude > 0.1 and Vector3.new(look.X, 0, look.Z).Unit:Dot(flat.Unit) < Stealth.ViewDot then
		return false -- outside the vision cone
	end
	return hasLineOfSight(g, player, root)
end

local function setIndicator(g: Guardian, mark: string?)
	local text = g.Config.Name
	if mark then
		text = mark .. " " .. g.Config.Name .. " " .. mark
	end
	ModelFactory.SetLine(g.Info, 1, text, mark == "!" and Color3.fromRGB(255, 40, 40) or (mark and Color3.fromRGB(255, 220, 80) or Color3.fromRGB(255, 80, 80)))
end

local function isValidTarget(g: Guardian, player: Player, root: BasePart?): boolean
	return root ~= nil
		and Services.StealService:IsCarrying(player)
		and Services.BiomeService:IsInZone(g.Biome, root.Position, LEASH_PADDING)
end

-- Picks a newly-spotted carrier (closest one this guardian can perceive).
local function findTarget(g: Guardian): (Player?, BasePart?)
	local bestPlayer, bestRoot, bestDistance = nil, nil, math.huge
	for _, player in ipairs(Players:GetPlayers()) do
		local root = getRoot(player)
		if root and isValidTarget(g, player, root) and canPerceive(g, player, root) then
			local distance = (root.Position - g.Root.Position).Magnitude
			if distance < bestDistance then
				bestPlayer, bestRoot, bestDistance = player, root, distance
			end
		end
	end
	return bestPlayer, bestRoot
end

local function startChase(g: Guardian, player: Player, root: BasePart, alertOthers: boolean)
	local wasChasing = g.State == "Chase" and g.Target == player
	g.State = "Chase"
	g.Target = player
	g.LastSeenAt = os.clock()
	g.LastSeenPosition = root.Position
	setIndicator(g, "!")
	if wasChasing then
		return
	end
	if alertOthers then
		Services.PlayerDataService:Notify(player, g.Config.Name .. " spotted you! RUN or break line of sight!", "error")
		for _, other in ipairs(guardians) do
			if other ~= g and other.Biome == g.Biome and other.State ~= "Chase" and os.clock() >= other.FrozenUntil
				and (other.Root.Position - g.Root.Position).Magnitude <= Stealth.BackupRadius then
				startChase(other, player, root, false)
			end
		end
	end
end

-- Companion ability hook: freezes every guardian within radius. Returns how many were frozen.
function GuardianService:FreezeNear(position: Vector3, radius: number, seconds: number): number
	local count = 0
	for _, g in ipairs(guardians) do
		if (g.Root.Position - position).Magnitude <= radius then
			g.FrozenUntil = os.clock() + seconds
			g.State = "Return"
			g.Target = nil
			setIndicator(g, "*")
			count += 1
		end
	end
	return count
end

local function pulseEffect(position: Vector3, radius: number, color: Color3)
	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Cylinder
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.Material = Enum.Material.Neon
	ring.Color = color
	ring.Transparency = 0.5
	ring.Size = Vector3.new(0.4, radius * 2, radius * 2)
	ring.CFrame = CFrame.new(position - Vector3.new(0, 2, 0)) * CFrame.Angles(0, 0, math.rad(90))
	ring.Parent = workspace
	game:GetService("Debris"):AddItem(ring, 0.4)
end

local function useAbility(g: Guardian, targetRoot: BasePart, distance: number)
	local ability = g.Config.Ability
	if not ability or os.clock() < g.NextAbilityAt then
		return
	end
	if ability.Type == "SlowPulse" and distance <= (ability.Radius or 15) then
		g.NextAbilityAt = os.clock() + ability.Cooldown
		pulseEffect(g.Root.Position, ability.Radius or 15, g.Config.Color)
		for _, player in ipairs(Players:GetPlayers()) do
			local root = getRoot(player)
			if root and (root.Position - g.Root.Position).Magnitude <= (ability.Radius or 15) then
				Services.StealService:ApplySlow(player, ability.SlowFactor or 0.6, ability.Duration or 1.5)
			end
		end
	elseif ability.Type == "Blink" and distance >= (ability.MinDistance or 20) then
		g.NextAbilityAt = os.clock() + ability.Cooldown
		local toGuardian = g.Root.Position - targetRoot.Position
		toGuardian = Vector3.new(toGuardian.X, 0, toGuardian.Z)
		if toGuardian.Magnitude > 0.1 then
			local destination = targetRoot.Position + toGuardian.Unit * (ability.BehindDistance or 9)
			pulseEffect(g.Root.Position, 4, g.Config.Color)
			g.Model:PivotTo(CFrame.lookAt(destination, targetRoot.Position))
			pulseEffect(destination, 4, g.Config.Color)
		end
	end
end

local function tick(g: Guardian)
	if g.Root.Position.Y < -50 then -- fell off the map
		g.Model:PivotTo(CFrame.new(g.Home + Vector3.new(0, 4, 0)))
	end
	local now = os.clock()

	-- Frozen by a Frost Nova / Reaper's Rend
	if now < g.FrozenUntil then
		g.Humanoid.WalkSpeed = 0
		g.Humanoid:MoveTo(g.Root.Position)
		return
	end
	g.Humanoid.WalkSpeed = g.Config.Speed * Services.DayNightService:GetGuardianSpeedMult()

	-- Keep chasing the current target while we can see them (or saw them very recently)
	if g.State == "Chase" or g.State == "Search" then
		local target = g.Target
		local root = target and getRoot(target)
		if target and root and isValidTarget(g, target, root)
			and (root.Position - g.Root.Position).Magnitude <= g.Config.AggroRadius * Stealth.ChaseRangeMult then
			if canPerceive(g, target, root) then
				startChase(g, target, root, false)
			elseif now - g.LastSeenAt > Stealth.LoseTrackSeconds then
				target = nil -- lost them
			else
				g.State = "Search"
				setIndicator(g, "?")
			end
		else
			target = nil
		end

		if target and root then
			local distance = (root.Position - g.Root.Position).Magnitude
			if g.State == "Chase" and distance <= g.Config.CatchRadius and now >= g.NextCatchAt then
				g.NextCatchAt = now + CATCH_COOLDOWN
				if Services.StealService:TryKnockLoose(target, g.Config.Name .. " caught you! Your soul dropped!") then
					Services.StealService:Knockback(target, g.Root.Position, 60)
					Services.StealService:ApplySlow(target, 0.5, 1)
				end
				return
			end
			if g.State == "Chase" then
				useAbility(g, root, distance)
				local lead = root.AssemblyLinearVelocity * 0.3
				g.Humanoid:MoveTo(root.Position + Vector3.new(lead.X, 0, lead.Z))
			elseif g.LastSeenPosition then
				g.Humanoid:MoveTo(g.LastSeenPosition) -- search where we last saw them
			end
			return
		end
		g.State = "Return"
		g.Target = nil
		setIndicator(g, "?")
	end

	-- Look for new intruders
	local spotted, spottedRoot = findTarget(g)
	if spotted and spottedRoot then
		startChase(g, spotted, spottedRoot, true)
		return
	end

	if g.State == "Return" then
		if (g.Root.Position - g.Home).Magnitude < 8 then
			g.State = "Patrol"
			setIndicator(g, nil)
		else
			g.Humanoid:MoveTo(g.Home)
		end
		return
	end

	-- Patrol: wander near home (the vision cone follows the walking direction)
	if now >= g.NextPatrolAt then
		g.NextPatrolAt = now + rng:NextNumber(3, 7)
		local offset = Vector3.new(rng:NextNumber(-30, 30), 0, rng:NextNumber(-30, 30))
		local point = g.Home + offset
		if Services.BiomeService:IsInZone(g.Biome, point) then
			g.Humanoid:MoveTo(point)
		end
	end
end

function GuardianService:Init(services)
	Services = services
end

function GuardianService:Start()
	for _, runtime in ipairs(Services.BiomeService:GetRuntimes()) do
		local config = BiomeConfig.Get(runtime.Id).Guardian
		for i = 1, config.Count do
			local g = spawnGuardian(runtime, i)
			if g then
				table.insert(guardians, g)
			end
		end
	end

	task.spawn(function()
		while true do
			task.wait(TICK)
			for _, g in ipairs(guardians) do
				local ok, err = pcall(tick, g)
				if not ok then
					warn("[GuardianService] tick error:", err)
				end
			end
		end
	end)
end

return GuardianService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[--[[
	LeaderboardService
	Global top-10 boards (OrderedDataStore) for Lifetime Essence, Steals and Rebirths.
	Boards are built in the hub automatically, or use your own: Workspace.Leaderboards.<Essence|Steals|Rebirths>
	(a Part; the board UI is put on its Front face).

	OrderedDataStores only hold integers < 2^63, so Essence is stored as log10(x) * 10,000 and decoded.
	Writes every 2 minutes per player, reads every 2 minutes. Fails quietly in Studio without API access.
]]

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Util.Format)

local LeaderboardService = {}

local Services: any
local UPDATE_INTERVAL = 120
local TOP = 10

local BOARDS = {
	{
		Key = "Essence", Title = "Richest Soul Thieves", Store = "LB_Essence_v1",
		Encode = function(data) return math.floor(math.log10(data.Stats.TotalEssence + 1) * 10_000) end,
		Decode = function(value) return Format.Number(10 ^ (value / 10_000) - 1) end,
		Color = Color3.fromRGB(120, 255, 200),
	},
	{
		Key = "Steals", Title = "Most Souls Stolen", Store = "LB_Steals_v1",
		Encode = function(data) return data.Stats.Steals end,
		Decode = function(value) return Format.Number(value) end,
		Color = Color3.fromRGB(255, 140, 60),
	},
	{
		Key = "Rebirths", Title = "Most Rebirths", Store = "LB_Rebirths_v1",
		Encode = function(data) return data.Rebirths end,
		Decode = function(value) return tostring(value) end,
		Color = Color3.fromRGB(230, 120, 255),
	},
}

local nameCache: { [number]: string } = {}

local function getName(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(Players.GetNameFromUserIdAsync, Players, userId)
	nameCache[userId] = ok and name or ("Player" .. userId)
	return nameCache[userId]
end

local function buildBoardPart(board, index: number, folder: Instance): BasePart
	local part = Instance.new("Part")
	part.Name = board.Key
	part.Anchored = true
	part.Size = Vector3.new(16, 20, 1)
	part.Color = Color3.fromRGB(30, 20, 45)
	part.Material = Enum.Material.SmoothPlastic
	-- In the generated hub: three boards between the bases and the first biome, facing the bases.
	part.CFrame = CFrame.new((index - 2) * 22, 11, 70)
	part.Parent = folder
	return part
end

local function buildGui(board, part: BasePart)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Board"
	gui.Face = Enum.NormalId.Front
	gui.CanvasSize = Vector2.new(400, 500)
	gui.LightInfluence = 0
	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.Size = UDim2.new(1, 0, 0, 60)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.FredokaOne
	title.TextScaled = true
	title.TextColor3 = board.Color
	title.Text = board.Title
	title.Parent = gui
	for rank = 1, TOP do
		local row = Instance.new("TextLabel")
		row.Name = "Row" .. rank
		row.Position = UDim2.new(0, 10, 0, 60 + (rank - 1) * 43)
		row.Size = UDim2.new(1, -20, 0, 40)
		row.BackgroundTransparency = 1
		row.Font = Enum.Font.FredokaOne
		row.TextScaled = true
		row.TextXAlignment = Enum.TextXAlignment.Left
		row.TextColor3 = rank <= 3 and Color3.fromRGB(255, 215, 80) or Color3.new(1, 1, 1)
		row.Text = rank .. ". ..."
		row.Parent = gui
	end
	gui.Parent = part
	return gui
end

function LeaderboardService:Init(services)
	Services = services
end

function LeaderboardService:Start()
	local folder = Workspace:FindFirstChild("Leaderboards")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Leaderboards"
		folder.Parent = Workspace
	end

	local runtimes = {}
	for index, board in ipairs(BOARDS) do
		local part = folder:FindFirstChild(board.Key)
		if not (part and part:IsA("BasePart")) then
			part = buildBoardPart(board, index, folder)
		end
		local ok, store = pcall(DataStoreService.GetOrderedDataStore, DataStoreService, board.Store)
		table.insert(runtimes, { Board = board, Gui = buildGui(board, part :: BasePart), Store = ok and store or nil })
	end

	task.spawn(function()
		task.wait(10)
		while true do
			for _, runtime in ipairs(runtimes) do
				local store = runtime.Store
				if store then
					-- Write everyone currently in the server
					for player, data in pairs(Services.PlayerDataService:GetAllLoaded()) do
						local value = runtime.Board.Encode(data)
						if value and value > 0 then
							pcall(store.SetAsync, store, tostring(player.UserId), value)
						end
					end
					-- Read top 10
					local ok, pages = pcall(store.GetSortedAsync, store, false, TOP)
					if ok and pages then
						local entries = pages:GetCurrentPage()
						for rank = 1, TOP do
							local label = runtime.Gui:FindFirstChild("Row" .. rank) :: TextLabel
							local entry = entries[rank]
							if entry then
								label.Text = string.format("%d. %s - %s", rank, getName(tonumber(entry.key) or 0), runtime.Board.Decode(entry.value))
							else
								label.Text = rank .. ". -"
							end
						end
					else
						(runtime.Gui:FindFirstChild("Row1") :: TextLabel).Text = "Leaderboard offline (Studio?)"
					end
				end
			end
			task.wait(UPDATE_INTERVAL)
		end
	end)
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">MonetizationService</string>
            <string name="Source"><![CDATA[--[[
	MonetizationService
	Game Pass ownership + Developer Product receipts.

	ProcessReceipt follows Roblox's required pattern:
	  1. Player must be in THIS server with data loaded, otherwise NotProcessedYet (Roblox retries later).
	  2. PurchaseId already in data.ProcessedReceipts -> PurchaseGranted (idempotent, never double-grant).
	  3. Grant, record the PurchaseId, then SAVE. Only return PurchaseGranted if the save succeeded.
	     If the server crashes before saving, Roblox re-sends the receipt and the grant happens again,
	     which is correct because the old grant was never persisted.
	Products whose effect can't apply right now (e.g. Instant Hatch with nothing incubating) give
	Essence compensation instead of failing, so a paid purchase is never wasted.
]]

local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local EconomyConfig = require(Shared.Config.EconomyConfig)
local MonetizationConfig = require(Shared.Config.MonetizationConfig)
local Format = require(Shared.Util.Format)
local Remotes = require(Shared.Remotes)

local MonetizationService = {}

local Services: any
local owned: { [Player]: { [string]: boolean } } = {}
local passesLoaded: { [Player]: boolean } = {}
local Effects = MonetizationConfig.Effects
local MAX_RECEIPT_HISTORY = 100

-- Game Passes ---------------------------------------------------------------------------------------
function MonetizationService:HasPass(player: Player, key: string): boolean
	local map = owned[player]
	return map ~= nil and map[key] == true
end

function MonetizationService:GetOwnedPasses(player: Player): { [string]: boolean }
	return table.clone(owned[player] or {})
end

function MonetizationService:WaitForPasses(player: Player, timeout: number?)
	local deadline = os.clock() + (timeout or 10)
	while player.Parent and not passesLoaded[player] and os.clock() < deadline do
		task.wait(0.1)
	end
end

-- Applies the immediate side-effects of owning a pass (safe to call repeatedly).
local function applyPass(player: Player, key: string)
	if not Services.PlayerDataService:IsLoaded(player) then
		return
	end
	if key == "ExtraPedestals" or key == "VIP" then
		Services.PetService:RenderBase(player)
	elseif key == "PhantomSteps" then
		Services.StealService:RefreshWalkSpeed(player)
	elseif key == "ReaperScythe" then
		Services.ToolService:GiveTools(player)
	end
	if key == "VIP" then
		player:SetAttribute("VIP", true)
	end
	Services.EconomyService:Recalculate(player)
	Services.PlayerDataService:MarkDirty(player)
end

local function applyAllPasses(player: Player)
	for key, isOwned in pairs(owned[player] or {}) do
		if isOwned then
			applyPass(player, key)
		end
	end
end

local function loadPasses(player: Player)
	local map = {}
	owned[player] = map
	for key, info in pairs(MonetizationConfig.GamePasses) do
		if GameConfig.StudioGrantAllPasses and RunService:IsStudio() then
			map[key] = true
		elseif info.Id ~= 0 then
			for _ = 1, 3 do
				local ok, result = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, info.Id)
				if ok then
					map[key] = result
					break
				end
				task.wait(1)
			end
		end
	end
	passesLoaded[player] = true
	if Services.PlayerDataService:IsLoaded(player) then
		applyAllPasses(player)
	end
end

-- Developer products ---------------------------------------------------------------------------------------
local function compensate(player: Player, reason: string)
	local amount = math.max(1_000, Services.EconomyService:GetIncome(player) * 600)
	Services.EconomyService:AddEssence(player, amount)
	Services.PlayerDataService:Notify(player, reason .. " You received " .. Format.Number(amount) .. " Essence instead.", "info")
end

local function grantEssencePack(packKey: string)
	return function(player: Player)
		local pack = EconomyConfig.EssencePacks[packKey]
		local amount = math.max(pack.Floor, math.floor(Services.EconomyService:GetIncome(player) * pack.Seconds))
		Services.EconomyService:AddEssence(player, amount)
		Services.PlayerDataService:Notify(player, "+" .. Format.Number(amount) .. " Essence!", "success")
		return true
	end
end

local function grantBoost(kind: string, label: string)
	return function(player: Player)
		Services.EconomyService:AddBoost(player, kind, Effects.BoostSeconds)
		Services.PlayerDataService:Notify(player, label .. " active for 30 minutes!", "success")
		return true
	end
end

local function grantOrb(rarity: string)
	return function(player: Player)
		local biome = Services.PetService:GetBestBiome(player)
		Services.PetService:GiveOrb(player, { Rarity = rarity, Biome = biome })
		Services.PlayerDataService:Notify(player, "A " .. rarity .. " Soul is incubating in your base!", "success")
		return true
	end
end

local function upgradeHandler(grant: (Player) -> boolean, successMsg: string, maxedMsg: string)
	return function(player: Player)
		if grant(player) then
			Services.PlayerDataService:Notify(player, successMsg, "success")
		else
			compensate(player, maxedMsg)
		end
		return true
	end
end

local ProductHandlers: { [string]: (Player, any) -> boolean } = {
	StarterPack = function(player, data)
		if data.StarterPackBought then
			compensate(player, "Starter Pack already claimed.")
			return true
		end
		data.StarterPackBought = true
		Services.PetService:GiveOrb(player, { Rarity = "Epic", Biome = Services.PetService:GetBestBiome(player) })
		Services.EconomyService:AddEssence(player, Effects.StarterPackEssence)
		Services.EconomyService:AddBoost(player, "Essence2x", Effects.BoostSeconds)
		Services.PlayerDataService:Notify(player, "Starter Pack claimed! Epic Soul + Essence + 2x boost!", "success")
		return true
	end,
	InstantHatchOne = function(player)
		if not Services.PetService:InstantHatch(player, "One") then
			compensate(player, "Nothing was incubating.")
		end
		return true
	end,
	InstantHatchAll = function(player)
		if not Services.PetService:InstantHatch(player, "All") then
			compensate(player, "Nothing was incubating.")
		end
		return true
	end,
	StealBack = function(player, data)
		local robbed = data.LastRobbed
		if robbed and os.time() - robbed.Time <= Effects.StealBackWindow then
			data.LastRobbed = nil
			Services.PetService:GiveOrb(player, { Rarity = robbed.Rarity, Biome = robbed.Biome })
			Services.PlayerDataService:Notify(player, "Soul Echo! Your " .. robbed.Rarity .. " Soul is back!", "success")
		else
			compensate(player, "No recent stolen soul to echo.")
		end
		return true
	end,
	EssenceSmall = grantEssencePack("EssenceSmall"),
	EssenceMedium = grantEssencePack("EssenceMedium"),
	EssenceLarge = grantEssencePack("EssenceLarge"),
	EssenceHuge = grantEssencePack("EssenceHuge"),
	Essence2x30 = grantBoost("Essence2x", "2x Essence"),
	Luck2x30 = grantBoost("Luck2x", "2x Luck"),
	Luck5x30 = grantBoost("Luck5x", "5x Luck"),
	BaseShield10 = function(player, data)
		data.ShieldUntil = math.max(os.time(), data.ShieldUntil or 0) + Effects.ShieldSeconds
		player:SetAttribute("ShieldUntil", data.ShieldUntil)
		Services.PlayerDataService:Notify(player, "Soul Shield up for 10 minutes!", "success")
		return true
	end,
	RebirthSkip = function(player)
		local ok = Services.RebirthService:DoRebirth(player, true)
		if not ok then
			compensate(player, "Rebirth couldn't run.")
		end
		return true
	end,
	LegendaryOrb = grantOrb("Legendary"),
	MythicOrb = grantOrb("Mythic"),
	CandySmall = function(player)
		Services.EventService:AddCandy(player, Effects.CandySmall, false)
		Services.PlayerDataService:Notify(player, "+" .. Effects.CandySmall .. " Candy!", "success")
		return true
	end,
	CandyLarge = function(player)
		Services.EventService:AddCandy(player, Effects.CandyLarge, false)
		Services.PlayerDataService:Notify(player, "+" .. Effects.CandyLarge .. " Candy!", "success")
		return true
	end,
	-- Robux upgrades: if already maxed, compensate with Essence instead of wasting the purchase.
	NextBiome = upgradeHandler(function(player) return Services.UpgradeService:GrantNextBiome(player) end, "Next biome unlocked!", "You've unlocked every biome you can."),
	SpeedPlus10 = upgradeHandler(function(player) return Services.UpgradeService:GrantSpeed(player, 10) end, "+10 Speed!", "Your Speed is already maxed."),
	SpeedPlus50 = upgradeHandler(function(player) return Services.UpgradeService:GrantSpeed(player, 50) end, "+50 Speed!", "Your Speed is already maxed."),
	TreadmillNext = upgradeHandler(function(player) return Services.UpgradeService:GrantTreadmill(player) end, "Treadmill upgraded!", "Treadmill is maxed for now."),
	HarnessMax = upgradeHandler(function(player) return Services.UpgradeService:GrantHarnessMax(player) end, "Soul Harness maxed!", "Soul Harness is already maxed."),
	PedestalPlus1 = upgradeHandler(function(player) return Services.UpgradeService:GrantPedestal(player) end, "New pedestal unlocked!", "All pedestals are already unlocked."),
	ServerEclipse = function(player)
		Services.DayNightService:StartEclipse(Effects.EclipseSeconds, player.DisplayName)
		return true
	end,
}

local function processReceipt(receiptInfo): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local pds = Services.PlayerDataService
	local data = pds:WaitForData(player, 15)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local purchaseId = tostring(receiptInfo.PurchaseId)
	if table.find(data.ProcessedReceipts, purchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	local key = MonetizationConfig.FindProductKey(receiptInfo.ProductId)
	local handler = key and ProductHandlers[key]
	if not handler then
		warn("[MonetizationService] No handler for product", receiptInfo.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local ok, granted = pcall(handler, player, data)
	if not ok then
		warn("[MonetizationService] Handler error for", key, granted)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if not granted then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	table.insert(data.ProcessedReceipts, purchaseId)
	while #data.ProcessedReceipts > MAX_RECEIPT_HISTORY do
		table.remove(data.ProcessedReceipts, 1)
	end
	data.Stats.RobuxSpent += receiptInfo.CurrencySpent or 0
	pds:Replicate(player)
	pds:MarkDirty(player)

	if not pds:SaveAsync(player, false) then
		-- Data is still recorded in memory (no double grant this session); Roblox will retry
		-- and the in-memory PurchaseId check above will acknowledge it.
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

-- Lifecycle ----------------------------------------------------------------------------------------------------
function MonetizationService:Init(services)
	Services = services
	MarketplaceService.ProcessReceipt = processReceipt

	-- Pass effects need the profile; apply once both are ready.
	Services.PlayerDataService.ProfileLoaded:Connect(function(player)
		if passesLoaded[player] then
			applyAllPasses(player)
		end
	end)
end

function MonetizationService:Start()
	Players.PlayerAdded:Connect(loadPasses)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(loadPasses, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		owned[player] = nil
		passesLoaded[player] = nil
	end)

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		local key = MonetizationConfig.FindPassKey(passId)
		if not key then
			return
		end
		owned[player] = owned[player] or {}
		owned[player][key] = true
		applyPass(player, key)
		local info = MonetizationConfig.GamePasses[key]
		Services.PlayerDataService:Notify(player, "Thank you! " .. info.Name .. " unlocked!", "success")
		Remotes.Event("Announce"):FireAllClients(player.DisplayName .. " unlocked " .. info.Name .. "!", Color3.fromRGB(255, 215, 80))
	end)
end

return MonetizationService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">PetService</string>
            <string name="Source"><![CDATA[--[[
	PetService
	Pedestals, incubation (hatching), Spirit Pets, inventory and pedestal visuals.

	Pedestal states (data.Slots[tostring(i)]):
		nil                                  empty
		{ Type="Orb", Rarity, Biome, HatchEnd, HatchDuration }   incubating (STEALABLE by other players)
		{ Type="Pet", PetId }                hatched spirit generating Essence (safe)

	Hatching: when HatchEnd passes, the orb hatches using the OWNER's luck:
		1) Ascension roll: chance = min(50%, 3% × luck) to jump one rarity tier
		2) Mutation roll : rarest first, chance × luck × night/eclipse mutation luck
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local PetConfig = require(Shared.Config.PetConfig)
local BiomeConfig = require(Shared.Config.BiomeConfig)
local MonetizationConfig = require(Shared.Config.MonetizationConfig)
local Formulas = require(Shared.Formulas)
local Format = require(Shared.Util.Format)
local Remotes = require(Shared.Remotes)
local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)
local ModelFactory = require(script.Parent.Parent.World.ModelFactory)

local PetService = {}

local Services: any
local rng = Random.new()

-- Pedestal helpers -----------------------------------------------------------------------------
function PetService:GetActivePedestalCount(player: Player): number
	local data = Services.PlayerDataService:GetData(player)
	if not data then
		return 0
	end
	local monetization = Services.MonetizationService
	local count = data.Pedestals
	if monetization:HasPass(player, "ExtraPedestals") then
		count += MonetizationConfig.Effects.ExtraPedestals
	end
	if monetization:HasPass(player, "VIP") then
		count += MonetizationConfig.Effects.VIPPedestals
	end
	return math.min(count, GameConfig.PhysicalPedestalsPerBase)
end

function PetService:FindFreeSlot(player: Player): number?
	local data = Services.PlayerDataService:GetData(player)
	if not data then
		return nil
	end
	for i = 1, self:GetActivePedestalCount(player) do
		if data.Slots[tostring(i)] == nil then
			return i
		end
	end
	return nil
end

local function getPlacedPetIds(data: any): { [string]: number }
	local placed = {}
	for key, slot in pairs(data.Slots) do
		if slot.Type == "Pet" and slot.PetId then
			placed[slot.PetId] = tonumber(key) :: number
		end
	end
	return placed
end

function PetService:GetInventoryCount(player: Player): number
	local data = Services.PlayerDataService:GetData(player)
	if not data then
		return 0
	end
	local placed = getPlacedPetIds(data)
	local count = 0
	for id in pairs(data.Pets) do
		if not placed[id] then
			count += 1
		end
	end
	return count
end

-- Visuals --------------------------------------------------------------------------------------------
local function getPedestalPart(player: Player, index: number): BasePart?
	local base = Services.BaseService:GetBase(player)
	return base and base.Pedestals[index] or nil
end

local function clearPedestal(pedestal: BasePart)
	local existing = pedestal:FindFirstChild("Display")
	if existing then
		existing:Destroy()
	end
end

local function pedestalTop(pedestal: BasePart, height: number): CFrame
	local top = pedestal.Position + Vector3.new(0, pedestal.Size.Y / 2 + height, 0)
	-- Cylinders lie on their side, so use world-up placement regardless of pedestal rotation.
	if pedestal:IsA("Part") and pedestal.Shape == Enum.PartType.Cylinder then
		top = pedestal.Position + Vector3.new(0, pedestal.Size.X / 2 + height, 0)
	end
	return CFrame.new(top)
end

function PetService:RenderSlot(player: Player, index: number)
	local pedestal = getPedestalPart(player, index)
	local data = Services.PlayerDataService:GetData(player)
	if not pedestal or not data then
		return
	end
	clearPedestal(pedestal)

	local active = index <= self:GetActivePedestalCount(player)
	pedestal.Transparency = active and 0 or 0.85
	pedestal.CanCollide = active
	if not active then
		return
	end

	local slot = data.Slots[tostring(index)]
	if not slot then
		return
	end

	local model: Model
	if slot.Type == "Orb" then
		model = ModelFactory.MakeOrb(slot.Rarity, slot.Biome, slot.Mutation)
		model:PivotTo(pedestalTop(pedestal, 2.5))
		local info = model.PrimaryPart and model.PrimaryPart:FindFirstChild("Info")
		if info then
			ModelFactory.SetLine(info, 2, "Hatching: " .. Format.Time(slot.HatchEnd - os.time()))
		end
		-- Other players can steal incubating souls (owner's client hides this prompt locally).
		local rarity = PetConfig.GetRarity(slot.Rarity)
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "StealPrompt"
		prompt.ActionText = "Steal Soul"
		prompt.ObjectText = rarity.Id .. " Soul"
		prompt.HoldDuration = GameConfig.BaseStealHoldBase + rarity.PickupHold
		prompt.MaxActivationDistance = 10
		prompt.RequiresLineOfSight = false
		prompt:SetAttribute("OwnerUserId", player.UserId)
		prompt.Parent = model.PrimaryPart
		local ownerUserId = player.UserId
		prompt.Triggered:Connect(function(thief)
			Services.StealService:TryStealFromBase(thief, ownerUserId, index)
		end)
	elseif slot.Type == "Pet" then
		local pet = data.Pets[slot.PetId]
		if not pet then
			data.Slots[tostring(index)] = nil
			return
		end
		local income = Formulas.PetIncome(pet.Rarity, pet.Biome, pet.Mutation)
		model = ModelFactory.MakePet(pet.Species, pet.Rarity, pet.Mutation, "+" .. Format.Number(income) .. "/s")
		model:PivotTo(pedestalTop(pedestal, 2.2))
	else
		return
	end
	model.Name = "Display"
	model.Parent = pedestal
end

function PetService:RenderBase(player: Player)
	local base = Services.BaseService:GetBase(player)
	if not base then
		return
	end
	for i = 1, #base.Pedestals do
		self:RenderSlot(player, i)
	end
end

function PetService:ClearBase(base: any)
	for _, pedestal in ipairs(base.Pedestals) do
		clearPedestal(pedestal)
		pedestal.Transparency = 0.85
	end
end

-- Orbs ------------------------------------------------------------------------------------------------
function PetService:GetHatchDuration(player: Player, rarityId: string, biomeId: string): number
	local data = Services.PlayerDataService:GetData(player)
	local fast = Services.MonetizationService:HasPass(player, "FastHatch")
	return Formulas.HatchSeconds(rarityId, biomeId, fast, data and data.Perks.QuickIncubation or 0)
end

-- Places an orb on the first free pedestal. Returns the slot index or nil if full.
function PetService:PlaceOrb(player: Player, orb: { Rarity: string, Biome: string, Mutation: string? }): number?
	local data = Services.PlayerDataService:GetData(player)
	local index = self:FindFreeSlot(player)
	if not data or not index then
		return nil
	end
	local duration = self:GetHatchDuration(player, orb.Rarity, orb.Biome)
	data.Slots[tostring(index)] = {
		Type = "Orb",
		Rarity = orb.Rarity,
		Biome = orb.Biome,
		Mutation = orb.Mutation, -- pre-set mutation (event shop souls); nil = rolled at hatch
		HatchEnd = os.time() + duration,
		HatchDuration = duration,
	}
	self:RenderSlot(player, index)
	Services.PlayerDataService:MarkDirty(player)
	return index
end

-- Removes an incubating orb (used by stealing). Returns the orb data or nil.
function PetService:TakeOrb(player: Player, index: number): { Rarity: string, Biome: string, Mutation: string? }?
	local data = Services.PlayerDataService:GetData(player)
	local slot = data and data.Slots[tostring(index)]
	if not slot or slot.Type ~= "Orb" then
		return nil
	end
	data.Slots[tostring(index)] = nil
	self:RenderSlot(player, index)
	Services.PlayerDataService:MarkDirty(player)
	return { Rarity = slot.Rarity, Biome = slot.Biome, Mutation = slot.Mutation }
end

-- Gives an orb: placed now if a pedestal is free, otherwise queued (purchases/codes never get lost).
function PetService:GiveOrb(player: Player, orb: { Rarity: string, Biome: string, Mutation: string? }): boolean
	if self:PlaceOrb(player, orb) then
		return true
	end
	local data = Services.PlayerDataService:GetData(player)
	if not data then
		return false
	end
	table.insert(data.PendingOrbs, orb)
	Services.PlayerDataService:Notify(player, "Pedestals full - your soul is waiting. Free a pedestal to place it.", "warning")
	Services.PlayerDataService:MarkDirty(player)
	return true
end

-- Best biome the player can enter with current Speed.
function PetService:GetBestBiome(player: Player): string
	local data = Services.PlayerDataService:GetData(player)
	local best = BiomeConfig.Order[1]
	if data then
		for _, id in ipairs(BiomeConfig.Order) do
			if data.Speed >= BiomeConfig.Get(id).SpeedRequired then
				best = id
			end
		end
	end
	return best
end

-- Hatching ----------------------------------------------------------------------------------------------
local function rollMutation(luck: number): string
	local dayNight = Services.DayNightService
	local mutationLuck = luck * dayNight:GetMutationLuck()
	for _, id in ipairs(PetConfig.MutationOrder) do
		local mutation = PetConfig.Mutations[id]
		local allowed = (not mutation.NightOnly or dayNight:IsNight() or dayNight:IsEclipse())
			and (not mutation.EclipseOnly or dayNight:IsEclipse())
			and (not mutation.EventOnly or Services.EventService:IsActive())
		if allowed and rng:NextNumber() < math.min(mutation.Chance * mutationLuck, 0.5) then
			return id
		end
	end
	return "None"
end

function PetService:Hatch(player: Player, index: number)
	local data = Services.PlayerDataService:GetData(player)
	local slot = data and data.Slots[tostring(index)]
	if not slot or slot.Type ~= "Orb" then
		return
	end
	local luck = Services.EconomyService:GetLuck(player)
	local rarityId = slot.Rarity
	local ascended = false
	if rarityId ~= PetConfig.RarityOrder[#PetConfig.RarityOrder] then
		local chance = math.min(PetConfig.AscendBaseChance * luck, PetConfig.AscendMaxChance)
		if rng:NextNumber() < chance then
			rarityId = PetConfig.NextRarity(rarityId)
			ascended = true
		end
	end
	local mutation = if slot.Mutation and PetConfig.Mutations[slot.Mutation] then slot.Mutation else rollMutation(luck)
	local biome = BiomeConfig.Get(slot.Biome)

	local id = tostring(data.NextPetId)
	data.NextPetId += 1
	data.Pets[id] = {
		Id = id,
		Species = biome.Species[rarityId] or "Lost Soul",
		Rarity = rarityId,
		Biome = slot.Biome,
		Mutation = mutation,
		Locked = false,
		HatchedAt = os.time(),
	}
	data.Slots[tostring(index)] = { Type = "Pet", PetId = id }
	data.Stats.Hatched += 1
	local species = data.Pets[id].Species
	local discovered = not data.Index[species]
	if discovered then
		data.Index[species] = true -- Spirit Index: +1% Essence per species
	end
	Services.RewardService:Progress(player, "Hatch", 1)

	self:RenderSlot(player, index)
	Services.EconomyService:Recalculate(player)

	local pet = data.Pets[id]
	local income = Formulas.PetIncome(pet.Rarity, pet.Biome, pet.Mutation)
	Remotes.Event("HatchResult"):FireClient(player, {
		Species = pet.Species,
		Rarity = pet.Rarity,
		Mutation = pet.Mutation,
		Biome = pet.Biome,
		Income = income,
		Ascended = ascended,
		NewDiscovery = discovered,
	})
	if PetConfig.GetRarity(pet.Rarity).Order >= 6 or (mutation ~= "None" and PetConfig.GetMutation(mutation).Mult >= 15) then
		local label = (mutation ~= "None" and (mutation .. " ") or "") .. pet.Rarity .. " " .. pet.Species
		Remotes.Event("Announce"):FireAllClients(player.DisplayName .. " hatched a " .. label .. "!", PetConfig.GetRarity(pet.Rarity).Color)
	end
end

-- Instant hatch (developer products). mode "One" = the soul with the most time left, "All" = every soul.
function PetService:InstantHatch(player: Player, mode: string): boolean
	local data = Services.PlayerDataService:GetData(player)
	if not data then
		return false
	end
	local targets = {}
	for key, slot in pairs(data.Slots) do
		if slot.Type == "Orb" then
			table.insert(targets, { Index = tonumber(key) :: number, Remaining = slot.HatchEnd - os.time() })
		end
	end
	if #targets == 0 then
		return false
	end
	table.sort(targets, function(a, b)
		return a.Remaining > b.Remaining
	end)
	if mode == "One" then
		self:Hatch(player, targets[1].Index)
	else
		for _, t in ipairs(targets) do
			self:Hatch(player, t.Index)
		end
	end
	return true
end

-- Inventory actions (from the client) -------------------------------------------------------------------
local function petAction(player: Player, action: any, arg1: any, arg2: any)
	if not RateLimiter.Check(player, "PetAction", 0.15) then
		return { ok = false, msg = "Slow down!" }
	end
	local data = Services.PlayerDataService:GetData(player)
	if not data or type(action) ~= "string" then
		return { ok = false }
	end

	if action == "Store" then
		-- arg1 = pedestal index: move a hatched pet off its pedestal into inventory
		local index = tonumber(arg1)
		local slot = index and data.Slots[tostring(index)]
		if not slot or slot.Type ~= "Pet" then
			return { ok = false, msg = "No spirit on that pedestal." }
		end
		if PetService:GetInventoryCount(player) >= GameConfig.InventoryCap then
			return { ok = false, msg = "Inventory full! Sell some spirits." }
		end
		data.Slots[tostring(index)] = nil
		PetService:RenderSlot(player, index :: number)
		Services.EconomyService:Recalculate(player)
		return { ok = true }
	elseif action == "Place" then
		-- arg1 = petId: put an inventory pet on the first free pedestal
		local petId = tostring(arg1)
		if not data.Pets[petId] or getPlacedPetIds(data)[petId] then
			return { ok = false, msg = "Spirit not in inventory." }
		end
		local index = PetService:FindFreeSlot(player)
		if not index then
			return { ok = false, msg = "No free pedestal." }
		end
		data.Slots[tostring(index)] = { Type = "Pet", PetId = petId }
		PetService:RenderSlot(player, index)
		Services.EconomyService:Recalculate(player)
		return { ok = true }
	elseif action == "Sell" then
		-- arg1 = petId (must be in inventory and unlocked)
		local petId = tostring(arg1)
		local pet = data.Pets[petId]
		if not pet or getPlacedPetIds(data)[petId] then
			return { ok = false, msg = "Store the spirit before selling it." }
		end
		if pet.Locked then
			return { ok = false, msg = "Unlock the spirit first." }
		end
		if data.CompanionId == petId then
			return { ok = false, msg = "That's your Companion! Pick another one first." }
		end
		local value = math.floor(Formulas.PetIncome(pet.Rarity, pet.Biome, pet.Mutation) * PetConfig.SellSeconds)
		data.Pets[petId] = nil
		Services.EconomyService:AddEssence(player, value)
		Services.PlayerDataService:MarkDirty(player)
		return { ok = true, msg = "Sold for " .. Format.Number(value) .. " Essence" }
	elseif action == "Lock" then
		-- arg1 = petId, arg2 = boolean. Locked pets survive rebirth (up to vault size).
		local petId = tostring(arg1)
		local pet = data.Pets[petId]
		if not pet then
			return { ok = false }
		end
		local wantLocked = arg2 == true
		if wantLocked and not pet.Locked then
			local lockedCount = 0
			for _, p in pairs(data.Pets) do
				if p.Locked then
					lockedCount += 1
				end
			end
			local vault = Services.RebirthService:GetVaultSize(player)
			if lockedCount >= vault then
				return { ok = false, msg = string.format("Vault full (%d). Rebirth more or get Soul Vault+.", vault) }
			end
		end
		pet.Locked = wantLocked
		Services.PlayerDataService:MarkDirty(player)
		return { ok = true }
	end
	if action == "FuseRarity" then
		-- Soul Fusion: 3 inventory spirits of the same rarity -> 1 soul of the NEXT rarity.
		-- Uses the 3 lowest-income unlocked, non-companion spirits. Result comes from the best biome
		-- among the three, and has a 50% chance to inherit the best mutation among them.
		local rarityId = tostring(arg1)
		local rarity = PetConfig.Rarities[rarityId]
		if not rarity or rarity.Order >= #PetConfig.RarityOrder then
			return { ok = false, msg = "Can't fuse that rarity." }
		end
		local placed = getPlacedPetIds(data)
		local candidates = {}
		for id, pet in pairs(data.Pets) do
			if pet.Rarity == rarityId and not placed[id] and not pet.Locked and data.CompanionId ~= id then
				table.insert(candidates, pet)
			end
		end
		if #candidates < 3 then
			return { ok = false, msg = "Need 3 " .. rarityId .. " spirits in your inventory (not vaulted)." }
		end
		table.sort(candidates, function(a, b)
			return Formulas.PetIncome(a.Rarity, a.Biome, a.Mutation) < Formulas.PetIncome(b.Rarity, b.Biome, b.Mutation)
		end)
		local bestBiome, bestMutation = candidates[1].Biome, "None"
		for i = 1, 3 do
			local pet = candidates[i]
			if BiomeConfig.Get(pet.Biome).Order > BiomeConfig.Get(bestBiome).Order then
				bestBiome = pet.Biome
			end
			if PetConfig.GetMutation(pet.Mutation).Mult > PetConfig.GetMutation(bestMutation).Mult then
				bestMutation = pet.Mutation
			end
			data.Pets[pet.Id] = nil
		end
		local inherited = bestMutation ~= "None" and rng:NextNumber() < 0.5
		local nextRarity = PetConfig.NextRarity(rarityId)
		PetService:GiveOrb(player, { Rarity = nextRarity, Biome = bestBiome, Mutation = inherited and bestMutation or nil })
		data.Stats.Fusions = (data.Stats.Fusions or 0) + 1
		Services.PlayerDataService:MarkDirty(player)
		local extra = inherited and (" It kept the " .. bestMutation .. " mutation!") or ""
		return { ok = true, msg = string.format("Soul Fusion! A %s %s Soul is incubating.%s", nextRarity, BiomeConfig.Get(bestBiome).Name, extra) }
	end
	return { ok = false, msg = "Unknown action." }
end

-- Lifecycle -------------------------------------------------------------------------------------------------
function PetService:Init(services)
	Services = services
	Services.PlayerDataService.ProfileLoaded:Connect(function(player, data)
		-- Clean slots referencing deleted pets. (Orbs that finished while offline hatch on the next tick.)
		for key, slot in pairs(data.Slots) do
			if slot.Type == "Pet" and not data.Pets[slot.PetId] then
				data.Slots[key] = nil
			end
		end
	end)
end

function PetService:Start()
	Remotes.Function("PetAction").OnServerInvoke = petAction

	-- 1 Hz: hatch timers, countdown labels, pending orb placement
	task.spawn(function()
		while true do
			task.wait(1)
			local now = os.time()
			for player, data in pairs(Services.PlayerDataService:GetAllLoaded()) do
				if Services.BaseService:GetBase(player) then
					for key, slot in pairs(data.Slots) do
						if slot.Type == "Orb" then
							local index = tonumber(key) :: number
							if now >= slot.HatchEnd then
								self:Hatch(player, index)
							else
								local pedestal = getPedestalPart(player, index)
								local display = pedestal and pedestal:FindFirstChild("Display")
								local primary = display and (display :: Model).PrimaryPart
								if primary then
									ModelFactory.SetLine(primary:FindFirstChild("Info"), 2, "Hatching: " .. Format.Time(slot.HatchEnd - now))
								end
							end
						end
					end
					if #data.PendingOrbs > 0 and self:FindFreeSlot(player) then
						local orb = table.remove(data.PendingOrbs, 1)
						self:PlaceOrb(player, orb)
					end
				end
			end
		end
	end)
end

return PetService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">PlayerDataService</string>
            <string name="Source"><![CDATA[--[[
	PlayerDataService
	Loads, session-locks, autosaves and releases player profiles.

	Session locking: every record is stored as { Data = <profile>, Lock = { JobId, Time } }.
	  * On join we UpdateAsync and only claim the record if no OTHER live server holds the lock
	    (a lock older than SessionLockStaleSeconds is treated as a crashed server and taken over).
	  * Autosaves refresh the lock timestamp and REFUSE to write if another server stole the lock
	    (prevents item duplication through fast server-hopping).
	  * On leave / shutdown we save one last time and clear the lock.

	API
		:GetData(player) -> PlayerData?
		:IsLoaded(player) -> boolean
		:WaitForData(player, timeout?) -> PlayerData?
		:SaveAsync(player, release?) -> boolean
		:MarkDirty(player)            schedule a StateChanged push to the client (batched)
		:Notify(player, msg, kind?)
		.ProfileLoaded(player, data)  Signal
		.ProfileReleasing(player, data) Signal - fired right before the final save (sync work only)
]]

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local EconomyConfig = require(Shared.Config.EconomyConfig)
local Signal = require(Shared.Util.Signal)
local Format = require(Shared.Util.Format)
local Remotes = require(Shared.Remotes)

local PlayerDataService = {}
PlayerDataService.ProfileLoaded = Signal.new()
PlayerDataService.ProfileReleasing = Signal.new()

local DEFAULT_DATA = {
	Version = GameConfig.DataVersion,
	Essence = EconomyConfig.StartingEssence,
	Speed = EconomyConfig.StartingSpeed,
	CarryLevel = 0,
	TreadmillTier = 1,
	Pedestals = EconomyConfig.StartingPedestals,
	Rebirths = 0,
	RebirthTokens = 0,
	Perks = { SoulMagnet = 0, Attunement = 0, SwiftStart = 0, QuickIncubation = 0, TreadmillMemory = 0 },
	Pets = {},
	NextPetId = 1,
	Slots = {},
	PendingOrbs = {},
	Boosts = { Essence2x = 0, Luck2x = 0, Luck5x = 0 },
	RedeemedCodes = {},
	ProcessedReceipts = {},
	StarterPackBought = false,
	ShieldUntil = 0,
	LastRobbed = nil,
	LastOnline = 0,
	LastIncome = 0,
	Candy = 0, -- seasonal event currency (kept between events)
	Daily = { Streak = 0, LastClaimDay = 0 },
	Quests = { Day = 0, List = {}, BonusClaimed = false },
	Index = {}, -- [species] = true for every spirit ever hatched
	CompanionId = "", -- pet id of the spirit following you ("" = none)
	Stats = {
		TotalEssence = 0, Steals = 0, BaseSteals = 0, TimesRobbed = 0, Hatched = 0, PlayTime = 0, RobuxSpent = 0,
		CandyEarned = 0, Bonks = 0, DaysPlayed = 0, Fusions = 0,
	},
}

type Profile = {
	Player: Player,
	Key: string,
	Data: any,
	Released: boolean,
	LastSave: number,
}

local profiles: { [Player]: Profile } = {}
local releasingUserIds: { [number]: boolean } = {} -- final save in flight (same-server rejoin guard)
local dirty: { [Player]: boolean } = {}
local Services: any
local store: any

-- Utilities -------------------------------------------------------------------------
local function deepCopy(value: any): any
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in pairs(value) do
		copy[k] = deepCopy(v)
	end
	return copy
end

-- Fill in any keys added to DEFAULT_DATA since the profile was created (safe schema migration).
local function reconcile(target: any, template: any)
	for key, value in pairs(template) do
		if target[key] == nil then
			target[key] = deepCopy(value)
		elseif type(value) == "table" and type(target[key]) == "table" and next(value) ~= nil then
			reconcile(target[key], value)
		end
	end
end

local function migrate(data: any)
	-- Example for future versions:
	-- if data.Version < 2 then data.NewField = ...; data.Version = 2 end
	data.Version = GameConfig.DataVersion
end

-- In-memory DataStore used in Studio when API access is disabled.
local function createMockStore()
	local memory = {}
	return {
		UpdateAsync = function(_, key, transform)
			local result = transform(deepCopy(memory[key]))
			if result ~= nil then
				memory[key] = deepCopy(result)
			end
			return deepCopy(memory[key])
		end,
	}
end

local function getStore()
	local ok, realStore = pcall(function()
		return DataStoreService:GetDataStore(GameConfig.DataStoreName)
	end)
	if ok and realStore and RunService:IsStudio() and GameConfig.UseMockDataStoreInStudio then
		-- Probe API access; Studio throws if "Enable Studio Access to API Services" is off.
		local probeOk = pcall(function()
			realStore:GetAsync("__probe")
		end)
		if not probeOk then
			warn("[PlayerDataService] No DataStore access in Studio -> using in-memory mock store (data will not persist).")
			return createMockStore()
		end
	end
	if not ok then
		warn("[PlayerDataService] DataStore unavailable -> using mock store:", realStore)
		return createMockStore()
	end
	return realStore
end

-- Loading ------------------------------------------------------------------------------
local function loadProfileAsync(player: Player): any?
	local key = "Player_" .. player.UserId
	for attempt = 1, GameConfig.LoadRetryAttempts do
		local lockedByOther = false
		local ok, result = pcall(function()
			return store:UpdateAsync(key, function(stored)
				lockedByOther = false
				stored = stored or {}
				local lock = stored.Lock
				if lock and lock.JobId ~= game.JobId and os.time() - (lock.Time or 0) < GameConfig.SessionLockStaleSeconds then
					lockedByOther = true
					return nil -- cancel the write, someone else owns this profile
				end
				stored.Lock = { JobId = game.JobId, Time = os.time() }
				return stored
			end)
		end)

		if ok and not lockedByOther then
			local data = (result and result.Data) or deepCopy(DEFAULT_DATA)
			reconcile(data, DEFAULT_DATA)
			migrate(data)
			return data
		end
		if not ok then
			warn(string.format("[PlayerDataService] Load attempt %d failed for %s: %s", attempt, player.Name, tostring(result)))
		end
		task.wait(GameConfig.LoadRetryDelay)
	end
	return nil
end

-- Saving --------------------------------------------------------------------------------
local function saveProfileAsync(profile: Profile, release: boolean): boolean
	if profile.Released then
		return true
	end
	local lostLock = false
	local data = profile.Data
	data.LastOnline = os.time()
	local ok, err = pcall(function()
		store:UpdateAsync(profile.Key, function(stored)
			lostLock = false
			stored = stored or {}
			if stored.Lock and stored.Lock.JobId ~= game.JobId then
				lostLock = true
				return nil
			end
			stored.Data = data
			stored.Lock = if release then nil else { JobId = game.JobId, Time = os.time() }
			return stored
		end)
	end)
	if not ok then
		warn("[PlayerDataService] Save failed for", profile.Player.Name, err)
		return false
	end
	if lostLock then
		warn("[PlayerDataService] Session lock lost for", profile.Player.Name, "- kicking to protect data")
		profile.Released = true
		profiles[profile.Player] = nil
		profile.Player:Kick("Your data was opened in another server. Please rejoin.")
		return false
	end
	profile.LastSave = os.clock()
	if release then
		profile.Released = true
	end
	return true
end

-- Leaderstats ------------------------------------------------------------------------------
local function createLeaderstats(player: Player)
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	local essence = Instance.new("StringValue")
	essence.Name = "Essence"
	essence.Parent = folder
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = folder
	local steals = Instance.new("IntValue")
	steals.Name = "Steals"
	steals.Parent = folder
	folder.Parent = player
end

-- Mirrors frequently-changing numbers onto player attributes + leaderstats.
-- The client UI reads attributes (cheap), and the full snapshot only on structural change.
function PlayerDataService:Replicate(player: Player)
	local data = self:GetData(player)
	if not data then
		return
	end
	player:SetAttribute("Essence", data.Essence)
	player:SetAttribute("Speed", data.Speed)
	player:SetAttribute("CarryLevel", data.CarryLevel)
	player:SetAttribute("TreadmillTier", data.TreadmillTier)
	player:SetAttribute("Pedestals", data.Pedestals)
	player:SetAttribute("Rebirths", data.Rebirths)
	player:SetAttribute("RebirthTokens", data.RebirthTokens)
	player:SetAttribute("Candy", data.Candy)
	local stats = player:FindFirstChild("leaderstats")
	if stats then
		(stats :: any).Essence.Value = Format.Number(data.Essence);
		(stats :: any).Rebirths.Value = data.Rebirths;
		(stats :: any).Steals.Value = data.Stats.Steals
	end
end

-- Full UI snapshot ------------------------------------------------------------------------------
function PlayerDataService:BuildSnapshot(player: Player)
	local data = self:GetData(player)
	if not data then
		return nil
	end
	local monetization = Services.MonetizationService
	local petService = Services.PetService
	return {
		Essence = data.Essence,
		Speed = data.Speed,
		CarryLevel = data.CarryLevel,
		TreadmillTier = data.TreadmillTier,
		Pedestals = data.Pedestals,
		ActivePedestals = petService:GetActivePedestalCount(player),
		Rebirths = data.Rebirths,
		RebirthTokens = data.RebirthTokens,
		Perks = data.Perks,
		Pets = data.Pets,
		Slots = data.Slots,
		PendingOrbs = #data.PendingOrbs,
		Boosts = data.Boosts,
		Passes = monetization:GetOwnedPasses(player),
		StarterPackBought = data.StarterPackBought,
		VaultSize = Services.RebirthService:GetVaultSize(player),
		CanStealBack = data.LastRobbed ~= nil and os.time() - data.LastRobbed.Time < 600,
		Income = Services.EconomyService:GetIncome(player),
		Luck = Services.EconomyService:GetLuck(player),
		Stats = data.Stats,
		Candy = data.Candy,
		Index = data.Index,
		CompanionId = data.CompanionId,
		Rewards = Services.RewardService:GetSnapshot(player),
		EventActive = Services.EventService:IsActive(),
		ShieldUntil = data.ShieldUntil,
		ServerTime = os.time(),
	}
end

function PlayerDataService:MarkDirty(player: Player)
	dirty[player] = true
end

function PlayerDataService:Notify(player: Player, message: string, kind: string?)
	Remotes.Event("Notify"):FireClient(player, message, kind or "info")
end

-- Public API ------------------------------------------------------------------------------------
function PlayerDataService:GetData(player: Player): any?
	local profile = profiles[player]
	return profile and not profile.Released and profile.Data or nil
end

function PlayerDataService:IsLoaded(player: Player): boolean
	return self:GetData(player) ~= nil
end

function PlayerDataService:WaitForData(player: Player, timeout: number?): any?
	local deadline = os.clock() + (timeout or 30)
	while player.Parent and os.clock() < deadline do
		local data = self:GetData(player)
		if data then
			return data
		end
		task.wait(0.1)
	end
	return nil
end

function PlayerDataService:SaveAsync(player: Player, release: boolean?): boolean
	local profile = profiles[player]
	if not profile then
		return false
	end
	return saveProfileAsync(profile, release == true)
end

function PlayerDataService:GetAllLoaded(): { [Player]: any }
	local result = {}
	for player, profile in pairs(profiles) do
		if not profile.Released then
			result[player] = profile.Data
		end
	end
	return result
end

-- Lifecycle ----------------------------------------------------------------------------------------
local function onPlayerAdded(player: Player)
	createLeaderstats(player)
	-- If this player just left THIS server, wait for their final save before reading.
	local waitUntil = os.clock() + 30
	while releasingUserIds[player.UserId] and os.clock() < waitUntil do
		task.wait(0.2)
	end
	local data = loadProfileAsync(player)
	if not player.Parent then
		-- Left while loading: give the lock back immediately so they can join another server.
		if data then
			saveProfileAsync({ Player = player, Key = "Player_" .. player.UserId, Data = data, Released = false, LastSave = 0 }, true)
		end
		return
	end
	if not data then
		player:Kick("Your data is still saving from another server. Please rejoin in a minute.")
		return
	end
	profiles[player] = {
		Player = player,
		Key = "Player_" .. player.UserId,
		Data = data,
		Released = false,
		LastSave = os.clock(),
	}
	player:SetAttribute("DataLoaded", true)
	PlayerDataService:Replicate(player)
	PlayerDataService.ProfileLoaded:Fire(player, data)
	PlayerDataService:MarkDirty(player)
end

local function onPlayerRemoving(player: Player)
	local profile = profiles[player]
	dirty[player] = nil
	if not profile or profile.Released then
		return
	end
	-- Synchronous handlers (drop carried orb, clear base...) run first so the save is final.
	for _, handler in ipairs(PlayerDataService._releasingHandlers) do
		local ok, err = pcall(handler, player, profile.Data)
		if not ok then
			warn("[PlayerDataService] Releasing handler error:", err)
		end
	end
	PlayerDataService.ProfileReleasing:Fire(player, profile.Data)
	releasingUserIds[player.UserId] = true
	saveProfileAsync(profile, true)
	releasingUserIds[player.UserId] = nil
	profiles[player] = nil
end

-- Services that must mutate data synchronously before the final save register here.
PlayerDataService._releasingHandlers = {} :: { (Player, any) -> () }
function PlayerDataService:OnBeforeRelease(handler: (Player, any) -> ())
	table.insert(self._releasingHandlers, handler)
end

function PlayerDataService:Init(services)
	Services = services
	store = getStore()
end

function PlayerDataService:Start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, player)
	end

	-- Staggered autosave
	task.spawn(function()
		while true do
			task.wait(5)
			for _, profile in pairs(profiles) do
				if not profile.Released and os.clock() - profile.LastSave >= GameConfig.AutosaveInterval then
					profile.LastSave = os.clock() -- reserve the slot so a slow save isn't queued twice
					task.spawn(saveProfileAsync, profile, false)
				end
			end
		end
	end)

	-- Batched snapshot pushes (max 4/sec per player)
	task.spawn(function()
		local stateChanged = Remotes.Event("StateChanged")
		while true do
			task.wait(0.25)
			for player in pairs(dirty) do
				dirty[player] = nil
				if player.Parent and self:IsLoaded(player) then
					local ok, snapshot = pcall(self.BuildSnapshot, self, player)
					if ok and snapshot then
						stateChanged:FireClient(player, snapshot)
					elseif not ok then
						warn("[PlayerDataService] Snapshot error:", snapshot)
					end
				end
			end
		end
	end)

	Remotes.Function("GetState").OnServerInvoke = function(player)
		return self:BuildSnapshot(player)
	end

	game:BindToClose(function()
		local pending = 0
		for player, profile in pairs(profiles) do
			pending += 1
			task.spawn(function()
				for _, handler in ipairs(self._releasingHandlers) do
					pcall(handler, player, profile.Data)
				end
				saveProfileAsync(profile, true)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

return PlayerDataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">RebirthService</string>
            <string name="Source"><![CDATA[--[[
	RebirthService
	Rebirth = reset run progress for a permanent income multiplier + Rebirth Tokens.

	Cost(n)   = 10M × 3.2^n Essence          (n = rebirths so far)
	Mult      = 1 + 0.5 × rebirths            (applied to all income, forever)
	Tokens    = 1 + floor(rebirthsAfter / 3)  (spend on permanent perks)
	RESETS    : Essence, Speed, Soul Harness, Treadmill tier (unless Treadmill Memory), every pedestal,
	            all spirits EXCEPT locked ones up to Vault size
	KEEPS     : pedestal count, Rebirths, tokens, perks, locked spirits (vault), pending orbs, passes, codes
	Vault     = 1 + floor(rebirths / 2) (+3 with Soul Vault+)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local EconomyConfig = require(Shared.Config.EconomyConfig)
local Formulas = require(Shared.Formulas)
local Format = require(Shared.Util.Format)
local Remotes = require(Shared.Remotes)
local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)

local RebirthService = {}

local Services: any

function RebirthService:GetVaultSize(player: Player): number
	local data = Services.PlayerDataService:GetData(player)
	if not data then
		return 0
	end
	return Formulas.VaultSize(data.Rebirths, Services.MonetizationService:HasPass(player, "SoulVault"))
end

function RebirthService:DoRebirth(player: Player, free: boolean): (boolean, string)
	local data = Services.PlayerDataService:GetData(player)
	if not data then
		return false, "Data not loaded"
	end
	local cost = Formulas.RebirthCost(data.Rebirths)
	if not free then
		if data.Essence < cost then
			return false, "Need " .. Format.Number(cost) .. " Essence to rebirth"
		end
	end

	-- Anything carried is lost (prevents carrying value across the reset).
	Services.StealService:Clear(player)

	-- Keep locked spirits (best first) up to vault size.
	local vaultSize = self:GetVaultSize(player)
	local locked = {}
	for _, pet in pairs(data.Pets) do
		if pet.Locked then
			table.insert(locked, pet)
		end
	end
	table.sort(locked, function(a, b)
		return Formulas.PetIncome(a.Rarity, a.Biome, a.Mutation) > Formulas.PetIncome(b.Rarity, b.Biome, b.Mutation)
	end)
	local keptPets = {}
	for i = 1, math.min(vaultSize, #locked) do
		keptPets[locked[i].Id] = locked[i]
	end

	data.Pets = keptPets
	data.Slots = {}
	local slotIndex = 0
	for id in pairs(keptPets) do
		slotIndex += 1
		data.Slots[tostring(slotIndex)] = { Type = "Pet", PetId = id }
	end

	data.Rebirths += 1
	data.RebirthTokens += Formulas.RebirthTokens(data.Rebirths)
	data.Essence = EconomyConfig.StartingEssence
	data.Speed = EconomyConfig.StartingSpeed + (data.Perks.SwiftStart or 0) * EconomyConfig.Perks.SwiftStart.PerLevel
	data.CarryLevel = 0
	if (data.Perks.TreadmillMemory or 0) < 1 then
		data.TreadmillTier = 1
	end

	-- Kept pets may exceed active pedestals in odd cases; overflow simply stays in inventory.
	local active = Services.PetService:GetActivePedestalCount(player)
	for key in pairs(data.Slots) do
		if (tonumber(key) :: number) > active then
			data.Slots[key] = nil
		end
	end

	Services.PetService:RenderBase(player)
	Services.EconomyService:Recalculate(player)
	Services.CompanionService:Refresh(player) -- companion may not have survived the rebirth
	Services.StealService:RefreshWalkSpeed(player)
	Services.BaseService:TeleportHome(player)
	Services.PlayerDataService:Replicate(player)
	Services.PlayerDataService:MarkDirty(player)

	Remotes.Event("Announce"):FireAllClients(
		string.format("%s REBIRTHED! (Rebirth %d - x%.1f Essence forever)", player.DisplayName, data.Rebirths, Formulas.RebirthMultiplier(data.Rebirths)),
		Color3.fromRGB(255, 120, 255)
	)
	-- Save immediately: rebirth is a big state change worth protecting.
	task.spawn(Services.PlayerDataService.SaveAsync, Services.PlayerDataService, player, false)
	return true, "Rebirth complete!"
end

function RebirthService:BuyPerk(player: Player, perkId: any): (boolean, string)
	local data = Services.PlayerDataService:GetData(player)
	if not data or type(perkId) ~= "string" or not EconomyConfig.Perks[perkId] then
		return false, "Unknown perk"
	end
	local level = data.Perks[perkId] or 0
	local cost = Formulas.PerkCost(perkId, level)
	if not cost then
		return false, "Perk maxed!"
	end
	if data.RebirthTokens < cost then
		return false, "Need " .. cost .. " Rebirth Tokens"
	end
	data.RebirthTokens -= cost
	data.Perks[perkId] = level + 1
	Services.EconomyService:Recalculate(player)
	Services.PlayerDataService:Replicate(player)
	Services.PlayerDataService:MarkDirty(player)
	return true, EconomyConfig.Perks[perkId].Name .. " -> level " .. (level + 1)
end

function RebirthService:Init(services)
	Services = services
end

function RebirthService:Start()
	Remotes.Function("RequestRebirth").OnServerInvoke = function(player)
		if not RateLimiter.Check(player, "Rebirth", 2) then
			return { ok = false, msg = "Slow down!" }
		end
		local ok, msg = self:DoRebirth(player, false)
		return { ok = ok, msg = msg }
	end

	Remotes.Function("BuyPerk").OnServerInvoke = function(player, perkId)
		if not RateLimiter.Check(player, "Perk", 0.3) then
			return { ok = false, msg = "Slow down!" }
		end
		local ok, msg = self:BuyPerk(player, perkId)
		return { ok = ok, msg = msg }
	end
end

return RebirthService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">RewardService</string>
            <string name="Source"><![CDATA[--[[
	RewardService
	Reasons to come back every day and to keep playing:
	  * Daily login streak (7-day cycle, resets if you miss a UTC day)
	  * Playtime gifts (unlock after N minutes in the current session)
	  * Daily quests (3 per day, chosen per player, + a bonus for finishing all 3)

	Other services report progress with RewardService:Progress(player, kind, amount).
	Kinds: Deliver, DeliverRare, DeliverNight, BaseSteal, Hatch, BuySpeed, Bonk, Candy
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local RewardConfig = require(Shared.Config.RewardConfig)
local Remotes = require(Shared.Remotes)
local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)
local Rewards = require(script.Parent.Parent.Util.Rewards)

local RewardService = {}

local Services: any
local sessionStart: { [Player]: number } = {}
local playtimeClaimed: { [Player]: { [number]: boolean } } = {}

local questById = {}
for _, quest in ipairs(RewardConfig.QuestPool) do
	questById[quest.Id] = quest
end

-- Daily streak ---------------------------------------------------------------------------------------
local function dailyState(data: any): (boolean, number)
	local today = RewardConfig.Today()
	local canClaim = data.Daily.LastClaimDay < today
	local nextDay
	if data.Daily.LastClaimDay == today - 1 or data.Daily.LastClaimDay == today then
		nextDay = data.Daily.Streak % #RewardConfig.Daily + 1
	else
		nextDay = 1 -- streak broken (or first time)
	end
	if not canClaim then
		nextDay = (data.Daily.Streak - 1) % #RewardConfig.Daily + 1 -- today's (already claimed) day
	end
	return canClaim, nextDay
end

function RewardService:ClaimDaily(player: Player)
	local data = Services.PlayerDataService:GetData(player)
	if not data then
		return { ok = false, msg = "Data not loaded yet." }
	end
	local canClaim, day = dailyState(data)
	if not canClaim then
		return { ok = false, msg = "Come back tomorrow for your next gift!" }
	end
	local today = RewardConfig.Today()
	local continued = data.Daily.LastClaimDay == today - 1
	data.Daily.Streak = continued and data.Daily.Streak + 1 or 1
	data.Daily.LastClaimDay = today
	data.Stats.DaysPlayed += 1
	local granted = Rewards.Grant(Services, player, RewardConfig.Daily[day].Rewards)
	Services.PlayerDataService:MarkDirty(player)
	return { ok = true, msg = string.format("Day %d reward: %s (streak %d)", day, table.concat(granted, ", "), data.Daily.Streak) }
end

-- Playtime gifts ---------------------------------------------------------------------------------------
function RewardService:ClaimPlaytime(player: Player, index: any)
	index = tonumber(index)
	local gift = index and RewardConfig.Playtime[index]
	local start = sessionStart[player]
	if not gift or not start then
		return { ok = false }
	end
	local claimed = playtimeClaimed[player]
	if claimed[index] then
		return { ok = false, msg = "Already claimed." }
	end
	if os.clock() - start < gift.Minutes * 60 then
		return { ok = false, msg = "Not ready yet!" }
	end
	claimed[index] = true
	local granted = Rewards.Grant(Services, player, gift.Rewards)
	return { ok = true, msg = "Gift: " .. table.concat(granted, ", ") }
end

-- Daily quests ------------------------------------------------------------------------------------------
local function ensureQuests(player: Player, data: any)
	local today = RewardConfig.Today()
	if data.Quests.Day == today and #data.Quests.List > 0 then
		return
	end
	local eventActive = Services.EventService:IsActive()
	local pool = {}
	for _, quest in ipairs(RewardConfig.QuestPool) do
		if not quest.EventOnly or eventActive then
			table.insert(pool, quest)
		end
	end
	-- Deterministic per player per day, so rejoining doesn't reroll.
	local rng = Random.new(today * 7919 + player.UserId)
	local list = {}
	local usedKinds = {}
	while #list < RewardConfig.QuestsPerDay and #pool > 0 do
		local quest = table.remove(pool, rng:NextInteger(1, #pool))
		if not usedKinds[quest.Kind] then
			usedKinds[quest.Kind] = true
			table.insert(list, { Id = quest.Id, Progress = 0, Claimed = false })
		end
	end
	data.Quests = { Day = today, List = list, BonusClaimed = false }
end

function RewardService:Progress(player: Player, kind: string, amount: number?)
	local data = Services.PlayerDataService:GetData(player)
	if not data then
		return
	end
	ensureQuests(player, data)
	local changed = false
	for _, entry in ipairs(data.Quests.List) do
		local quest = questById[entry.Id]
		if quest and quest.Kind == kind and entry.Progress < quest.Goal then
			entry.Progress = math.min(quest.Goal, entry.Progress + (amount or 1))
			changed = true
			if entry.Progress >= quest.Goal then
				Services.PlayerDataService:Notify(player, "Quest complete: " .. quest.Text .. "! Claim it in Gifts.", "success")
			end
		end
	end
	if changed then
		Services.PlayerDataService:MarkDirty(player)
	end
end

function RewardService:ClaimQuest(player: Player, which: any)
	local data = Services.PlayerDataService:GetData(player)
	if not data then
		return { ok = false }
	end
	ensureQuests(player, data)
	if which == "Bonus" then
		if data.Quests.BonusClaimed then
			return { ok = false, msg = "Bonus already claimed today." }
		end
		for _, entry in ipairs(data.Quests.List) do
			if not entry.Claimed then
				return { ok = false, msg = "Claim all 3 quests first!" }
			end
		end
		data.Quests.BonusClaimed = true
		local granted = Rewards.Grant(Services, player, RewardConfig.AllQuestsBonus)
		return { ok = true, msg = "All quests bonus: " .. table.concat(granted, ", ") }
	end
	local index = tonumber(which)
	local entry = index and data.Quests.List[index]
	local quest = entry and questById[entry.Id]
	if not entry or not quest then
		return { ok = false }
	end
	if entry.Claimed then
		return { ok = false, msg = "Already claimed." }
	end
	if entry.Progress < quest.Goal then
		return { ok = false, msg = "Not finished yet." }
	end
	entry.Claimed = true
	local granted = Rewards.Grant(Services, player, quest.Rewards)
	return { ok = true, msg = "Quest reward: " .. table.concat(granted, ", ") }
end

-- Snapshot for the UI ---------------------------------------------------------------------------------------
function RewardService:GetSnapshot(player: Player)
	local data = Services.PlayerDataService:GetData(player)
	if not data then
		return nil
	end
	ensureQuests(player, data)
	local canClaim, day = dailyState(data)
	local quests = {}
	for i, entry in ipairs(data.Quests.List) do
		local quest = questById[entry.Id]
		if quest then
			quests[i] = { Text = quest.Text, Goal = quest.Goal, Progress = entry.Progress, Claimed = entry.Claimed }
		end
	end
	local claimed = {}
	for index in pairs(playtimeClaimed[player] or {}) do
		table.insert(claimed, index)
	end
	return {
		DailyCanClaim = canClaim,
		DailyDay = day,
		DailyStreak = data.Daily.Streak,
		SessionSeconds = sessionStart[player] and math.floor(os.clock() - sessionStart[player]) or 0,
		PlaytimeClaimed = claimed,
		Quests = quests,
		QuestBonusClaimed = data.Quests.BonusClaimed,
		NextResetIn = (RewardConfig.Today() + 1) * 86400 - os.time(),
	}
end

-- Lifecycle ------------------------------------------------------------------------------------------------
function RewardService:Init(services)
	Services = services
	Services.PlayerDataService.ProfileLoaded:Connect(function(player, data)
		sessionStart[player] = os.clock()
		playtimeClaimed[player] = {}
		ensureQuests(player, data)
		local canClaim = dailyState(data)
		if canClaim then
			Services.PlayerDataService:Notify(player, "Your daily gift is ready! Open Gifts to claim it.", "warning")
		end
	end)
end

function RewardService:Start()
	Players.PlayerRemoving:Connect(function(player)
		sessionStart[player] = nil
		playtimeClaimed[player] = nil
	end)

	local function guarded(key: string, fn: (Player, any) -> any)
		return function(player: Player, arg: any)
			if not RateLimiter.Check(player, key, 0.4) then
				return { ok = false, msg = "Slow down!" }
			end
			local result = fn(player, arg)
			Services.PlayerDataService:MarkDirty(player)
			return result
		end
	end
	Remotes.Function("ClaimDaily").OnServerInvoke = guarded("ClaimDaily", function(player)
		return self:ClaimDaily(player)
	end)
	Remotes.Function("ClaimPlaytime").OnServerInvoke = guarded("ClaimPlaytime", function(player, index)
		return self:ClaimPlaytime(player, index)
	end)
	Remotes.Function("ClaimQuest").OnServerInvoke = guarded("ClaimQuest", function(player, which)
		return self:ClaimQuest(player, which)
	end)

	-- Tell players when a playtime gift unlocks.
	task.spawn(function()
		while true do
			task.wait(15)
			for player, start in pairs(sessionStart) do
				local minutes = (os.clock() - start) / 60
				for index, gift in ipairs(RewardConfig.Playtime) do
					local claimed = playtimeClaimed[player]
					if claimed and not claimed[index] and minutes >= gift.Minutes and minutes < gift.Minutes + 0.25 then
						Services.PlayerDataService:Notify(player, "Playtime gift unlocked: " .. gift.Label .. "! Open Gifts.", "warning")
						Services.PlayerDataService:MarkDirty(player)
					end
				end
			end
		end
	end)
end

return RewardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">StealService</string>
            <string name="Source"><![CDATA[--[[
	StealService
	Everything about carrying a soul: picking up, weight slowdown, being chased/bonked, dropping,
	delivering home, and stealing incubating souls out of other players' bases.

	Rules
	  * Carry 1 soul at a time. Heavier (rarer) souls slow you more; Carry upgrades + Phantom Steps reduce it.
	  * Touched by a guardian / bonked by a player / died -> the soul drops on the ground (anyone can grab it).
	  * Walk into YOUR base zone with a soul -> it's placed on a free pedestal and starts incubating.
	  * Incubating souls in other bases can be stolen (hold prompt) unless the base is locked/shielded/protected.
	  * WalkSpeed is ALWAYS set by the server here (never trust the client).
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local PetConfig = require(Shared.Config.PetConfig)
local BiomeConfig = require(Shared.Config.BiomeConfig)
local MonetizationConfig = require(Shared.Config.MonetizationConfig)
local AbilityConfig = require(Shared.Config.AbilityConfig)
local Formulas = require(Shared.Formulas)
local Format = require(Shared.Util.Format)
local Remotes = require(Shared.Remotes)
local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)
local ModelFactory = require(script.Parent.Parent.World.ModelFactory)

export type Carried = {
	Orb: { Rarity: string, Biome: string, Mutation: string? },
	Visual: Model?,
	StolenFromUserId: number?,
}

local StealService = {}

local Services: any
local carrying: { [Player]: Carried } = {}
local slows: { [Player]: { { Factor: number, Until: number } } } = {}
local highlights: { [Player]: Highlight } = {}
local lastFullWarning: { [Player]: number } = {}
local hiddenUntil: { [Player]: number } = {} -- guardians can't perceive (Grave Veil / Shadow Cloak)
local wardUntil: { [Player]: number } = {} -- next knock-loose is blocked (Halo Ward)

local function getRoot(player: Player): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function getHumanoid(player: Player): Humanoid?
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

-- Movement ------------------------------------------------------------------------------------------
function StealService:GetBaseSpeed(player: Player): number
	local data = Services.PlayerDataService:GetData(player)
	if not data then
		return 16
	end
	local speed = data.Speed
	if Services.MonetizationService:HasPass(player, "PhantomSteps") then
		speed += MonetizationConfig.Effects.PhantomSpeed
	end
	return speed
end

function StealService:RefreshWalkSpeed(player: Player)
	local humanoid = getHumanoid(player)
	local data = Services.PlayerDataService:GetData(player)
	if not humanoid or not data then
		return
	end
	local speed = self:GetBaseSpeed(player)
	local carried = carrying[player]
	if carried then
		local phantom = Services.MonetizationService:HasPass(player, "PhantomSteps")
		speed = Formulas.CarriedSpeed(speed, carried.Orb.Rarity, data.CarryLevel, phantom)
	end
	if player:GetAttribute("Sneaking") then
		speed *= AbilityConfig.Stealth.SneakSpeedMult
	end
	local now = os.clock()
	local list = slows[player]
	if list then
		for i = #list, 1, -1 do
			if list[i].Until <= now then
				table.remove(list, i)
			else
				speed *= list[i].Factor
			end
		end
	end
	humanoid.WalkSpeed = speed
	player:SetAttribute("WalkSpeed", speed)
end

function StealService:ApplySlow(player: Player, factor: number, duration: number)
	slows[player] = slows[player] or {}
	table.insert(slows[player], { Factor = factor, Until = os.clock() + duration })
	self:RefreshWalkSpeed(player)
	task.delay(duration + 0.05, function()
		if player.Parent then
			self:RefreshWalkSpeed(player)
		end
	end)
end

function StealService:Knockback(player: Player, fromPosition: Vector3, power: number)
	local root = getRoot(player)
	if not root then
		return
	end
	local direction = root.Position - fromPosition
	direction = Vector3.new(direction.X, 0, direction.Z)
	if direction.Magnitude < 0.1 then
		direction = Vector3.new(0, 0, 1)
	end
	Services.AntiExploitService:Grace(player, 1.5)
	Remotes.Event("Knockback"):FireClient(player, direction.Unit * power + Vector3.new(0, power * 0.5, 0))
end

-- Stealth & ability hooks ------------------------------------------------------------------------------
function StealService:IsHiddenFromGuardians(player: Player): boolean
	return (hiddenUntil[player] or 0) > os.clock()
end

function StealService:HideFromGuardians(player: Player, seconds: number)
	hiddenUntil[player] = math.max(hiddenUntil[player] or 0, os.clock() + seconds)
end

function StealService:Ward(player: Player, seconds: number)
	wardUntil[player] = os.clock() + seconds
	player:SetAttribute("Warded", true)
	task.delay(seconds, function()
		if (wardUntil[player] or 0) <= os.clock() then
			player:SetAttribute("Warded", nil)
		end
	end)
end

-- Guardians and bonks call this instead of Drop: Halo Ward can block it. Returns true if the soul dropped.
function StealService:TryKnockLoose(player: Player, reason: string): boolean
	if not carrying[player] then
		return false
	end
	if (wardUntil[player] or 0) > os.clock() then
		wardUntil[player] = 0
		player:SetAttribute("Warded", nil)
		Services.PlayerDataService:Notify(player, "Halo Ward blocked it!", "success")
		return false
	end
	self:Drop(player, reason)
	return true
end

-- Sends the player flying with a velocity (client applies it - it owns its character physics).
function StealService:Launch(player: Player, velocity: Vector3)
	Services.AntiExploitService:Grace(player, 2)
	Remotes.Event("Knockback"):FireClient(player, velocity)
end

function StealService:SetSneak(player: Player, on: boolean)
	player:SetAttribute("Sneaking", on or nil)
	self:RefreshWalkSpeed(player)
end

-- Haunt: the robbed owner curses the thief (once per robbery, within a short window).
function StealService:Haunt(owner: Player)
	local thiefId = owner:GetAttribute("HauntThiefId")
	local untilTime = owner:GetAttribute("HauntUntil") or 0
	if not thiefId or Workspace:GetServerTimeNow() > untilTime then
		return { ok = false, msg = "Nobody to haunt right now." }
	end
	owner:SetAttribute("HauntThiefId", nil)
	owner:SetAttribute("HauntUntil", nil)
	local thief = Players:GetPlayerByUserId(thiefId)
	local carried = thief and carrying[thief]
	if not thief or not carried or carried.StolenFromUserId ~= owner.UserId then
		return { ok = false, msg = "The thief already got away..." }
	end
	local haunt = AbilityConfig.Haunt
	self:ApplySlow(thief, haunt.SlowFactor, haunt.Duration)
	if highlights[thief] then
		highlights[thief].FillColor = Color3.fromRGB(140, 40, 255)
	end
	Services.PlayerDataService:Notify(thief, owner.DisplayName .. " is HAUNTING you! You're slowed!", "error")
	return { ok = true, msg = "You haunted " .. thief.DisplayName .. "! Catch them!" }
end

-- Carry state -----------------------------------------------------------------------------------------
function StealService:IsCarrying(player: Player): boolean
	return carrying[player] ~= nil
end

function StealService:GetCarried(player: Player): Carried?
	return carrying[player]
end

local function setThiefHighlight(player: Player, on: boolean)
	local existing = highlights[player]
	if existing then
		existing:Destroy()
		highlights[player] = nil
	end
	if on and player.Character then
		local highlight = Instance.new("Highlight")
		highlight.FillColor = Color3.fromRGB(255, 40, 40)
		highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
		highlight.FillTransparency = 0.6
		highlight.Parent = player.Character
		highlights[player] = highlight
	end
end

function StealService:PickUp(player: Player, orb: { Rarity: string, Biome: string, Mutation: string? }, stolenFromUserId: number?): boolean
	local root = getRoot(player)
	local humanoid = getHumanoid(player)
	if not root or not humanoid or humanoid.Health <= 0 or carrying[player] then
		return false
	end
	if not Services.PlayerDataService:IsLoaded(player) then
		return false
	end

	local visual = ModelFactory.MakeOrb(orb.Rarity, orb.Biome, orb.Mutation)
	visual:PivotTo(root.CFrame * CFrame.new(0, 4.5, 0))
	for _, part in ipairs(visual:GetDescendants()) do
		if part:IsA("BasePart") then
			part.Anchored = false
			part.CanCollide = false
			part.Massless = true
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = root
			weld.Part1 = part
			weld.Parent = part
		end
	end
	visual.Name = "CarriedSoul"
	visual.Parent = player.Character

	carrying[player] = { Orb = { Rarity = orb.Rarity, Biome = orb.Biome, Mutation = orb.Mutation }, Visual = visual, StolenFromUserId = stolenFromUserId }
	player:SetAttribute("CarryingRarity", orb.Rarity)
	player:SetAttribute("CarryingBiome", orb.Biome)
	if stolenFromUserId then
		setThiefHighlight(player, true)
	end
	self:RefreshWalkSpeed(player)
	return true
end

-- Removes the carried soul without dropping it. Returns its data.
function StealService:Clear(player: Player): Carried?
	local carried = carrying[player]
	if not carried then
		return nil
	end
	carrying[player] = nil
	if carried.Visual then
		carried.Visual:Destroy()
	end
	player:SetAttribute("CarryingRarity", nil)
	player:SetAttribute("CarryingBiome", nil)
	setThiefHighlight(player, false)
	if player.Parent then
		self:RefreshWalkSpeed(player)
	end
	return carried
end

-- Drops the carried soul on the ground where anyone can pick it up.
function StealService:Drop(player: Player, reason: string?)
	local root = getRoot(player)
	local position = root and root.Position
	local carried = self:Clear(player)
	if not carried then
		return
	end
	if position then
		local offset = Vector3.new(math.random(-4, 4), 0, math.random(-4, 4))
		Services.BiomeService:SpawnDroppedOrb(carried.Orb, position + offset)
	end
	if reason and player.Parent then
		Services.PlayerDataService:Notify(player, reason, "error")
	end
end

-- Stealing from bases -------------------------------------------------------------------------------------
function StealService:TryStealFromBase(thief: Player, ownerUserId: number, index: number)
	local pds = Services.PlayerDataService
	if thief.UserId == ownerUserId then
		pds:Notify(thief, "That's your own soul!", "info")
		return
	end
	if not RateLimiter.Check(thief, "BaseSteal", 1) then
		return
	end
	if carrying[thief] then
		pds:Notify(thief, "You're already carrying a soul!", "error")
		return
	end
	local base, owner = Services.BaseService:GetBaseOfUserId(ownerUserId)
	if not base or not owner then
		return
	end
	local protected, reason = Services.BaseService:IsProtected(owner)
	if protected then
		pds:Notify(thief, reason or "Protected.", "error")
		return
	end
	local pedestal = base.Pedestals[index]
	local root = getRoot(thief)
	if not pedestal or not root or (root.Position - pedestal.Position).Magnitude > GameConfig.BaseStealMaxDistance then
		return -- too far: exploit attempt or lag
	end

	local orb = Services.PetService:TakeOrb(owner, index)
	if not orb then
		return
	end
	if not self:PickUp(thief, orb, ownerUserId) then
		Services.PetService:PlaceOrb(owner, orb) -- give it back if the pickup failed
		return
	end

	local ownerData = pds:GetData(owner)
	if ownerData then
		ownerData.LastRobbed = { Rarity = orb.Rarity, Biome = orb.Biome, Time = os.time() }
		ownerData.Stats.TimesRobbed += 1
		pds:MarkDirty(owner)
	end
	-- Give the owner a short window to Haunt the thief
	owner:SetAttribute("HauntThiefId", thief.UserId)
	owner:SetAttribute("HauntUntil", Workspace:GetServerTimeNow() + AbilityConfig.Haunt.WindowSeconds)
	pds:Notify(owner, string.format("%s is stealing your %s Soul! HAUNT them (H) and bonk them!", thief.DisplayName, orb.Rarity), "error")
	pds:Notify(thief, "You grabbed a " .. orb.Rarity .. " Soul! RUN HOME!", "success")
	local rarity = PetConfig.GetRarity(orb.Rarity)
	if rarity.Announce then
		Remotes.Event("Announce"):FireAllClients(
			string.format("%s is stealing %s's %s Soul!", thief.DisplayName, owner.DisplayName, orb.Rarity),
			rarity.Color
		)
	end
end

-- Delivery --------------------------------------------------------------------------------------------------
local function tryDeliver(player: Player)
	local carried = carrying[player]
	if not carried or not Services.BaseService:IsPlayerInOwnBase(player) then
		return
	end
	local index = Services.PetService:PlaceOrb(player, carried.Orb)
	if not index then
		local now = os.clock()
		if not lastFullWarning[player] or now - lastFullWarning[player] > 4 then
			lastFullWarning[player] = now
			Services.PlayerDataService:Notify(player, "All pedestals are full! Buy more or store/sell a spirit.", "warning")
		end
		return
	end
	local data = Services.PlayerDataService:GetData(player)
	data.Stats.Steals += 1
	local rewards = Services.RewardService
	rewards:Progress(player, "Deliver", 1)
	if PetConfig.GetRarity(carried.Orb.Rarity).Order >= 3 then
		rewards:Progress(player, "DeliverRare", 1)
	end
	if Services.DayNightService:IsNight() then
		rewards:Progress(player, "DeliverNight", 1)
	end
	if carried.StolenFromUserId then
		data.Stats.BaseSteals += 1
		rewards:Progress(player, "BaseSteal", 1)
	end
	Services.EventService:OnDeliver(player, carried.Orb.Rarity)
	StealService:Clear(player)
	local biome = BiomeConfig.Get(carried.Orb.Biome)
	local hatchSeconds = Services.PetService:GetHatchDuration(player, carried.Orb.Rarity, carried.Orb.Biome)
	Services.PlayerDataService:Notify(
		player,
		string.format("%s %s Soul secured! Hatching in %s", carried.Orb.Rarity, biome.Name, Format.Time(hatchSeconds)),
		"success"
	)
	Services.PlayerDataService:Replicate(player)
	Services.PlayerDataService:MarkDirty(player)
end

-- Lifecycle ---------------------------------------------------------------------------------------------------
function StealService:Init(services)
	Services = services
end

function StealService:Start()
	local function onCharacter(player: Player, character: Model)
		local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
		if not humanoid then
			return
		end
		-- A fresh character never carries anything.
		if carrying[player] then
			self:Clear(player)
		end
		self:RefreshWalkSpeed(player)
		humanoid.Died:Connect(function()
			self:Drop(player, "You died and dropped your soul!")
		end)
	end

	local function hook(player: Player)
		player.CharacterAdded:Connect(function(character)
			onCharacter(player, character)
		end)
		if player.Character then
			task.spawn(onCharacter, player, player.Character)
		end
	end
	Players.PlayerAdded:Connect(hook)
	for _, player in ipairs(Players:GetPlayers()) do
		hook(player)
	end

	Services.PlayerDataService.ProfileLoaded:Connect(function(player)
		self:RefreshWalkSpeed(player)
	end)

	Players.PlayerRemoving:Connect(function(player)
		self:Drop(player, nil) -- leaving with a soul drops it for everyone else
		slows[player] = nil
		lastFullWarning[player] = nil
		hiddenUntil[player] = nil
		wardUntil[player] = nil
	end)

	Remotes.Event("SetSneak").OnServerEvent:Connect(function(player, on)
		if RateLimiter.Check(player, "Sneak", 0.2) then
			self:SetSneak(player, on == true)
		end
	end)
	Remotes.Function("Haunt").OnServerInvoke = function(player)
		if not RateLimiter.Check(player, "Haunt", 0.5) then
			return { ok = false }
		end
		return self:Haunt(player)
	end

	Remotes.Event("DropOrb").OnServerEvent:Connect(function(player)
		if RateLimiter.Check(player, "DropOrb", 0.5) then
			self:Drop(player, nil)
		end
	end)

	-- Delivery check loop
	task.spawn(function()
		while true do
			task.wait(0.15)
			for player in pairs(carrying) do
				if player.Parent then
					tryDeliver(player)
				else
					carrying[player] = nil
				end
			end
		end
	end)
end

return StealService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">ToolService</string>
            <string name="Source"><![CDATA[--[[
	ToolService
	Light PvP: every player gets a Soul Lantern; Reaper Scythe pass owners get the Scythe.
	Hit detection is 100% server-side (Tool.Activated replicates to the server): the server finds the
	closest player in front of the attacker within range. The client never sends a target.

	Hitting a player who is CARRYING a soul knocks it loose (it drops on the ground) + short stun.
	Hitting a non-carrier only knocks them back a little (no griefing value).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local ModelFactory = require(script.Parent.Parent.World.ModelFactory)

local ToolService = {}

local Services: any
local lastSwing: { [Player]: number } = {}

local function getRoot(player: Player): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function findVictim(attacker: Player, range: number): Player?
	local root = getRoot(attacker)
	if not root then
		return nil
	end
	local best, bestDistance = nil, range
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= attacker then
			local otherRoot = getRoot(other)
			local humanoid = other.Character and other.Character:FindFirstChildOfClass("Humanoid")
			if otherRoot and humanoid and humanoid.Health > 0 then
				local offset = otherRoot.Position - root.Position
				local distance = offset.Magnitude
				-- Must be roughly in front (60° cone) unless point-blank.
				local inFront = distance < 4 or root.CFrame.LookVector:Dot(offset.Unit) > 0.5
				if distance <= bestDistance and inFront then
					best, bestDistance = other, distance
				end
			end
		end
	end
	return best
end

local function onSwing(player: Player, isScythe: boolean)
	local stats = isScythe and GameConfig.Scythe or GameConfig.Lantern
	local now = os.clock()
	if lastSwing[player] and now - lastSwing[player] < stats.Cooldown then
		return
	end
	lastSwing[player] = now
	local victim = findVictim(player, stats.Range)
	local root = getRoot(player)
	if not victim or not root then
		return
	end
	if Services.StealService:IsCarrying(victim) then
		if not Services.StealService:TryKnockLoose(victim, player.DisplayName .. " knocked your soul loose!") then
			Services.PlayerDataService:Notify(player, victim.DisplayName .. "'s Halo Ward blocked your hit!", "error")
			return
		end
		Services.StealService:ApplySlow(victim, 0.3, stats.StunSeconds)
		Services.StealService:Knockback(victim, root.Position, stats.Knockback)
		Services.PlayerDataService:Notify(player, "You knocked " .. victim.DisplayName .. "'s soul loose! Grab it!", "success")
		local data = Services.PlayerDataService:GetData(player)
		if data then
			data.Stats.Bonks += 1
		end
		Services.RewardService:Progress(player, "Bonk", 1)
	else
		Services.StealService:Knockback(victim, root.Position, stats.Knockback * 0.4)
	end
end

function ToolService:GiveTools(player: Player)
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack or not player.Character then
		return
	end
	local hasScythe = Services.MonetizationService:HasPass(player, "ReaperScythe")
	local function has(name: string): boolean
		return backpack:FindFirstChild(name) ~= nil or player.Character:FindFirstChild(name) ~= nil
	end
	local function give(isScythe: boolean)
		local tool = ModelFactory.MakeWeapon(isScythe)
		if has(tool.Name) then
			tool:Destroy()
			return
		end
		tool.Activated:Connect(function()
			onSwing(player, isScythe)
		end)
		tool.Parent = backpack
	end
	give(false)
	if hasScythe then
		give(true)
	end
end

function ToolService:Init(services)
	Services = services
end

function ToolService:Start()
	local function hook(player: Player)
		player.CharacterAdded:Connect(function(character)
			character:WaitForChild("HumanoidRootPart", 10)
			task.wait(0.5)
			Services.MonetizationService:WaitForPasses(player)
			self:GiveTools(player)
		end)
		if player.Character then
			task.spawn(self.GiveTools, self, player)
		end
	end
	Players.PlayerAdded:Connect(hook)
	for _, player in ipairs(Players:GetPlayers()) do
		hook(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		lastSwing[player] = nil
	end)
end

return ToolService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">UpgradeService</string>
            <string name="Source"><![CDATA[--[[
	UpgradeService
	Essence sinks: Speed (Treadmill), Treadmill tiers (Speed cap), Soul Harness (Carry), Pedestals.
	RequestUpgrade(kind, amount) -> { ok, msg }
		kind "Speed"     amount = 1 | 10 | "Max"
		kind "Treadmill" buys the next tier (raises the Speed cap)
		kind "Carry"     +1 Soul Harness level
		kind "Pedestal"  +1 pedestal
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local EconomyConfig = require(Shared.Config.EconomyConfig)
local BiomeConfig = require(Shared.Config.BiomeConfig)
local Formulas = require(Shared.Formulas)
local Format = require(Shared.Util.Format)
local Remotes = require(Shared.Remotes)
local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)

local UpgradeService = {}

local Services: any

local function fail(msg: string)
	return { ok = false, msg = msg }
end

local function buySpeed(player: Player, data: any, amount: any)
	local cap = Formulas.TreadmillCap(data.TreadmillTier)
	local room = cap - data.Speed
	if room <= 0 then
		return fail("Speed capped at " .. cap .. ". Upgrade your Treadmill!")
	end
	local wanted = if amount == "Max" then room elseif amount == 10 then math.min(10, room) else 1
	local count, cost = Formulas.SpeedAffordable(data.Speed, data.Essence, wanted)
	if count == 0 then
		return fail("Need " .. Format.Number(Formulas.SpeedCost(data.Speed)) .. " Essence")
	end
	if not Services.EconomyService:TrySpend(player, cost) then
		return fail("Not enough Essence")
	end
	data.Speed += count
	Services.StealService:RefreshWalkSpeed(player)
	Services.RewardService:Progress(player, "BuySpeed", count)
	return { ok = true, msg = string.format("+%d Speed (now %d)", count, data.Speed) }
end

local function buyTreadmill(player: Player, data: any)
	local nextTier = EconomyConfig.Treadmill[data.TreadmillTier + 1]
	if not nextTier then
		return fail("Treadmill is maxed!")
	end
	if nextTier.RequiresRebirths and data.Rebirths < nextTier.RequiresRebirths then
		return fail("Requires " .. nextTier.RequiresRebirths .. " rebirth(s)")
	end
	if not Services.EconomyService:TrySpend(player, nextTier.Cost) then
		return fail("Need " .. Format.Number(nextTier.Cost) .. " Essence")
	end
	data.TreadmillTier += 1
	return { ok = true, msg = "Treadmill upgraded! Speed cap: " .. nextTier.Cap }
end

local function buyCarry(player: Player, data: any)
	if data.CarryLevel >= EconomyConfig.CarryMaxLevel then
		return fail("Soul Harness is maxed!")
	end
	local cost = Formulas.CarryCost(data.CarryLevel)
	if not Services.EconomyService:TrySpend(player, cost) then
		return fail("Need " .. Format.Number(cost) .. " Essence")
	end
	data.CarryLevel += 1
	Services.StealService:RefreshWalkSpeed(player)
	return { ok = true, msg = "Soul Harness level " .. data.CarryLevel }
end

local function buyPedestal(player: Player, data: any)
	if data.Pedestals >= EconomyConfig.MaxPedestals then
		return fail("All pedestals unlocked!")
	end
	local cost = Formulas.PedestalCost(data.Pedestals)
	if not Services.EconomyService:TrySpend(player, cost) then
		return fail("Need " .. Format.Number(cost) .. " Essence")
	end
	data.Pedestals += 1
	Services.PetService:RenderBase(player)
	Services.EconomyService:Recalculate(player)
	return { ok = true, msg = "New pedestal unlocked! (" .. data.Pedestals .. ")" }
end

-- Robux upgrades -----------------------------------------------------------------------------------------
-- Called by MonetizationService. Each returns true if something was granted (false = already maxed,
-- the purchase is then compensated with Essence).

-- Highest Treadmill tier this player's rebirth count allows.
local function maxAllowedTier(data: any): number
	local best = 1
	for tier, info in ipairs(EconomyConfig.Treadmill) do
		if not info.RequiresRebirths or data.Rebirths >= info.RequiresRebirths then
			best = tier
		end
	end
	return best
end

local function finish(player: Player)
	Services.StealService:RefreshWalkSpeed(player)
	Services.PlayerDataService:Replicate(player)
	Services.PlayerDataService:MarkDirty(player)
end

function UpgradeService:GrantSpeed(player: Player, amount: number): boolean
	local data = Services.PlayerDataService:GetData(player)
	if not data then
		return false
	end
	local topTier = maxAllowedTier(data)
	local absoluteCap = Formulas.TreadmillCap(topTier)
	if data.Speed >= absoluteCap then
		return false
	end
	local newSpeed = math.min(data.Speed + amount, absoluteCap)
	-- Raise the Treadmill tier for free so the bought Speed fits under the cap.
	while Formulas.TreadmillCap(data.TreadmillTier) < newSpeed and data.TreadmillTier < topTier do
		data.TreadmillTier += 1
	end
	data.Speed = newSpeed
	finish(player)
	return true
end

function UpgradeService:GrantNextBiome(player: Player): boolean
	local data = Services.PlayerDataService:GetData(player)
	if not data then
		return false
	end
	for _, id in ipairs(BiomeConfig.Order) do
		local required = BiomeConfig.Get(id).SpeedRequired
		if data.Speed < required then
			return self:GrantSpeed(player, required - data.Speed)
		end
	end
	return false
end

function UpgradeService:GrantTreadmill(player: Player): boolean
	local data = Services.PlayerDataService:GetData(player)
	if not data or data.TreadmillTier >= maxAllowedTier(data) then
		return false
	end
	data.TreadmillTier += 1
	finish(player)
	return true
end

function UpgradeService:GrantHarnessMax(player: Player): boolean
	local data = Services.PlayerDataService:GetData(player)
	if not data or data.CarryLevel >= EconomyConfig.CarryMaxLevel then
		return false
	end
	data.CarryLevel = EconomyConfig.CarryMaxLevel
	finish(player)
	return true
end

function UpgradeService:GrantPedestal(player: Player): boolean
	local data = Services.PlayerDataService:GetData(player)
	if not data or data.Pedestals >= EconomyConfig.MaxPedestals then
		return false
	end
	data.Pedestals += 1
	Services.PetService:RenderBase(player)
	Services.EconomyService:Recalculate(player)
	finish(player)
	return true
end

function UpgradeService:Init(services)
	Services = services
end

function UpgradeService:Start()
	Remotes.Function("RequestUpgrade").OnServerInvoke = function(player, kind, amount)
		if not RateLimiter.Check(player, "Upgrade", 0.1) then
			return fail("Slow down!")
		end
		local data = Services.PlayerDataService:GetData(player)
		if not data then
			return fail("Data not loaded yet")
		end
		local result
		if kind == "Speed" then
			result = buySpeed(player, data, amount)
		elseif kind == "Treadmill" then
			result = buyTreadmill(player, data)
		elseif kind == "Carry" then
			result = buyCarry(player, data)
		elseif kind == "Pedestal" then
			result = buyPedestal(player, data)
		else
			return fail("Unknown upgrade")
		end
		Services.PlayerDataService:Replicate(player)
		Services.PlayerDataService:MarkDirty(player)
		return result
	end
end

return UpgradeService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="41">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">RateLimiter</string>
            <string name="Source"><![CDATA[--[[
	RateLimiter
	Per-player, per-action cooldowns for anything a client can trigger.
	RateLimiter.Check(player, "Upgrade", 0.15) -> true if allowed (and records the call).
]]

local Players = game:GetService("Players")

local RateLimiter = {}

local lastCall: { [Player]: { [string]: number } } = {}

function RateLimiter.Check(player: Player, key: string, cooldown: number): boolean
	local now = os.clock()
	local calls = lastCall[player]
	if not calls then
		calls = {}
		lastCall[player] = calls
	end
	local previous = calls[key]
	if previous and now - previous < cooldown then
		return false
	end
	calls[key] = now
	return true
end

Players.PlayerRemoving:Connect(function(player)
	lastCall[player] = nil
end)

return RateLimiter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">Rewards</string>
            <string name="Source"><![CDATA[--[[
	Rewards
	One reward format for codes, daily streak, playtime gifts, quests and the event shop.
		{ Essence, IncomeSeconds, Boost = {Kind, Seconds}, Orb = {Rarity, Biome = "Best"|id, Mutation?}, Candy }
	Rewards.Grant(Services, player, rewards) -> { "500 Essence", "Epic Soul", ... } (human-readable list)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Util.Format)

local Rewards = {}

function Rewards.Grant(Services: any, player: Player, rewards: any): { string }
	local granted = {}
	if type(rewards) ~= "table" then
		return granted
	end
	local essence = rewards.Essence or 0
	if rewards.IncomeSeconds then
		essence = math.max(essence, math.floor(Services.EconomyService:GetIncome(player) * rewards.IncomeSeconds))
	end
	if essence > 0 then
		Services.EconomyService:AddEssence(player, essence)
		table.insert(granted, Format.Number(essence) .. " Essence")
	end
	if rewards.Boost then
		Services.EconomyService:AddBoost(player, rewards.Boost.Kind, rewards.Boost.Seconds)
		table.insert(granted, rewards.Boost.Kind .. " (" .. Format.Time(rewards.Boost.Seconds) .. ")")
	end
	if rewards.Orb then
		local biome = rewards.Orb.Biome
		if biome == "Best" or biome == nil then
			biome = Services.PetService:GetBestBiome(player)
		end
		Services.PetService:GiveOrb(player, { Rarity = rewards.Orb.Rarity, Biome = biome, Mutation = rewards.Orb.Mutation })
		local prefix = rewards.Orb.Mutation and (rewards.Orb.Mutation .. " ") or ""
		table.insert(granted, prefix .. rewards.Orb.Rarity .. " Soul")
	end
	if rewards.Candy and rewards.Candy > 0 and Services.EventService:IsActive() then
		Services.EventService:AddCandy(player, rewards.Candy, false)
		table.insert(granted, rewards.Candy .. " Candy")
	end
	Services.PlayerDataService:MarkDirty(player)
	return granted
end

return Rewards
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="44">
        <Properties>
          <string name="Name">World</string>
        </Properties>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">ModelFactory</string>
            <string name="Source"><![CDATA[--[[
	ModelFactory
	Builds every runtime visual: soul orbs, spirit pets, guardians and tools.

	Placeholder art is generated so the game runs on an empty baseplate. To use real art, drop models in:
		ReplicatedStorage.Assets.Pets.<Species name>   (Model, PrimaryPart set)  -> used for spirit pets
		ReplicatedStorage.Assets.Orbs.<Rarity id>      (Model, PrimaryPart set)  -> used for soul orbs
		ServerStorage.Guardians.<Biome id>             (Model with Humanoid + HumanoidRootPart)
		ServerStorage.Tools.SoulLantern / ReaperScythe (Tool with Handle)
	Anything you add there automatically replaces the placeholder.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local CollectionService = game:GetService("CollectionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local PetConfig = require(Shared.Config.PetConfig)
local BiomeConfig = require(Shared.Config.BiomeConfig)

local ModelFactory = {}

local function findAsset(root: Instance, ...: string): Instance?
	local current: Instance? = root
	for _, name in ipairs({ ... }) do
		if not current then
			return nil
		end
		current = current:FindFirstChild(name)
	end
	return current
end

-- Billboard with up to N stacked text lines. Returns the gui; lines are named "Line1", "Line2", ...
function ModelFactory.Billboard(adornee: BasePart, lines: { { Text: string, Color: Color3? } }, offsetY: number, maxDistance: number?)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Info"
	gui.Size = UDim2.fromOffset(220, 22 * #lines)
	gui.StudsOffset = Vector3.new(0, offsetY, 0)
	gui.MaxDistance = maxDistance or 90
	gui.LightInfluence = 0
	gui.Adornee = adornee
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = gui
	for i, line in ipairs(lines) do
		local label = Instance.new("TextLabel")
		label.Name = "Line" .. i
		label.LayoutOrder = i
		label.BackgroundTransparency = 1
		label.Size = UDim2.new(1, 0, 0, 22)
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.Text = line.Text
		label.TextColor3 = line.Color or Color3.new(1, 1, 1)
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 2
		stroke.Color = Color3.new(0, 0, 0)
		stroke.Parent = label
		label.Parent = gui
	end
	gui.Parent = adornee
	return gui
end

function ModelFactory.SetLine(gui: Instance?, index: number, text: string, color: Color3?)
	if not gui then
		return
	end
	local label = gui:FindFirstChild("Line" .. index)
	if label and label:IsA("TextLabel") then
		label.Text = text
		if color then
			label.TextColor3 = color
		end
	end
end

local function glowPart(name: string, size: Vector3, color: Color3, shape: Enum.PartType): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Shape = shape
	part.Size = size
	part.Color = color
	part.Material = Enum.Material.Neon
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CastShadow = false
	return part
end

local function addSparkles(parent: BasePart, color: Color3, rate: number)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "Sparkles"
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 1
	emitter.Rate = rate
	emitter.Lifetime = NumberRange.new(0.6, 1.2)
	emitter.Speed = NumberRange.new(1, 3)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	emitter.Parent = parent
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 10
	light.Brightness = 2
	light.Parent = parent
end

local function weldTo(root: BasePart, part: BasePart)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = part
	weld.Parent = part
end

-- Soul Orb ---------------------------------------------------------------------
function ModelFactory.MakeOrb(rarityId: string, biomeId: string, mutationId: string?): Model
	local rarity = PetConfig.GetRarity(rarityId)
	local biome = BiomeConfig.Get(biomeId)

	local custom = findAsset(ReplicatedStorage, "Assets", "Orbs", rarityId)
	local model: Model
	local core: BasePart
	if custom and custom:IsA("Model") and custom.PrimaryPart then
		model = custom:Clone()
		core = model.PrimaryPart :: BasePart
	else
		model = Instance.new("Model")
		local size = rarity.OrbSize
		core = glowPart("Core", Vector3.new(size, size, size), rarity.Color, Enum.PartType.Ball)
		core.Parent = model
		local shell = glowPart("Shell", Vector3.new(size * 1.35, size * 1.35, size * 1.35), biome.Color, Enum.PartType.Ball)
		shell.Material = Enum.Material.ForceField
		shell.Transparency = 0.2
		shell.Parent = model
		model.PrimaryPart = core
	end
	model.Name = "SoulOrb"
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.Massless = true
		end
	end
	addSparkles(core, rarity.Color, 4 + rarity.Order * 3)
	local mutation = mutationId and PetConfig.Mutations[mutationId]
	ModelFactory.Billboard(core, {
		{ Text = (mutation and (mutation.Id .. " ") or "") .. rarity.Id .. " Soul", Color = mutation and mutation.Color or rarity.Color },
		{ Text = biome.Name, Color = biome.Color },
	}, rarity.OrbSize + 1.2, 120)
	model:SetAttribute("Rarity", rarityId)
	model:SetAttribute("Biome", biomeId)
	CollectionService:AddTag(model, "Bob")
	return model
end

-- Spirit Pet ---------------------------------------------------------------------
function ModelFactory.MakePet(species: string, rarityId: string, mutationId: string, incomeText: string): Model
	local rarity = PetConfig.GetRarity(rarityId)
	local mutation = PetConfig.GetMutation(mutationId)

	local custom = findAsset(ReplicatedStorage, "Assets", "Pets", species)
	local model: Model
	local body: BasePart
	if custom and custom:IsA("Model") and custom.PrimaryPart then
		model = custom:Clone()
		body = model.PrimaryPart :: BasePart
	else
		model = Instance.new("Model")
		local size = 1.6 + rarity.Order * 0.25
		local color = if mutationId ~= "None" then mutation.Color else rarity.Color
		body = glowPart("Body", Vector3.new(size, size, size), color, Enum.PartType.Ball)
		body.Material = Enum.Material.SmoothPlastic
		body.Parent = model
		for _, side in ipairs({ -1, 1 }) do
			local eye = glowPart("Eye", Vector3.new(0.3, 0.45, 0.2), Color3.new(1, 1, 1), Enum.PartType.Block)
			eye.CFrame = body.CFrame * CFrame.new(side * size * 0.2, size * 0.1, -size * 0.48)
			eye.Parent = model
		end
		local aura = glowPart("Aura", Vector3.new(size * 1.3, size * 1.3, size * 1.3), rarity.Color, Enum.PartType.Ball)
		aura.Transparency = 0.75
		aura.Parent = model
		model.PrimaryPart = body
	end
	model.Name = "SpiritPet"
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanTouch = false
		end
	end
	addSparkles(body, rarity.Color, 2 + rarity.Order * 2)
	local lines = {
		{ Text = species, Color = Color3.new(1, 1, 1) },
		{ Text = rarity.Id, Color = rarity.Color },
		{ Text = incomeText, Color = Color3.fromRGB(120, 255, 160) },
	}
	if mutationId ~= "None" then
		table.insert(lines, 2, { Text = mutationId, Color = mutation.Color })
	end
	ModelFactory.Billboard(body, lines, 3.2, 70)
	CollectionService:AddTag(model, "Bob")
	return model
end

-- Guardian ---------------------------------------------------------------------
function ModelFactory.MakeGuardian(biomeId: string): Model
	local biome = BiomeConfig.Get(biomeId)
	local g = biome.Guardian
	local custom = findAsset(ServerStorage, "Guardians", biomeId)
	if custom and custom:IsA("Model") and custom:FindFirstChildOfClass("Humanoid") then
		local clone = custom:Clone()
		clone.Name = g.Name
		return clone
	end

	local scale = g.Scale
	local model = Instance.new("Model")
	model.Name = g.Name

	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 2, 1) * scale
	root.Transparency = 1
	root.CanCollide = true
	root.Parent = model

	local torso = Instance.new("Part")
	torso.Name = "Torso"
	torso.Size = Vector3.new(2.6, 3, 1.6) * scale
	torso.Color = g.Color
	torso.Material = Enum.Material.Neon
	torso.CanCollide = false
	torso.Massless = true
	torso.CFrame = root.CFrame * CFrame.new(0, 0.5 * scale, 0)
	torso.Parent = model
	weldTo(root, torso)

	local head = Instance.new("Part")
	head.Name = "Head"
	head.Shape = Enum.PartType.Ball
	head.Size = Vector3.new(2, 2, 2) * scale
	head.Color = g.Color
	head.Material = Enum.Material.Neon
	head.CanCollide = false
	head.Massless = true
	head.CFrame = root.CFrame * CFrame.new(0, 2.6 * scale, 0)
	head.Parent = model
	weldTo(root, head)

	for _, side in ipairs({ -1, 1 }) do
		local eye = Instance.new("Part")
		eye.Name = "Eye"
		eye.Size = Vector3.new(0.4, 0.4, 0.2) * scale
		eye.Color = Color3.fromRGB(255, 30, 30)
		eye.Material = Enum.Material.Neon
		eye.CanCollide = false
		eye.Massless = true
		eye.CFrame = head.CFrame * CFrame.new(side * 0.4 * scale, 0.1 * scale, -0.95 * scale)
		eye.Parent = model
		weldTo(head, eye)
	end

	local humanoid = Instance.new("Humanoid")
	humanoid.RigType = Enum.HumanoidRigType.R15
	humanoid.HipHeight = 2.2 * scale
	humanoid.WalkSpeed = g.Speed
	humanoid.MaxHealth = math.huge
	humanoid.Health = math.huge
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.Parent = model

	model.PrimaryPart = root
	ModelFactory.Billboard(head, { { Text = g.Name, Color = Color3.fromRGB(255, 80, 80) } }, 2.2 * scale, 120)
	return model
end

-- Tools ----------------------------------------------------------------------------
function ModelFactory.MakeWeapon(isScythe: boolean): Tool
	local name = isScythe and "ReaperScythe" or "SoulLantern"
	local custom = findAsset(ServerStorage, "Tools", name)
	if custom and custom:IsA("Tool") then
		return custom:Clone()
	end
	local tool = Instance.new("Tool")
	tool.Name = isScythe and "Reaper Scythe" or "Soul Lantern"
	tool.ToolTip = "Click near a thief to knock their soul loose!"
	tool.CanBeDropped = false
	tool.RequiresHandle = true

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = isScythe and Vector3.new(0.4, 5, 0.4) or Vector3.new(0.4, 2.4, 0.4)
	handle.Color = isScythe and Color3.fromRGB(40, 40, 40) or Color3.fromRGB(90, 60, 40)
	handle.CanCollide = false
	handle.Massless = true
	handle.Parent = tool

	local head = Instance.new("Part")
	head.Name = "Head"
	head.Massless = true
	head.CanCollide = false
	head.Material = Enum.Material.Neon
	if isScythe then
		head.Size = Vector3.new(0.3, 0.6, 3.2)
		head.Color = Color3.fromRGB(200, 40, 60)
		head.CFrame = handle.CFrame * CFrame.new(0, 2.4, -1.4)
	else
		head.Shape = Enum.PartType.Ball
		head.Size = Vector3.new(1.2, 1.2, 1.2)
		head.Color = Color3.fromRGB(120, 220, 255)
		head.CFrame = handle.CFrame * CFrame.new(0, 1.6, 0)
		local light = Instance.new("PointLight")
		light.Color = head.Color
		light.Range = 12
		light.Parent = head
	end
	head.Parent = tool
	weldTo(handle, head)
	tool.Grip = CFrame.new(0, -0.8, 0)
	return tool
end

return ModelFactory
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">WorldBuilder</string>
            <string name="Source"><![CDATA[--[[
	WorldBuilder
	Generates a playable GREYBOX map if Workspace.Bases / Workspace.Biomes don't exist yet, so the
	whole game loop works on an empty Baseplate in minutes. Once you build your real map with the same
	names (see docs/05-build-guide.md) this script does nothing.

	Layout (top-down, +Z is "deeper"):
		z = -170 .. 90     Hub with 8 player bases in a row (bases face +Z)
		z = 130 + 140*k    Biome k (Meadow first ... Abyssal last), 700 studs wide
]]

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local BiomeConfig = require(Shared.Config.BiomeConfig)
local GameConfig = require(Shared.Config.GameConfig)

local WorldBuilder = {}

local BASE_SPACING = 90
local BASE_SIZE = 70
local BASE_Z = -60
local BIOME_START_Z = 130
local BIOME_DEPTH = 140
local BIOME_WIDTH = 700

local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in pairs(props) do
		if key ~= "Parent" then
			(p :: any)[key] = value
		end
	end
	p.Parent = props.Parent
	return p
end

local function invisible(name: string, size: Vector3, cframe: CFrame, parent: Instance): Part
	return part({
		Name = name, Size = size, CFrame = cframe, Transparency = 1,
		CanCollide = false, CanTouch = false, CanQuery = false, Parent = parent,
	})
end

local function label(adornee: BasePart, text: string, color: Color3, size: Vector2, offset: Vector3)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(size.X, size.Y)
	gui.StudsOffset = offset
	gui.MaxDistance = 250
	gui.LightInfluence = 0
	local text_ = Instance.new("TextLabel")
	text_.Name = "Text"
	text_.Size = UDim2.fromScale(1, 1)
	text_.BackgroundTransparency = 1
	text_.Font = Enum.Font.FredokaOne
	text_.TextScaled = true
	text_.TextColor3 = color
	text_.Text = text
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Parent = text_
	text_.Parent = gui
	gui.Parent = adornee
end

local function buildBases()
	local bases = Instance.new("Folder")
	bases.Name = "Bases"
	local count = GameConfig.MaxBases
	local firstX = -((count - 1) * BASE_SPACING) / 2

	for i = 1, count do
		local x = firstX + (i - 1) * BASE_SPACING
		local center = Vector3.new(x, 0, BASE_Z)
		local model = Instance.new("Model")
		model.Name = "Base" .. i

		local floor = part({
			Name = "Plot", Size = Vector3.new(BASE_SIZE, 1, BASE_SIZE), CFrame = CFrame.new(center + Vector3.new(0, 0.5, 0)),
			Color = Color3.fromRGB(60, 55, 80), Material = Enum.Material.Slate, Parent = model,
		})
		model.PrimaryPart = floor

		invisible("Zone", Vector3.new(BASE_SIZE, 40, BASE_SIZE), CFrame.new(center + Vector3.new(0, 20, 0)), model)

		local barrier = part({
			Name = "Barrier", Size = Vector3.new(BASE_SIZE + 2, 30, BASE_SIZE + 2), CFrame = CFrame.new(center + Vector3.new(0, 15, 0)),
			Material = Enum.Material.ForceField, Color = Color3.fromRGB(120, 200, 255), Transparency = 1,
			CanCollide = false, CanTouch = false, CanQuery = false, Parent = model,
		})
		barrier.CastShadow = false

		invisible("Spawn", Vector3.new(4, 1, 4), CFrame.new(center + Vector3.new(0, 4, BASE_SIZE / 2 - 6)), model)

		local pedestals = Instance.new("Folder")
		pedestals.Name = "Pedestals"
		pedestals.Parent = model
		local index = 0
		for row = 0, 4 do
			for col = 0, 4 do
				index += 1
				local pos = center + Vector3.new(-24 + col * 12, 1.6, -26 + row * 11)
				part({
					Name = "Pedestal" .. index, Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.2, 6, 6),
					CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90)),
					Color = Color3.fromRGB(110, 100, 140), Material = Enum.Material.Marble, Parent = pedestals,
				})
			end
		end

		local button = part({
			Name = "LockButton", Size = Vector3.new(3, 1.5, 3), CFrame = CFrame.new(center + Vector3.new(BASE_SIZE / 2 - 5, 1.75, BASE_SIZE / 2 - 5)),
			Color = Color3.fromRGB(80, 200, 255), Material = Enum.Material.Neon, Parent = model,
		})
		label(button, "LOCK BASE", Color3.fromRGB(120, 220, 255), Vector2.new(150, 40), Vector3.new(0, 3, 0))

		local sign = part({
			Name = "Sign", Size = Vector3.new(16, 6, 1), CFrame = CFrame.new(center + Vector3.new(0, 10, BASE_SIZE / 2)),
			Color = Color3.fromRGB(40, 30, 60), Material = Enum.Material.Neon, Transparency = 0.3, Parent = model,
		})
		label(sign, "Empty Base", Color3.new(1, 1, 1), Vector2.new(300, 70), Vector3.new(0, 0, 0))

		model.Parent = bases
	end
	bases.Parent = Workspace
end

local function buildBiomes()
	local biomes = Instance.new("Folder")
	biomes.Name = "Biomes"
	local rng = Random.new(1337)

	for k, biomeId in ipairs(BiomeConfig.Order) do
		local biome = BiomeConfig.Get(biomeId)
		local z0 = BIOME_START_Z + (k - 1) * BIOME_DEPTH
		local centerZ = z0 + BIOME_DEPTH / 2
		local model = Instance.new("Model")
		model.Name = biomeId

		local ground = part({
			Name = "Ground", Size = Vector3.new(BIOME_WIDTH, 4, BIOME_DEPTH), CFrame = CFrame.new(0, -2, centerZ),
			Color = biome.Color, Material = Enum.Material.Grass, Parent = model,
		})
		model.PrimaryPart = ground

		invisible("Zone", Vector3.new(BIOME_WIDTH, 80, BIOME_DEPTH), CFrame.new(0, 38, centerZ), model)

		local gate = part({
			Name = "Gate", Size = Vector3.new(BIOME_WIDTH, 14, 1), CFrame = CFrame.new(0, 7, z0),
			Color = biome.Color, Material = Enum.Material.ForceField, Transparency = 0.4,
			CanCollide = false, CanTouch = false, CanQuery = false, Parent = model,
		})
		for _, gx in ipairs({ -200, 0, 200 }) do
			local post = invisible("GateLabel", Vector3.new(1, 1, 1), CFrame.new(gx, 10, z0), model)
			label(post, string.format("%s\nRequires %d Speed", biome.Name, biome.SpeedRequired), Color3.new(1, 1, 1), Vector2.new(320, 90), Vector3.new(0, 0, 0))
		end
		gate.CastShadow = false

		local spawns = Instance.new("Folder")
		spawns.Name = "SoulSpawns"
		spawns.Parent = model
		for s = 1, biome.MaxOrbs + 4 do
			local px = rng:NextNumber(-BIOME_WIDTH / 2 + 30, BIOME_WIDTH / 2 - 30)
			local pz = rng:NextNumber(z0 + 35, z0 + BIOME_DEPTH - 10)
			invisible("Spawn" .. s, Vector3.new(2, 1, 2), CFrame.new(px, 3.5, pz), spawns)
		end

		local guardianSpawns = Instance.new("Folder")
		guardianSpawns.Name = "GuardianSpawns"
		guardianSpawns.Parent = model
		for s = 1, biome.Guardian.Count do
			local px = -BIOME_WIDTH / 2 + (s / (biome.Guardian.Count + 1)) * BIOME_WIDTH
			invisible("GuardianSpawn" .. s, Vector3.new(2, 1, 2), CFrame.new(px, 5, centerZ + 10), guardianSpawns)
		end

		-- Cover / obstacles so chases have line-of-sight breaks
		for _ = 1, 18 do
			local h = rng:NextNumber(6, 16)
			part({
				Name = "Rock", Size = Vector3.new(rng:NextNumber(6, 14), h, rng:NextNumber(6, 14)),
				CFrame = CFrame.new(rng:NextNumber(-320, 320), h / 2, rng:NextNumber(z0 + 20, z0 + BIOME_DEPTH - 10)) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0),
				Color = biome.Color:Lerp(Color3.new(0, 0, 0), 0.45), Material = Enum.Material.Rock, Parent = model,
			})
		end

		model.Parent = biomes
	end
	biomes.Parent = Workspace
end

local function buildHub()
	local hub = Instance.new("Folder")
	hub.Name = "Hub"
	local endZ = BIOME_START_Z + #BiomeConfig.Order * BIOME_DEPTH

	part({ Name = "HubGround", Size = Vector3.new(820, 4, 260), CFrame = CFrame.new(0, -2, -40), Color = Color3.fromRGB(45, 40, 60), Material = Enum.Material.Slate, Parent = hub })
	part({ Name = "Path", Size = Vector3.new(BIOME_WIDTH, 4, BIOME_START_Z - 90), CFrame = CFrame.new(0, -2, (90 + BIOME_START_Z) / 2), Color = Color3.fromRGB(70, 65, 90), Material = Enum.Material.Cobblestone, Parent = hub })

	local walls = {
		{ Vector3.new(4, 60, 260), Vector3.new(-410, 30, -40) },
		{ Vector3.new(4, 60, 260), Vector3.new(410, 30, -40) },
		{ Vector3.new(820, 60, 4), Vector3.new(0, 30, -170) },
		{ Vector3.new(4, 60, endZ - 90), Vector3.new(-BIOME_WIDTH / 2, 30, (90 + endZ) / 2) },
		{ Vector3.new(4, 60, endZ - 90), Vector3.new(BIOME_WIDTH / 2, 30, (90 + endZ) / 2) },
		{ Vector3.new(BIOME_WIDTH, 60, 4), Vector3.new(0, 30, endZ) },
		{ Vector3.new(55, 60, 4), Vector3.new(-382, 30, 90) },
		{ Vector3.new(55, 60, 4), Vector3.new(382, 30, 90) },
	}
	for i, w in ipairs(walls) do
		part({ Name = "Wall" .. i, Size = w[1], CFrame = CFrame.new(w[2]), Transparency = 1, Parent = hub })
	end

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "LobbySpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.CFrame = CFrame.new(0, 0.5, 40)
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = hub

	hub.Parent = Workspace
end

function WorldBuilder.EnsureWorld()
	local built = false
	if not Workspace:FindFirstChild("Hub") and not Workspace:FindFirstChild("Bases") then
		buildHub()
		built = true
	end
	if not Workspace:FindFirstChild("Bases") then
		buildBases()
		built = true
	end
	if not Workspace:FindFirstChild("Biomes") then
		buildBiomes()
		built = true
	end
	if built then
		local baseplate = Workspace:FindFirstChild("Baseplate")
		if baseplate and baseplate:IsA("BasePart") then
			baseplate.CanCollide = false
			baseplate.Transparency = 1
		end
		print("[WorldBuilder] Generated greybox world (replace with your own map when ready).")
	end
end

return WorldBuilder
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="47">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="48">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="49">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="50">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--[[
	Steal a Soul - client
	Builds the whole HUD in code (no manual UI work needed), listens to server state and sends requests.
	The client is display-only: every action is validated by the server.

	Panels: Upgrades | Spirits | Rebirth | Shop | Codes   + Lock Base button, carry bar, toasts, banners.
	Replace the look later by editing THEME or swapping in your own ScreenGui - the data wiring stays the same.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local TweenService = game:GetService("TweenService")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local PolicyService = game:GetService("PolicyService")
local SoundService = game:GetService("SoundService")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))
local Formulas = require(Shared:WaitForChild("Formulas"))
local Format = require(Shared.Util:WaitForChild("Format"))
local EconomyConfig = require(Shared.Config:WaitForChild("EconomyConfig"))
local PetConfig = require(Shared.Config:WaitForChild("PetConfig"))
local BiomeConfig = require(Shared.Config:WaitForChild("BiomeConfig"))
local MonetizationConfig = require(Shared.Config:WaitForChild("MonetizationConfig"))
local RewardConfig = require(Shared.Config:WaitForChild("RewardConfig"))
local EventConfig = require(Shared.Config:WaitForChild("EventConfig"))
local AbilityConfig = require(Shared.Config:WaitForChild("AbilityConfig"))
local UserInputService = game:GetService("UserInputService")

local THEME = {
	Bg = Color3.fromRGB(22, 16, 38),
	Panel = Color3.fromRGB(36, 26, 60),
	Row = Color3.fromRGB(52, 40, 84),
	Accent = Color3.fromRGB(140, 90, 255),
	Good = Color3.fromRGB(70, 200, 120),
	Bad = Color3.fromRGB(220, 70, 90),
	Gold = Color3.fromRGB(255, 200, 60),
	Text = Color3.fromRGB(245, 240, 255),
	SubText = Color3.fromRGB(190, 180, 220),
	Font = Enum.Font.FredokaOne,
}

-- Seasonal re-skin: Halloween turns the UI orange & purple.
local EVENT_ACTIVE = Workspace:GetAttribute("EventActive") == true
if EVENT_ACTIVE then
	THEME.Bg = Color3.fromRGB(26, 12, 30)
	THEME.Panel = Color3.fromRGB(42, 20, 46)
	THEME.Row = Color3.fromRGB(70, 34, 60)
	THEME.Accent = Color3.fromRGB(255, 120, 30)
end

-- Sounds (built-in Roblox sounds; swap the ids for your own audio from the Creator Store)
local SOUNDS = {
	Ping = "rbxasset://sounds/electronicpingshort.wav",
	Click = "rbxasset://sounds/clickfast.wav",
	Hit = "rbxasset://sounds/swordlunge.wav",
}
local soundCache: { [string]: Sound } = {}
local function playSound(name: string, pitch: number?)
	local id = SOUNDS[name]
	if not id then
		return
	end
	local sound = soundCache[name]
	if not sound then
		sound = Instance.new("Sound")
		sound.SoundId = id
		sound.Volume = 0.5
		sound.Parent = SoundService
		soundCache[name] = sound
	end
	sound.PlaybackSpeed = pitch or 1
	SoundService:PlayLocalSound(sound)
end

local snapshot: any = nil
local serverTimeOffset = 0

-- Regions that restrict paid random items: hide products whose hatch outcome is random.
local RANDOM_ITEM_PRODUCTS = { LegendaryOrb = true, MythicOrb = true, StarterPack = true }
local paidRandomRestricted = false
task.spawn(function()
	local ok, policy = pcall(PolicyService.GetPolicyInfoForPlayerAsync, PolicyService, player)
	paidRandomRestricted = not ok or (policy and policy.ArePaidRandomItemsRestricted) == true
end)

-- UI helpers ----------------------------------------------------------------------------------------
local function new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local instance = Instance.new(className)
	for key, value in pairs(props or {}) do
		if key ~= "Parent" then
			(instance :: any)[key] = value
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = instance
	end
	if props and props.Parent then
		instance.Parent = props.Parent
	end
	return instance
end

local function corner(radius: number?)
	return new("UICorner", { CornerRadius = UDim.new(0, radius or 10) })
end

local function stroke(color: Color3?, thickness: number?)
	return new("UIStroke", { Color = color or Color3.new(0, 0, 0), Thickness = thickness or 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

local function label(props: { [string]: any }): TextLabel
	local defaults = {
		BackgroundTransparency = 1,
		Font = THEME.Font,
		TextColor3 = THEME.Text,
		TextScaled = true,
	}
	for k, v in pairs(props) do
		defaults[k] = v
	end
	local l = new("TextLabel", defaults)
	new("UIStroke", { Thickness = 1.5, Parent = l })
	return l
end

local function button(text: string, color: Color3, onClick: () -> ()): TextButton
	local b = new("TextButton", {
		Text = text,
		Font = THEME.Font,
		TextScaled = true,
		TextColor3 = THEME.Text,
		BackgroundColor3 = color,
		AutoButtonColor = true,
	}, { corner(8), stroke(Color3.new(0, 0, 0), 2), new("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6), PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4) }) })
	local busy = false
	b.Activated:Connect(function()
		if busy then
			return
		end
		playSound("Click", 1.2)
		busy = true
		task.spawn(function()
			local ok, err = pcall(onClick)
			if not ok then
				warn(err)
			end
			busy = false
		end)
	end)
	return b
end

-- Root GUI -----------------------------------------------------------------------------------------------
local gui = new("ScreenGui", { Name = "SoulHUD", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = player:WaitForChild("PlayerGui") })

-- Toasts -----------------------------------------------------------------------------------------------------
local toastHolder = new("Frame", {
	Name = "Toasts", BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -12, 0, 110), Size = UDim2.new(0, 340, 0.6, 0), Parent = gui,
}, { new("UIListLayout", { Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Right, SortOrder = Enum.SortOrder.LayoutOrder }) })

local TOAST_COLORS = { info = THEME.Accent, success = THEME.Good, error = THEME.Bad, warning = THEME.Gold }
local toastCount = 0
local function toast(message: string, kind: string?)
	toastCount += 1
	local frame = new("Frame", {
		BackgroundColor3 = TOAST_COLORS[kind or "info"] or THEME.Accent, Size = UDim2.new(1, 0, 0, 44),
		LayoutOrder = toastCount, Parent = toastHolder,
	}, { corner(10), stroke() })
	label({ Text = message, Size = UDim2.new(1, -16, 1, -8), Position = UDim2.fromOffset(8, 4), Parent = frame })
	task.delay(4, function()
		TweenService:Create(frame, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
		task.wait(0.4)
		frame:Destroy()
	end)
	while #toastHolder:GetChildren() > 7 do
		local oldest, oldestOrder = nil, math.huge
		for _, child in ipairs(toastHolder:GetChildren()) do
			if child:IsA("Frame") and child.LayoutOrder < oldestOrder then
				oldest, oldestOrder = child, child.LayoutOrder
			end
		end
		if oldest then
			oldest:Destroy()
		else
			break
		end
	end
end

-- Banner (server-wide announcements) ------------------------------------------------------------------------
local banner = label({
	Name = "Banner", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 192),
	Size = UDim2.new(0.6, 0, 0, 40), Text = "", TextTransparency = 1, Parent = gui,
})
local bannerToken = 0
local function announce(message: string, color: Color3?)
	bannerToken += 1
	local token = bannerToken
	banner.Text = message
	banner.TextColor3 = color or THEME.Gold
	banner.TextTransparency = 0
	task.delay(5, function()
		if token == bannerToken then
			TweenService:Create(banner, TweenInfo.new(0.6), { TextTransparency = 1 }):Play()
		end
	end)
end

-- Top bar ------------------------------------------------------------------------------------------------------
local topBar = new("Frame", {
	Name = "TopBar", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 8),
	Size = UDim2.fromOffset(460, 122), BackgroundColor3 = THEME.Bg, BackgroundTransparency = 0.15, Parent = gui,
}, { corner(14), stroke(THEME.Accent, 2) })
local essenceLabel = label({ Text = "0", TextColor3 = Color3.fromRGB(150, 255, 230), Size = UDim2.new(1, -20, 0, 40), Position = UDim2.fromOffset(10, 4), Parent = topBar })
local incomeLabel = label({ Text = "+0/s", TextColor3 = THEME.Good, Size = UDim2.new(1, -20, 0, 24), Position = UDim2.fromOffset(10, 44), Parent = topBar })
local statsLabel = label({ Text = "", TextColor3 = THEME.SubText, Size = UDim2.new(1, -20, 0, 22), Position = UDim2.fromOffset(10, 70), Parent = topBar })
local goalLabel = label({ Text = "", TextColor3 = THEME.Gold, Size = UDim2.new(1, -20, 0, 22), Position = UDim2.fromOffset(10, 95), Parent = topBar })

local phaseLabel = label({
	AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 134), Size = UDim2.fromOffset(300, 0),
	Text = "", Parent = gui,
})
local eventLabel = label({
	AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 162), Size = UDim2.fromOffset(420, EVENT_ACTIVE and 24 or 0),
	Text = "", TextColor3 = Color3.fromRGB(255, 150, 50), Parent = gui,
})

-- Carry bar -------------------------------------------------------------------------------------------------------
local carryBar = new("Frame", {
	Name = "CarryBar", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -90),
	Size = UDim2.fromOffset(460, 56), BackgroundColor3 = THEME.Bg, BackgroundTransparency = 0.1, Visible = false, Parent = gui,
}, { corner(12), stroke(THEME.Gold, 2) })
local carryLabel = label({ Text = "", Size = UDim2.new(0.72, -10, 1, -10), Position = UDim2.fromOffset(8, 5), Parent = carryBar })
local dropButton = button("Drop", THEME.Bad, function()
	Remotes.Event("DropOrb"):FireServer()
end)
dropButton.Size = UDim2.new(0.25, 0, 1, -12)
dropButton.Position = UDim2.new(0.74, 0, 0, 6)
dropButton.Parent = carryBar

-- Panels ---------------------------------------------------------------------------------------------------------
local panels: { [string]: Frame } = {}
local openPanelName: string? = nil

local function makePanel(name: string, title: string)
	local frame = new("Frame", {
		Name = name .. "Panel", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.55),
		Size = UDim2.new(0, 560, 0.62, 0), BackgroundColor3 = THEME.Panel, Visible = false, Parent = gui,
	}, { corner(16), stroke(THEME.Accent, 3), new("UISizeConstraint", { MinSize = Vector2.new(300, 250), MaxSize = Vector2.new(560, 620) }) })
	label({ Text = title, Size = UDim2.new(1, -70, 0, 40), Position = UDim2.fromOffset(16, 8), TextXAlignment = Enum.TextXAlignment.Left, Parent = frame })
	local close = button("X", THEME.Bad, function()
		frame.Visible = false
		openPanelName = nil
	end)
	close.Size = UDim2.fromOffset(40, 40)
	close.Position = UDim2.new(1, -52, 0, 8)
	close.Parent = frame
	local list = new("ScrollingFrame", {
		Name = "List", BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 56), Size = UDim2.new(1, -24, 1, -68),
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 6, BorderSizePixel = 0, Parent = frame,
	}, { new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }) })
	panels[name] = frame
	return frame, list
end

local function togglePanel(name: string)
	for key, panel in pairs(panels) do
		panel.Visible = key == name and openPanelName ~= name
	end
	openPanelName = if openPanelName == name then nil else name
end

local function clearList(list: Instance)
	for _, child in ipairs(list:GetChildren()) do
		if not child:IsA("UIListLayout") then
			child:Destroy()
		end
	end
end

-- A row: title + subtitle on the left, up to 3 buttons on the right. Returns row, titleLabel, subLabel, buttons
local function makeRow(list: Instance, order: number, title: string, subtitle: string, buttons: { { Text: string, Color: Color3, OnClick: () -> () } }?)
	local row = new("Frame", { BackgroundColor3 = THEME.Row, Size = UDim2.new(1, -8, 0, 62), LayoutOrder = order, Parent = list }, { corner(10) })
	local buttonCount = buttons and #buttons or 0
	local textWidth = 1 - 0.2 * buttonCount
	local titleLabel = label({ Text = title, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(textWidth, -14, 0, 30), Position = UDim2.fromOffset(10, 4), Parent = row })
	local subLabel = label({ Text = subtitle, TextColor3 = THEME.SubText, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(textWidth, -14, 0, 22), Position = UDim2.fromOffset(10, 35), Parent = row })
	local created = {}
	for i, spec in ipairs(buttons or {}) do
		local b = button(spec.Text, spec.Color, spec.OnClick)
		b.Size = UDim2.new(0.19, -4, 0, 46)
		b.Position = UDim2.new(textWidth + 0.2 * (i - 1), 0, 0, 8)
		b.Parent = row
		table.insert(created, b)
	end
	return row, titleLabel, subLabel, created
end

local function sectionHeader(list: Instance, order: number, text: string)
	label({ Text = text, TextColor3 = THEME.Gold, Size = UDim2.new(1, -8, 0, 28), TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = order, Parent = list })
end

local function request(remoteName: string, ...: any)
	local ok, result = pcall(function(...)
		return Remotes.Function(remoteName):InvokeServer(...)
	end, ...)
	if not ok or type(result) ~= "table" then
		toast("Something went wrong, try again.", "error")
		return nil
	end
	if result.msg and result.msg ~= "" then
		toast(result.msg, result.ok and "success" or "error")
	end
	return result
end

local function promptProduct(key: string)
	local info = MonetizationConfig.Products[key]
	if not info or info.Id == 0 then
		toast("Coming soon!", "info")
		return
	end
	MarketplaceService:PromptProductPurchase(player, info.Id)
end

local function promptPass(key: string)
	local info = MonetizationConfig.GamePasses[key]
	if not info or info.Id == 0 then
		toast("Coming soon!", "info")
		return
	end
	MarketplaceService:PromptGamePassPurchase(player, info.Id)
end

-- Upgrades panel ---------------------------------------------------------------------------------------------------
local _, upgradesList = makePanel("Upgrades", "Upgrades")
local upgradeRows = {}
do
	local _, t1, s1, b1 = makeRow(upgradesList, 1, "Speed", "", {
		{ Text = "+1", Color = THEME.Good, OnClick = function() request("RequestUpgrade", "Speed", 1) end },
		{ Text = "+10", Color = THEME.Good, OnClick = function() request("RequestUpgrade", "Speed", 10) end },
		{ Text = "MAX", Color = THEME.Gold, OnClick = function() request("RequestUpgrade", "Speed", "Max") end },
	})
	upgradeRows.Speed = { Title = t1, Sub = s1, Buttons = b1 }
	local _, t2, s2, b2 = makeRow(upgradesList, 2, "Treadmill", "", {
		{ Text = "Upgrade", Color = THEME.Accent, OnClick = function() request("RequestUpgrade", "Treadmill") end },
	})
	upgradeRows.Treadmill = { Title = t2, Sub = s2, Buttons = b2 }
	local _, t3, s3, b3 = makeRow(upgradesList, 3, "Soul Harness", "", {
		{ Text = "Upgrade", Color = THEME.Accent, OnClick = function() request("RequestUpgrade", "Carry") end },
	})
	upgradeRows.Carry = { Title = t3, Sub = s3, Buttons = b3 }
	local _, t4, s4, b4 = makeRow(upgradesList, 4, "Pedestals", "", {
		{ Text = "Buy", Color = THEME.Accent, OnClick = function() request("RequestUpgrade", "Pedestal") end },
	})
	upgradeRows.Pedestal = { Title = t4, Sub = s4, Buttons = b4 }

	-- Robux upgrades (skip the grind)
	sectionHeader(upgradesList, 5, "Instant Upgrades (Robux)")
	local robuxKeys = {}
	for key, info in pairs(MonetizationConfig.Products) do
		if info.Upgrade then
			table.insert(robuxKeys, key)
		end
	end
	table.sort(robuxKeys, function(a, b)
		return MonetizationConfig.Products[a].Order < MonetizationConfig.Products[b].Order
	end)
	for i, key in ipairs(robuxKeys) do
		local info = MonetizationConfig.Products[key]
		local productKey = key
		local _, t, s, b = makeRow(upgradesList, 5 + i, info.Name, info.Desc, {
			{ Text = "R$ " .. info.Price, Color = THEME.Gold, OnClick = function() promptProduct(productKey) end },
		})
		upgradeRows["Robux" .. key] = { Title = t, Sub = s, Buttons = b }
	end

	sectionHeader(upgradesList, 20, "Biomes")
	for i, id in ipairs(BiomeConfig.Order) do
		local biome = BiomeConfig.Get(id)
		local _, t, s = makeRow(upgradesList, 20 + i, biome.Name, "", nil)
		upgradeRows["Biome" .. id] = { Title = t, Sub = s, Biome = biome }
	end
end

local function attr(name: string, default: any): any
	local value = player:GetAttribute(name)
	if value == nil then
		return default
	end
	return value
end

local function refreshUpgrades()
	local essence = attr("Essence", 0)
	local speed = attr("Speed", 16)
	local tier = attr("TreadmillTier", 1)
	local carry = attr("CarryLevel", 0)
	local pedestals = attr("Pedestals", 3)
	local cap = Formulas.TreadmillCap(tier)

	local speedCost = Formulas.SpeedCost(speed)
	upgradeRows.Speed.Title.Text = string.format("Speed %d / %d", speed, cap)
	upgradeRows.Speed.Sub.Text = speed >= cap and "Capped - upgrade Treadmill" or ("Next: " .. Format.Number(speedCost))
	for _, b in ipairs(upgradeRows.Speed.Buttons) do
		b.BackgroundTransparency = (speed < cap and essence >= speedCost) and 0 or 0.5
	end

	local nextTier = EconomyConfig.Treadmill[tier + 1]
	upgradeRows.Treadmill.Title.Text = string.format("Treadmill Tier %d (cap %d)", tier, cap)
	if nextTier then
		local needs = nextTier.RequiresRebirths and attr("Rebirths", 0) < nextTier.RequiresRebirths
		upgradeRows.Treadmill.Sub.Text = needs and ("Needs " .. nextTier.RequiresRebirths .. " rebirth(s)")
			or string.format("Cap %d for %s", nextTier.Cap, Format.Number(nextTier.Cost))
		upgradeRows.Treadmill.Buttons[1].BackgroundTransparency = (not needs and essence >= nextTier.Cost) and 0 or 0.5
	else
		upgradeRows.Treadmill.Sub.Text = "MAXED"
	end

	upgradeRows.Carry.Title.Text = string.format("Soul Harness %d / %d", carry, EconomyConfig.CarryMaxLevel)
	if carry < EconomyConfig.CarryMaxLevel then
		local cost = Formulas.CarryCost(carry)
		upgradeRows.Carry.Sub.Text = string.format("-%s slowdown | Next: %s", Format.Percent(Formulas.CarryReduction(carry)), Format.Number(cost))
		upgradeRows.Carry.Buttons[1].BackgroundTransparency = essence >= cost and 0 or 0.5
	else
		upgradeRows.Carry.Sub.Text = "MAXED (-60% slowdown)"
	end

	upgradeRows.Pedestal.Title.Text = string.format("Pedestals %d / %d", pedestals, EconomyConfig.MaxPedestals)
	if pedestals < EconomyConfig.MaxPedestals then
		local cost = Formulas.PedestalCost(pedestals)
		upgradeRows.Pedestal.Sub.Text = "Next: " .. Format.Number(cost)
		upgradeRows.Pedestal.Buttons[1].BackgroundTransparency = essence >= cost and 0 or 0.5
	else
		upgradeRows.Pedestal.Sub.Text = "MAXED (+5 with pass)"
	end

	-- Robux rows: show what "Unlock Next Biome" gives, grey out maxed items
	local nextBiomeRow = upgradeRows.RobuxNextBiome
	if nextBiomeRow then
		local nextBiome = nil
		for _, id in ipairs(BiomeConfig.Order) do
			if speed < BiomeConfig.Get(id).SpeedRequired then
				nextBiome = BiomeConfig.Get(id)
				break
			end
		end
		nextBiomeRow.Sub.Text = nextBiome and string.format("Jump to %s (%d Speed)", nextBiome.Name, nextBiome.SpeedRequired) or "Every biome unlocked!"
		nextBiomeRow.Buttons[1].BackgroundTransparency = nextBiome and 0 or 0.6
	end
	if upgradeRows.RobuxHarnessMax then
		upgradeRows.RobuxHarnessMax.Buttons[1].BackgroundTransparency = carry < EconomyConfig.CarryMaxLevel and 0 or 0.6
	end
	if upgradeRows.RobuxPedestalPlus1 then
		upgradeRows.RobuxPedestalPlus1.Buttons[1].BackgroundTransparency = pedestals < EconomyConfig.MaxPedestals and 0 or 0.6
	end

	for _, id in ipairs(BiomeConfig.Order) do
		local row = upgradeRows["Biome" .. id]
		local unlocked = speed >= row.Biome.SpeedRequired
		row.Sub.Text = string.format("%s | Needs %d Speed | x%s income", unlocked and "UNLOCKED" or "LOCKED", row.Biome.SpeedRequired, Format.Number(row.Biome.IncomeMult))
		row.Sub.TextColor3 = unlocked and THEME.Good or THEME.SubText
	end
end

-- Spirits panel -----------------------------------------------------------------------------------------------------------
local _, spiritsList = makePanel("Spirits", "Spirits")

local function petIncome(pet): number
	return Formulas.PetIncome(pet.Rarity, pet.Biome, pet.Mutation)
end

local function petTitle(pet): string
	local mutation = pet.Mutation ~= "None" and (pet.Mutation .. " ") or ""
	return mutation .. pet.Species
end

local orbCountdownLabels: { { Label: TextLabel, HatchEnd: number, Prefix: string } } = {}

-- "Follow" button: makes this spirit your Companion (its biome gives your ability)
local function followButton(petId: string)
	local isCompanion = snapshot and snapshot.CompanionId == petId
	return {
		Text = isCompanion and "Following" or "Follow",
		Color = isCompanion and THEME.Gold or Color3.fromRGB(90, 160, 255),
		OnClick = function()
			request("SetCompanion", if isCompanion then nil else petId)
		end,
	}
end

local function refreshSpirits()
	clearList(spiritsList)
	table.clear(orbCountdownLabels)
	if not snapshot then
		return
	end
	-- Companion summary at the top
	local companion = snapshot.CompanionId ~= "" and snapshot.Pets[snapshot.CompanionId]
	if companion then
		local ability = AbilityConfig.ByBiome[companion.Biome] or AbilityConfig.ByBiome.Meadow
		makeRow(spiritsList, -1, "Companion: " .. petTitle(companion), string.format("Ability (Q): %s - %s", ability.Name, ability.Desc), {
			{ Text = "Dismiss", Color = THEME.Bad, OnClick = function() request("SetCompanion", nil) end },
		})
	else
		makeRow(spiritsList, -1, "No Companion yet", "Press Follow on a spirit: it follows you and gives a power (Q)", nil)
	end
	local order = 0
	local function nextOrder()
		order += 1
		return order
	end

	local hasOrb = false
	for _, slot in pairs(snapshot.Slots) do
		if slot.Type == "Orb" then
			hasOrb = true
		end
	end
	if hasOrb then
		makeRow(spiritsList, nextOrder(), "Impatient?", "Hatch souls instantly", {
			{ Text = "Slowest R$" .. MonetizationConfig.Products.InstantHatchOne.Price, Color = THEME.Gold, OnClick = function() promptProduct("InstantHatchOne") end },
			{ Text = "All R$" .. MonetizationConfig.Products.InstantHatchAll.Price, Color = THEME.Gold, OnClick = function() promptProduct("InstantHatchAll") end },
		})
	end

	sectionHeader(spiritsList, nextOrder(), string.format("Pedestals (%d active)", snapshot.ActivePedestals))
	local placed = {}
	for i = 1, snapshot.ActivePedestals do
		local slot = snapshot.Slots[tostring(i)]
		if not slot then
			makeRow(spiritsList, nextOrder(), "#" .. i .. " Empty", "Steal a soul and bring it home!", nil)
		elseif slot.Type == "Orb" then
			local rarity = PetConfig.GetRarity(slot.Rarity)
			local _, title, sub = makeRow(spiritsList, nextOrder(), string.format("#%d %s Soul", i, slot.Rarity), "", nil)
			title.TextColor3 = rarity.Color
			table.insert(orbCountdownLabels, { Label = sub, HatchEnd = slot.HatchEnd, Prefix = BiomeConfig.Get(slot.Biome).Name .. " | Hatching in " })
		elseif slot.Type == "Pet" then
			local pet = snapshot.Pets[slot.PetId]
			if pet then
				placed[slot.PetId] = true
				local index = i
				local _, title = makeRow(spiritsList, nextOrder(), "#" .. i .. " " .. petTitle(pet), string.format("%s | +%s/s", pet.Rarity, Format.Number(petIncome(pet))), {
					{ Text = "Store", Color = THEME.Accent, OnClick = function() request("PetAction", "Store", index) end },
					followButton(slot.PetId),
				})
				title.TextColor3 = PetConfig.GetRarity(pet.Rarity).Color
			end
		end
	end

	local inventory = {}
	for id, pet in pairs(snapshot.Pets) do
		if not placed[id] then
			table.insert(inventory, pet)
		end
	end
	table.sort(inventory, function(a, b)
		return petIncome(a) > petIncome(b)
	end)
	local lockedCount = 0
	for _, pet in pairs(snapshot.Pets) do
		if pet.Locked then
			lockedCount += 1
		end
	end
	sectionHeader(spiritsList, nextOrder(), string.format("Inventory (%d) | Vault %d/%d | Pending souls: %d", #inventory, lockedCount, snapshot.VaultSize, snapshot.PendingOrbs))
	for _, pet in ipairs(inventory) do
		local id = pet.Id
		local _, title = makeRow(spiritsList, nextOrder(), petTitle(pet) .. (pet.Locked and " [VAULT]" or ""), string.format("%s | +%s/s", pet.Rarity, Format.Number(petIncome(pet))), {
			{ Text = "Place", Color = THEME.Good, OnClick = function() request("PetAction", "Place", id) end },
			followButton(id),
			{ Text = "Sell", Color = THEME.Bad, OnClick = function() request("PetAction", "Sell", id) end },
		})
		title.TextColor3 = PetConfig.GetRarity(pet.Rarity).Color
	end
	-- Soul Fusion: 3 same-rarity inventory spirits -> 1 soul of the next rarity
	sectionHeader(spiritsList, nextOrder(), "Soul Fusion: 3 spirits -> 1 of the next rarity")
	local fusable: { [string]: number } = {}
	for _, pet in ipairs(inventory) do
		if not pet.Locked and pet.Id ~= snapshot.CompanionId then
			fusable[pet.Rarity] = (fusable[pet.Rarity] or 0) + 1
		end
	end
	for i = 1, #PetConfig.RarityOrder - 1 do
		local rarityId = PetConfig.RarityOrder[i]
		local count = fusable[rarityId] or 0
		local nextRarity = PetConfig.RarityOrder[i + 1]
		local _, title = makeRow(spiritsList, nextOrder(), string.format("3 %s -> 1 %s", rarityId, nextRarity), string.format("You have %d in inventory (store spirits to fuse them)", count), {
			{ Text = "FUSE", Color = count >= 3 and THEME.Gold or THEME.Row, OnClick = function()
				local result = request("PetAction", "FuseRarity", rarityId)
				if result and result.ok then
					playSound("Ping", 0.7)
				end
			end },
		})
		title.TextColor3 = PetConfig.GetRarity(nextRarity).Color
	end

	-- Vault (kept through rebirth) for every spirit
	sectionHeader(spiritsList, nextOrder(), "Vault: spirits kept through rebirth")
	for id, pet in pairs(snapshot.Pets) do
		makeRow(spiritsList, nextOrder(), petTitle(pet), pet.Locked and "In vault" or "Not vaulted", {
			{ Text = pet.Locked and "Unvault" or "Vault", Color = THEME.Accent, OnClick = function() request("PetAction", "Lock", id, not pet.Locked) end },
		})
	end
end

-- Rebirth panel -------------------------------------------------------------------------------------------------------------
local _, rebirthList = makePanel("Rebirth", "Rebirth")

local function refreshRebirth()
	clearList(rebirthList)
	if not snapshot then
		return
	end
	local rebirths = snapshot.Rebirths
	local cost = Formulas.RebirthCost(rebirths)
	local essence = attr("Essence", 0)
	makeRow(rebirthList, 1, string.format("Rebirth %d -> %d", rebirths, rebirths + 1), string.format("x%.1f -> x%.1f Essence forever | +%d tokens", Formulas.RebirthMultiplier(rebirths), Formulas.RebirthMultiplier(rebirths + 1), Formulas.RebirthTokens(rebirths + 1)), nil)
	makeRow(rebirthList, 2, string.format("Cost: %s (%s)", Format.Number(cost), Format.Percent(math.min(1, essence / cost))), "Resets Essence, Speed, Harness, Treadmill & unvaulted spirits", {
		{ Text = "REBIRTH", Color = essence >= cost and THEME.Good or THEME.Row, OnClick = function() request("RequestRebirth") end },
		{ Text = "Skip R$" .. MonetizationConfig.Products.RebirthSkip.Price, Color = THEME.Gold, OnClick = function() promptProduct("RebirthSkip") end },
	})
	sectionHeader(rebirthList, 3, string.format("Perks | Rebirth Tokens: %d", snapshot.RebirthTokens))
	for i, perkId in ipairs(EconomyConfig.PerkOrder) do
		local perk = EconomyConfig.Perks[perkId]
		local level = snapshot.Perks[perkId] or 0
		local perkCost = Formulas.PerkCost(perkId, level)
		local id = perkId
		makeRow(rebirthList, 3 + i, string.format("%s %d/%d", perk.Name, level, perk.MaxLevel), perk.Desc, {
			{ Text = perkCost and (perkCost .. " tok") or "MAX", Color = (perkCost and snapshot.RebirthTokens >= perkCost) and THEME.Good or THEME.Row, OnClick = function() request("BuyPerk", id) end },
		})
	end
end

-- Shop panel ----------------------------------------------------------------------------------------------------------------
local _, shopList = makePanel("Shop", "Shop")

local function sortedKeys(map: { [string]: any }): { string }
	local keys = {}
	for key in pairs(map) do
		table.insert(keys, key)
	end
	table.sort(keys, function(a, b)
		return map[a].Order < map[b].Order
	end)
	return keys
end

local function refreshShop()
	clearList(shopList)
	local order = 0
	sectionHeader(shopList, 0, "Boosts & Items")
	for _, key in ipairs(sortedKeys(MonetizationConfig.Products)) do
		local info = MonetizationConfig.Products[key]
		local show = not info.Hidden and not (paidRandomRestricted and RANDOM_ITEM_PRODUCTS[key])
		if key == "StarterPack" and snapshot and snapshot.StarterPackBought then
			show = false
		end
		if key == "StealBack" and snapshot and snapshot.CanStealBack then
			show = true
		end
		if info.Event and not (snapshot and snapshot.EventActive) then
			show = false
		end
		if info.Upgrade then
			show = false -- listed in the Upgrades panel instead
		end
		if show then
			order += 1
			local productKey = key
			makeRow(shopList, order, info.Name, info.Desc, {
				{ Text = "R$ " .. info.Price, Color = THEME.Gold, OnClick = function() promptProduct(productKey) end },
			})
		end
	end
	order += 1
	sectionHeader(shopList, order, "Game Passes (permanent)")
	for _, key in ipairs(sortedKeys(MonetizationConfig.GamePasses)) do
		local info = MonetizationConfig.GamePasses[key]
		local ownedPass = snapshot and snapshot.Passes and snapshot.Passes[key]
		order += 1
		local passKey = key
		makeRow(shopList, order, info.Name, info.Desc, {
			{ Text = ownedPass and "OWNED" or ("R$ " .. info.Price), Color = ownedPass and THEME.Row or THEME.Accent, OnClick = function()
				if not ownedPass then
					promptPass(passKey)
				end
			end },
		})
	end
end

-- Codes panel -------------------------------------------------------------------------------------------------------------------
local _, codesList = makePanel("Codes", "Codes")
do
	local box = new("TextBox", {
		PlaceholderText = "Enter code...", Text = "", Font = THEME.Font, TextScaled = true, ClearTextOnFocus = false,
		TextColor3 = Color3.new(0, 0, 0), BackgroundColor3 = Color3.new(1, 1, 1), Size = UDim2.new(1, -8, 0, 50), LayoutOrder = 1, Parent = codesList,
	}, { corner(8) })
	local redeem = button("Redeem", THEME.Good, function()
		local result = request("RedeemCode", box.Text)
		if result and result.ok then
			box.Text = ""
		end
	end)
	redeem.Size = UDim2.new(1, -8, 0, 50)
	redeem.LayoutOrder = 2
	redeem.Parent = codesList
	label({ Text = "Follow the group & like the game for new codes!", TextColor3 = THEME.SubText, Size = UDim2.new(1, -8, 0, 30), LayoutOrder = 3, Parent = codesList })
end

-- Gifts panel (daily streak, playtime gifts, daily quests) ----------------------------------------------------------------------
local _, giftsList = makePanel("Gifts", "Daily Gifts & Quests")
local snapshotReceivedAt = os.clock()

local function sessionSeconds(): number
	local rewards = snapshot and snapshot.Rewards
	if not rewards then
		return 0
	end
	return rewards.SessionSeconds + (os.clock() - snapshotReceivedAt)
end

local function refreshGifts()
	clearList(giftsList)
	local rewards = snapshot and snapshot.Rewards
	if not rewards then
		return
	end
	local order = 0
	local function nextOrder()
		order += 1
		return order
	end

	sectionHeader(giftsList, nextOrder(), string.format("Login Streak: %d day(s) | come back every day!", rewards.DailyStreak))
	for day, entry in ipairs(RewardConfig.Daily) do
		local isToday = day == rewards.DailyDay
		local done = (not rewards.DailyCanClaim and day <= rewards.DailyDay) or (rewards.DailyCanClaim and day < rewards.DailyDay)
		local buttons = nil
		if isToday and rewards.DailyCanClaim then
			buttons = { { Text = "CLAIM", Color = THEME.Good, OnClick = function()
				local result = request("ClaimDaily")
				if result and result.ok then
					playSound("Ping", 1.3)
				end
			end } }
		end
		local status = if done then "Claimed" elseif isToday then (rewards.DailyCanClaim and "Ready!" or "Claimed") else "Locked"
		local _, title = makeRow(giftsList, nextOrder(), string.format("Day %d: %s", day, entry.Label), status, buttons)
		title.TextColor3 = isToday and THEME.Gold or (done and THEME.SubText or THEME.Text)
	end

	sectionHeader(giftsList, nextOrder(), "Playtime Gifts (this session)")
	local claimedSet = {}
	for _, index in ipairs(rewards.PlaytimeClaimed) do
		claimedSet[index] = true
	end
	for index, gift in ipairs(RewardConfig.Playtime) do
		local remaining = gift.Minutes * 60 - sessionSeconds()
		local claimed = claimedSet[index]
		local buttons = nil
		if not claimed and remaining <= 0 then
			buttons = { { Text = "CLAIM", Color = THEME.Good, OnClick = function()
				local result = request("ClaimPlaytime", index)
				if result and result.ok then
					playSound("Ping", 1.2)
				end
			end } }
		end
		local status = if claimed then "Claimed" elseif remaining <= 0 then "Ready!" else ("in " .. Format.Time(remaining))
		makeRow(giftsList, nextOrder(), string.format("%d min: %s", gift.Minutes, gift.Label), status, buttons)
	end

	sectionHeader(giftsList, nextOrder(), "Daily Quests | new quests in " .. Format.Time(rewards.NextResetIn))
	local allClaimed = #rewards.Quests > 0
	for index, quest in ipairs(rewards.Quests) do
		allClaimed = allClaimed and quest.Claimed
		local finished = quest.Progress >= quest.Goal
		local buttons = nil
		if finished and not quest.Claimed then
			buttons = { { Text = "CLAIM", Color = THEME.Good, OnClick = function()
				local result = request("ClaimQuest", index)
				if result and result.ok then
					playSound("Ping", 1.1)
				end
			end } }
		end
		local status = quest.Claimed and "Claimed" or string.format("%d / %d", quest.Progress, quest.Goal)
		makeRow(giftsList, nextOrder(), quest.Text, status, buttons)
	end
	local bonusButtons = nil
	if allClaimed and not rewards.QuestBonusClaimed then
		bonusButtons = { { Text = "CLAIM", Color = THEME.Gold, OnClick = function()
			local result = request("ClaimQuest", "Bonus")
			if result and result.ok then
				playSound("Ping", 1.5)
			end
		end } }
	end
	makeRow(giftsList, nextOrder(), "Finish all 3: LEGENDARY Soul", rewards.QuestBonusClaimed and "Claimed" or "Complete every quest today", bonusButtons)
end

-- Count of things waiting to be claimed (drives the "!" badge on the Gifts button)
local function claimableCount(): number
	local rewards = snapshot and snapshot.Rewards
	if not rewards then
		return 0
	end
	local count = rewards.DailyCanClaim and 1 or 0
	local claimedSet = {}
	for _, index in ipairs(rewards.PlaytimeClaimed) do
		claimedSet[index] = true
	end
	for index, gift in ipairs(RewardConfig.Playtime) do
		if not claimedSet[index] and sessionSeconds() >= gift.Minutes * 60 then
			count += 1
		end
	end
	local allClaimed = #rewards.Quests > 0
	for _, quest in ipairs(rewards.Quests) do
		if quest.Progress >= quest.Goal and not quest.Claimed then
			count += 1
		end
		allClaimed = allClaimed and quest.Claimed
	end
	if allClaimed and not rewards.QuestBonusClaimed then
		count += 1
	end
	return count
end

-- Event panel (Halloween Candy Shop) -------------------------------------------------------------------------------------------------
local _, eventList = makePanel("Event", EventConfig.Name)

local function refreshEvent()
	clearList(eventList)
	local endsIn = (Workspace:GetAttribute("EventEndsAt") or 0) - (os.time() + serverTimeOffset)
	sectionHeader(eventList, 1, string.format("Candy: %s | ends in %s", Format.Number(attr("Candy", 0)), Format.Time(math.max(0, endsIn))))
	makeRow(eventList, 2, "How to get Candy", "Collect glowing pumpkins, bring souls home, finish quests", nil)
	for i, item in ipairs(EventConfig.Shop) do
		local itemId = item.Id
		local affordable = attr("Candy", 0) >= item.Cost
		makeRow(eventList, 2 + i, item.Name, item.Desc, {
			{ Text = item.Cost .. " Candy", Color = affordable and THEME.Accent or THEME.Row, OnClick = function()
				local result = request("BuyEventItem", itemId)
				if result and result.ok then
					playSound("Ping", 0.9)
				end
			end },
		})
	end
	local order = 20
	for _, key in ipairs({ "CandySmall", "CandyLarge" }) do
		local info = MonetizationConfig.Products[key]
		order += 1
		local productKey = key
		makeRow(eventList, order, info.Name, info.Desc, {
			{ Text = "R$ " .. info.Price, Color = THEME.Gold, OnClick = function() promptProduct(productKey) end },
		})
	end
end

-- Spirit Index panel -----------------------------------------------------------------------------------------------------------------
local _, indexList = makePanel("Index", "Spirit Index")

local function refreshIndex()
	clearList(indexList)
	local discovered = snapshot and snapshot.Index or {}
	local total, found = 0, 0
	for _, biomeId in ipairs(BiomeConfig.Order) do
		for _, species in pairs(BiomeConfig.Get(biomeId).Species) do
			total += 1
			if discovered[species] then
				found += 1
			end
		end
	end
	sectionHeader(indexList, 0, string.format("%d / %d discovered | +%d%% Essence forever", found, total, math.floor(found * RewardConfig.IndexBonusPerSpecies * 100 + 0.5)))
	for i, biomeId in ipairs(BiomeConfig.Order) do
		local biome = BiomeConfig.Get(biomeId)
		local count = 0
		for _, species in pairs(biome.Species) do
			if discovered[species] then
				count += 1
			end
		end
		sectionHeader(indexList, i * 2 - 1, string.format("%s  %d/7", biome.Name, count))
		local grid = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -8, 0, 96), LayoutOrder = i * 2, Parent = indexList }, {
			new("UIGridLayout", { CellSize = UDim2.new(0.25, -6, 0, 44), CellPadding = UDim2.fromOffset(6, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
		})
		for order, rarityId in ipairs(PetConfig.RarityOrder) do
			local species = biome.Species[rarityId]
			local known = discovered[species] == true
			local cell = new("Frame", { BackgroundColor3 = known and THEME.Row or THEME.Bg, LayoutOrder = order, Parent = grid }, { corner(8) })
			label({
				Text = known and species or "???", TextColor3 = known and PetConfig.GetRarity(rarityId).Color or THEME.SubText,
				Size = UDim2.new(1, -6, 1, -4), Position = UDim2.fromOffset(3, 2), Parent = cell,
			})
		end
	end
end

